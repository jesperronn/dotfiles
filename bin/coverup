#!/usr/bin/env node
//
// Purpose:
//   Find JaCoCo XML coverage reports in a project tree and print a coverage
//   table (instruction/branch) sorted by worst coverage first.
//
// Usage:
//   bin/coverup [OPTIONS] [-- <path-filter>]
//
// Options:
//   --sort percentage    Sort by coverage % ascending (worst first).
//   --sort lines         Sort by missed instruction count descending.
//   --sort branches      Sort by missed branch count descending.
//   --sort total         Sort by missed lines + branches descending [default].
//   --root <dir>         Root directory to search (default: cwd).
//   --verbose, -v        Show all files including 100% covered; show debug info.
//   --help, -h           Show this help and exit.
//
// Arguments:
//   -- <path-filter>     Only show source files whose path contains <path-filter>.
//
// Output:
//   Prints a table: FILE  COV%  LINES  BRANCHES, plus a summary line.
//   With --verbose: also lists fully-covered files and all jacoco.xml found.
//
// Notes:
//   Skips node_modules/ and .git/ directories during scan.

import { readFileSync, readdirSync } from 'node:fs';
import { join } from 'node:path';

const rawArgs = process.argv.slice(2);
const dashDashIdx = rawArgs.indexOf('--');
const pathFilter = dashDashIdx >= 0 ? rawArgs.slice(dashDashIdx + 1).join(' ') : null;
const mainArgs = dashDashIdx >= 0 ? rawArgs.slice(0, dashDashIdx) : rawArgs;

let root = process.cwd();
let sortBy = 'total';
let help = false;
let verbose = false;

for (let i = 0; i < mainArgs.length; i++) {
  const a = mainArgs[i];
  if (a === '--help' || a === '-h') {
    help = true;
  } else if (a === '--root') {
    root = mainArgs[++i] ?? root;
  } else if (a === '--sort') {
    sortBy = mainArgs[++i] ?? sortBy;
  } else if (a === '--verbose' || a === '-v') {
    verbose = true;
  } else {
    console.error(`Unknown option: ${a}`);
    process.exit(1);
  }
}

if (help) {
  process.stdout.write(`\
Usage: coverup [options] [-- <path-filter>]

Options:
  --sort percentage  Sort by coverage % ascending (worst first)
  --sort lines       Sort by missed instruction count descending
  --sort branches    Sort by missed branch count descending
  --sort total       Sort by missed lines + branches descending [default]
  --root <dir>       Root directory to search (default: cwd)
  --verbose          Show all files including 100% covered; show debug info
  --help             Show help

Arguments:
  -- <path-filter>   Only show source files whose path contains <path-filter>
`);
  process.exit(0);
}

const SORT_KEYS = ['percentage', 'lines', 'branches', 'total'];
if (!SORT_KEYS.includes(sortBy)) {
  console.error(`Unknown sort key: ${sortBy}. Use: ${SORT_KEYS.join(', ')}`);
  process.exit(1);
}

function walk(dir, results = []) {
  let entries;
  try {
    entries = readdirSync(dir, { withFileTypes: true });
  } catch {
    return results;
  }
  for (const entry of entries) {
    if (entry.name === 'node_modules' || entry.name === '.git') continue;
    const full = join(dir, entry.name);
    if (entry.isDirectory()) {
      if (!full.includes('/test/') && !full.includes('\\test\\')) walk(full, results);
    } else if (entry.name === 'jacoco.xml') {
      results.push(full);
    }
  }
  return results;
}

function attr(tag, name) {
  const m = tag.match(new RegExp(`${name}="([^"]*)"`));
  return m ? m[1] : '';
}

function parseJacocoXml(xmlPath) {
  const content = readFileSync(xmlPath, 'utf8');
  const results = [];
  let pkg = null;
  let sf = null;
  let counters = [];

  for (const m of content.matchAll(/<(\/?)(\w+)([^>]*)>/g)) {
    const [, closing, tag, attrs] = m;
    if (closing) {
      if (tag === 'sourcefile' && sf !== null) {
        const instr = counters.find(c => c.type === 'INSTRUCTION');
        const branch = counters.find(c => c.type === 'BRANCH');
        results.push({
          path: `${pkg}/${sf}`,
          missedLines: instr ? parseInt(instr.missed, 10) : 0,
          coveredLines: instr ? parseInt(instr.covered, 10) : 0,
          missedBranches: branch ? parseInt(branch.missed, 10) : 0,
        });
        sf = null;
        counters = [];
      } else if (tag === 'package') {
        pkg = null;
      }
    } else if (tag === 'package') {
      pkg = attr(attrs, 'name');
    } else if (tag === 'sourcefile') {
      sf = attr(attrs, 'name');
      counters = [];
    } else if (tag === 'counter' && sf !== null) {
      const type = attr(attrs, 'type');
      if (type === 'INSTRUCTION' || type === 'BRANCH') {
        counters.push({ type, missed: attr(attrs, 'missed'), covered: attr(attrs, 'covered') });
      }
    }
  }
  return results;
}

function pct(e) {
  const total = e.coveredLines + e.missedLines;
  return total === 0 ? 100.0 : (100 * e.coveredLines / total);
}

const sortFns = {
  percentage: (a, b) => pct(a) - pct(b) || a.path.localeCompare(b.path),
  lines: (a, b) => b.missedLines - a.missedLines || a.path.localeCompare(b.path),
  branches: (a, b) => b.missedBranches - a.missedBranches || a.path.localeCompare(b.path),
  total: (a, b) => (b.missedLines + b.missedBranches) - (a.missedLines + a.missedBranches) || a.path.localeCompare(b.path),
};

const xmlFiles = walk(root);

if (verbose) {
  process.stdout.write(`Scanning: ${root}\n`);
  if (xmlFiles.length === 0) {
    process.stdout.write('No jacoco.xml files found.\n');
  } else {
    for (const f of xmlFiles) {
      process.stdout.write(`  Found: ${f}\n`);
    }
  }
  process.stdout.write('\n');
}

let entries = [];
for (const xmlFile of xmlFiles) {
  const parsed = parseJacocoXml(xmlFile);
  if (verbose) {
    // source file count already shown via the Found line; no extra line needed
  }
  entries.push(...parsed);
}

if (pathFilter) {
  const filter = pathFilter.toLowerCase();
  entries = entries.filter(e => e.path.toLowerCase().includes(filter));
}

if (entries.length === 0) {
  process.stdout.write('No coverage data found.\n');
  process.exit(0);
}

entries.sort(sortFns[sortBy]);

const fullyCovered = entries.filter(e => e.missedLines === 0 && e.missedBranches === 0);
const withGaps = entries.filter(e => e.missedLines > 0 || e.missedBranches > 0);
const displayed = verbose ? entries : withGaps;

function padR(s, n) { return String(s).padEnd(n); }
function padL(s, n) { return String(s).padStart(n); }

if (displayed.length === 0) {
  process.stdout.write(`All ${fullyCovered.length} file(s) fully covered. Run with --verbose to see them.\n`);
  process.exit(0);
}

const pathWidth = Math.max(4, ...displayed.map(e => e.path.length));

process.stdout.write(
  padR('FILE', pathWidth + 2) +
  padL('COV%', 7) +
  padL('LINES', 7) +
  padL('BRANCHES', 10) +
  '\n'
);

for (const e of displayed) {
  const badge = e.missedLines === 0 && e.missedBranches === 0 ? '  ✅' : '';
  process.stdout.write(
    padR(e.path, pathWidth + 2) +
    padL(pct(e).toFixed(1) + '%', 7) +
    padL(e.missedLines, 7) +
    padL(e.missedBranches, 10) +
    badge + '\n'
  );
}

const totalMissedLines = withGaps.reduce((s, e) => s + e.missedLines, 0);
const totalMissedBranches = withGaps.reduce((s, e) => s + e.missedBranches, 0);

process.stdout.write('\n');
if (verbose) {
  process.stdout.write(`${entries.length} file(s) total — ${totalMissedLines} missed lines, ${totalMissedBranches} missed branches\n`);
  process.stdout.write(`  ${withGaps.length} with gaps, ${fullyCovered.length} fully covered\n`);
} else {
  process.stdout.write(`${withGaps.length} file(s) with gaps — ${totalMissedLines} missed lines, ${totalMissedBranches} missed branches\n`);
  if (fullyCovered.length > 0) {
    process.stdout.write(`${fullyCovered.length} file(s) fully covered (run with --verbose to see all)\n`);
  }
}
