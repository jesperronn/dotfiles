#!/usr/bin/env node
// One-shot setup from the public dotfiles repo:
//   curl -fsSL https://raw.githubusercontent.com/jesperronn/dotfiles/refs/heads/main/bin/copilot-leaderboard | node - --init
// replace --init with --help/--update/ etc.

import { execSync } from 'node:child_process';
import { existsSync, mkdirSync, readFileSync, readdirSync, writeFileSync } from 'node:fs';
import { homedir } from 'node:os';
import { dirname, join } from 'node:path';

const INTERACTION_CREDIT_MULTIPLIER = 1;
const DATE_COLUMN_MIN_WIDTH = 3;
const DEFAULT_CONFIG_PATH = join(homedir(), '.config', 'copilot-leaderboard.toml');

const REQUIRED_ACCOUNT_KEYS = ['label', 'api_path', 'archive_dir'];

function printHelp(state) {
  const available = formatAvailableAccounts(state.accounts);
  const configStatus = state.configExists
    ? state.configPath
    : `${state.configPath} (missing; create with: copilot-leaderboard --init)`;
  process.stdout.write(`\
Usage:
  copilot-leaderboard --only NAME[,NAME...] [options]
  copilot-leaderboard --all [options]
  copilot-leaderboard --init [--config PATH]

Options:
  --only NAMES        Account names from the config, comma-separated
  --all               Run every configured account
  --month YYYY-MM     Report month (default: current month)
  --update            Fetch today's 28-day snapshot before reporting
  --backfill          Fetch each day in --month before reporting
  --report-only       Use cached archive data only (default)
  --init              Write an example config
  --config PATH       Config path (default: ${DEFAULT_CONFIG_PATH})
  --archive-dir DIR   Override archive directory for one selected account
  --dry-run           Show fetch/report targets without network calls
  --debug             Show diagnostic details on stderr (credentials redacted)
  --help, -h          Show help

Available accounts:
  ${available}

Config:
  ${configStatus}

Examples:
  copilot-leaderboard --init
  copilot-leaderboard --only ${available === '(none)' ? 'ACCOUNT,OTHER' : available.split(', ').slice(0, 2).join(',') || available} --month ${month}

Config format:
  [accounts.NAME] with label, api_path, archive_dir, and token_from_1password_item or token_from_env.
`);
}

function expandHome(value) {
  if (!value) return value;
  if (value === '~') return homedir();
  if (value.startsWith('~/')) return join(homedir(), value.slice(2));
  return value;
}

function normalizeAccount(name, account) {
  return {
    ...account,
    name,
    archive_dir: expandHome(account.archive_dir),
  };
}

function coerceTomlValue(rawValue) {
  const value = rawValue.trim();
  if ((value.startsWith('"') && value.endsWith('"')) || (value.startsWith("'") && value.endsWith("'"))) {
    return value.slice(1, -1);
  }
  throw new Error(`Unsupported TOML value: ${rawValue}`);
}

function parseConfigToml(content) {
  const accounts = {};
  let currentAccount = null;

  for (const [index, rawLine] of content.split('\n').entries()) {
    const line = rawLine.trim();
    if (!line || line.startsWith('#')) continue;

    const section = line.match(/^\[accounts\.([A-Za-z0-9_-]+)\]$/);
    if (section) {
      currentAccount = section[1];
      accounts[currentAccount] ??= {};
      continue;
    }

    const pair = rawLine.match(/^\s*([A-Za-z0-9_-]+)\s*=\s*(.+?)\s*$/);
    if (pair && currentAccount) {
      accounts[currentAccount][pair[1]] = coerceTomlValue(pair[2]);
      continue;
    }

    throw new Error(`Unsupported config line ${index + 1}: ${rawLine}`);
  }

  return accounts;
}

function defaultConfigTemplate() {
  return `# copilot-leaderboard config
# Copy this file to ${DEFAULT_CONFIG_PATH} or set COPILOT_LEADERBOARD_CONFIG.
#
# Each account becomes selectable through:
#   copilot-leaderboard --only <name>
#
# Auth:
# - token_from_1password_item: uses \`op item get ... --fields label=token --reveal\`
# - token_from_env: reads a token directly from your environment

[accounts.account_acme]
label = "acme"
api_path = "orgs/acme"
archive_dir = "~/src/copilot-leaderboard-acme"
token_from_1password_item = "GITHUB_COPILOT_TOKEN_ACME"
# token_from_env = "GITHUB_COPILOT_TOKEN_ACME"

`;
}

function validateAccounts(accounts, sourceLabel) {
  for (const [name, account] of Object.entries(accounts)) {
    for (const key of REQUIRED_ACCOUNT_KEYS) {
      if (!account[key]) {
        throw new Error(`Account '${name}' in ${sourceLabel} is missing '${key}'`);
      }
    }
    if (!account.token_from_1password_item && !account.token_from_env) {
      throw new Error(`Account '${name}' in ${sourceLabel} needs token_from_1password_item or token_from_env`);
    }
  }
}

function loadAccounts(configPath = DEFAULT_CONFIG_PATH) {
  if (!existsSync(configPath)) {
    return {
      accounts: {},
      configPath,
      configExists: false,
      sourceLabel: configPath,
    };
  }

  const parsed = parseConfigToml(readFileSync(configPath, 'utf8'));
  validateAccounts(parsed, configPath);

  return {
    accounts: Object.fromEntries(
      Object.entries(parsed).map(([name, account]) => [name, normalizeAccount(name, account)])
    ),
    configPath,
    configExists: true,
    sourceLabel: configPath,
  };
}

function initConfig(configPath = DEFAULT_CONFIG_PATH) {
  if (existsSync(configPath)) {
    throw new Error(`Config already exists: ${configPath}`);
  }
  mkdirSync(dirname(configPath), { recursive: true });
  writeFileSync(configPath, defaultConfigTemplate());
  return configPath;
}

function resolveSelectedAccounts(selectionNames, availableAccounts) {
  const missing = selectionNames.filter(name => !availableAccounts[name]);
  if (missing.length > 0) {
    const available = formatAvailableAccounts(availableAccounts);
    throw new Error(`Unknown account(s): ${missing.join(', ')}. Available: ${available}`);
  }
  return selectionNames.map(name => availableAccounts[name]);
}

function formatAvailableAccounts(accounts) {
  const names = Object.keys(accounts).sort();
  return names.length > 0 ? names.join(', ') : '(none)';
}

function fetchToken(account) {
  debug(`Fetching token for ${account.name} from ${account.token_from_env ? `environment variable ${account.token_from_env}` : `1Password item ${account.token_from_1password_item}`}`);
  if (account.token_from_env) {
    const token = process.env[account.token_from_env]?.trim();
    if (!token) throw new Error(`Environment variable '${account.token_from_env}' is empty`);
    return token;
  }

  const token = execSync(
    `op item get "${account.token_from_1password_item}" --fields label=token --reveal`,
    { encoding: 'utf8', stdio: ['pipe', 'pipe', 'pipe'] }
  ).trim();
  if (!token) throw new Error(`Empty token from 1Password item '${account.token_from_1password_item}'`);
  return token;
}

function fetchMeta(token, apiPath) {
  const url = `https://api.github.com/${apiPath}/copilot/metrics/reports/users-28-day/latest`;
  debug(`GET ${url} (authorization header redacted)`);
  const response = execSync(
    `curl -sSL -w "\\n%{http_code}" -H "Accept: application/vnd.github+json" -H "Authorization: Bearer ${token}" -H "X-GitHub-Api-Version: 2026-03-10" "${url}"`,
    { encoding: 'utf8', maxBuffer: 1024 * 1024 }
  );
  const responseLines = response.trimEnd().split('\n');
  const statusLine = responseLines.pop();
  const raw = responseLines.join('\n');
  if (statusLine === '401') {
    const identity = fetchAuthenticatedUser(token);
    throw new Error(`GitHub returned 401 for ${url}. Authenticated user endpoint: ${identity}`);
  }
  if (!/^2\d\d$/.test(statusLine)) {
    throw new Error(`GitHub returned HTTP ${statusLine} for ${url}: ${raw}`);
  }
  const json = JSON.parse(raw);
  debug(`Received metrics metadata (${raw.length} bytes, ${json.download_links?.length ?? 0} download link(s))`);
  if (!json.download_links?.length) throw new Error(`No download_links in response: ${raw}`);
  return { raw, json };
}

function fetchAuthenticatedUser(token) {
  const url = 'https://api.github.com/user';
  debug(`401 diagnostic: GET ${url} (authorization header redacted)`);
  try {
    const response = execSync(
      `curl -sSL -w "\\n%{http_code}" -H "Accept: application/vnd.github+json" -H "Authorization: Bearer ${token}" -H "X-GitHub-Api-Version: 2026-03-10" "${url}"`,
      { encoding: 'utf8', maxBuffer: 1024 * 1024 }
    );
    const responseLines = response.trimEnd().split('\n');
    const statusLine = responseLines.pop();
    const raw = responseLines.join('\n');
    if (statusLine === '401') return `${url} also returned 401 (token is invalid or expired)`;
    if (!/^2\d\d$/.test(statusLine)) return `${url} returned HTTP ${statusLine}`;
    const json = JSON.parse(raw);
    return `${url} returned login=${json.login ?? '(no login)'}`;
  } catch (error) {
    return `${url} could not be checked (${error.message.split('\n')[0]})`;
  }
}

function downloadAllNdjson(links) {
  debug(`Downloading ${links.length} NDJSON link(s)`);
  return links
    .map((url, index) => {
      debug(`GET download link ${index + 1}/${links.length}: ${url.replace(/\?.*$/, '?<query redacted>')}`);
      const content = execSync(`curl -fsSL "${url}"`, { encoding: 'utf8', maxBuffer: 50 * 1024 * 1024 });
      debug(`Downloaded link ${index + 1}/${links.length} (${content.length} bytes)`);
      return content;
    })
    .join('');
}

async function pMap(items, fn, concurrency) {
  const results = [];
  let i = 0;
  async function worker() {
    while (i < items.length) {
      const idx = i++;
      results[idx] = await fn(items[idx], idx);
    }
  }
  await Promise.all(Array.from({ length: concurrency }, worker));
  return results;
}

function parseNdjson(content) {
  return content.trim().split('\n').filter(Boolean).map(line => JSON.parse(line));
}

function loadArchive(archiveDir) {
  const dir = join(archiveDir, 'archive');
  if (!existsSync(dir)) {
    debug(`Archive directory does not exist: ${dir}`);
    return [];
  }
  const files = readdirSync(dir).filter(f => f.endsWith('.ndjson')).sort();
  debug(`Loading ${files.length} archive file(s) from ${dir}`);
  const seen = new Map();
  for (const file of files) {
    const records = parseNdjson(readFileSync(join(dir, file), 'utf8'));
    for (const r of records) seen.set(`${r.user_login}:${r.day}`, r);
  }
  const records = [...seen.values()];
  debug(`Loaded ${records.length} unique user/day record(s)`);
  return records;
}

function buildLeaderboard(records, month) {
  const monthRecords = records.filter(r => r.day.startsWith(month));
  const days = [...new Set(monthRecords.map(r => r.day))].sort();

  const byUser = {};
  for (const r of monthRecords) {
    byUser[r.user_login] ??= {};
    const prev = byUser[r.user_login][r.day] ?? { credits: 0, interactions: 0 };
    byUser[r.user_login][r.day] = {
      credits: prev.credits + Math.floor(r.ai_credits_used ?? 0),
      interactions: prev.interactions + (r.user_initiated_interaction_count ?? 0),
    };
  }

  const users = Object.entries(byUser)
    .map(([login, dayData]) => {
      const totalCredits = Object.values(dayData).reduce((a, b) => a + b.credits, 0);
      const totalInteractions = Object.values(dayData).reduce((a, b) => a + b.interactions, 0);
      const score = totalCredits + totalInteractions * INTERACTION_CREDIT_MULTIPLIER;
      return { login, dayData, totalCredits, totalInteractions, score };
    })
    .sort((a, b) => b.score - a.score);

  const allDayTotals = Object.fromEntries(
    days.map(d => [d, {
      credits: users.reduce((s, u) => s + (u.dayData[d]?.credits ?? 0), 0),
      interactions: users.reduce((s, u) => s + (u.dayData[d]?.interactions ?? 0), 0),
    }])
  );
  const grandCredits = Object.values(allDayTotals).reduce((s, v) => s + v.credits, 0);
  const grandInteractions = Object.values(allDayTotals).reduce((s, v) => s + v.interactions, 0);

  return { days, users, allDayTotals, grandCredits, grandInteractions, month };
}

function renderMarkdown(leaderboard, orgLabel, generatedDate) {
  const { days, users, allDayTotals, grandCredits, grandInteractions, month } = leaderboard;
  const [year, mon] = month.split('-');
  const monthName = new Date(Number(year), Number(mon) - 1, 1)
    .toLocaleString('en', { month: 'long', year: 'numeric' });
  const seatCount = users.length;
  const avgCredits = seatCount > 0 ? (grandCredits / seatCount).toFixed(1) : '0';
  const avgInteractions = seatCount > 0 ? (grandInteractions / seatCount).toFixed(1) : '0';
  const stamp = generatedDate ?? new Date().toISOString().slice(0, 10);

  const c = {
    creditVivid: '\x1b[38;5;214m',
    interactionVivid: '\x1b[38;5;45m',
    creditDim: '\x1b[90m',
    divider: '\x1b[2m',
    reset: '\x1b[0m',
  };

  const coloredNum = (num) => num === 0 || num === '0'
    ? `${c.creditDim}${num}${c.reset}`
    : `${c.creditVivid}${num}${c.reset}`;

  const coloredInteraction = (num) => num === 0 || num === '0'
    ? `${c.creditDim}${num}${c.reset}`
    : `${c.interactionVivid}${num}${c.reset}`;

  const fmtCredits = (v) => {
    if (!v || v.credits === 0) return v?.credits === 0 ? coloredNum('0') : '';
    return coloredNum(String(v.credits));
  };

  const fmtInteractions = (v) => {
    if (!v || v.interactions === 0) return v?.interactions === 0 ? coloredInteraction('0') : '';
    return coloredInteraction(String(v.interactions));
  };

  const dayNums = days.map(d => String(parseInt(d.slice(8), 10)));
  const stripAnsi = (str) => str.replace(/\x1b\[[0-9;]*m/g, '');

  const calcColW = (fmtCellFn) => {
    const fmtGrand = fmtCellFn({ credits: grandCredits, interactions: grandInteractions });
    return [
      Math.max(4, ...users.map(u => u.login.length)),
      Math.max(11, stripAnsi(fmtGrand).length),
      ...dayNums.map((h, i) => {
        const d = days[i];
        const widths = [
          h.length,
          stripAnsi(fmtCellFn(allDayTotals[d])).length,
          ...users.map(u => stripAnsi(fmtCellFn(u.dayData[d])).length),
        ];
        return Math.max(...widths);
      }),
    ];
  };

  const colWCredits = calcColW(fmtCredits);
  const colWInteractions = calcColW(fmtInteractions);
  const colW = [
    Math.max(colWCredits[0], colWInteractions[0]),
    Math.max(colWCredits[1], colWInteractions[1]),
    ...dayNums.map((_, i) => Math.max(colWCredits[i + 2] ?? 0, colWInteractions[i + 2] ?? 0, DATE_COLUMN_MIN_WIDTH)),
  ];

  const buildTable = (fmtCellFn, title) => {
    const pad = (s, w) => String(s).padEnd(w + (s.length - stripAnsi(s).length));
    const mkRow = cells => '| ' + cells.map((cell, i) => pad(cell, colW[i])).join(` ${c.divider}|${c.reset} `) + ` ${c.divider}|${c.reset}`;
    const mkSep = () => `${c.divider}|${colW.map(w => '-'.repeat(w + 2)).join('|')}|${c.reset}`;

    const fmtGrand = fmtCellFn({ credits: grandCredits, interactions: grandInteractions });
    return [
      `### ${title}`,
      '',
      mkRow(['User', 'Month total', ...dayNums]),
      mkSep(),
      mkRow(['**All**', fmtGrand, ...days.map(d => fmtCellFn(allDayTotals[d]))]),
      ...users.map(u => mkRow([
        u.login,
        fmtCellFn({ credits: u.totalCredits, interactions: u.totalInteractions }),
        ...days.map(d => fmtCellFn(u.dayData[d])),
      ])),
    ];
  };

  return [
    `# Copilot Leaderboard — ${orgLabel} — ${monthName}`,
    '',
    `_${days.length} days of data | ${seatCount} active seats | Average per seat: ${avgCredits} credits / ${avgInteractions} interactions_`,
    '',
    ...buildTable(fmtCredits, `${c.creditVivid}ai_credits_used${c.reset}`),
    '',
    ...buildTable(fmtInteractions, `${c.interactionVivid}user_initiated_interaction_count${c.reset}`),
    '',
    '**Legend:**',
    `- ${c.creditVivid}●${c.reset} ai_credits_used (floored) [primary]`,
    `- ${c.interactionVivid}●${c.reset} user_initiated_interaction_count [secondary]`,
    `- ${c.creditDim}0${c.reset} = zero values (very dim)`,
    '',
    `_generated ${stamp}_`,
    '',
  ].join('\n');
}

const argv = process.argv.slice(2);
const explicitSelections = [];

let skipFetch = true;
let dryRun = false;
let month = null;
let archiveDirOverride = null;
let doBackfill = false;
let doInit = false;
let configPath = process.env.COPILOT_LEADERBOARD_CONFIG || DEFAULT_CONFIG_PATH;
let wantHelp = false;
let includeAllAccounts = false;
let debugEnabled = false;

function debug(message) {
  if (debugEnabled) process.stderr.write(`[debug] ${message}\n`);
}

function readOptionValue(optionName, index) {
  const value = argv[index + 1];
  if (!value || value.startsWith('--')) {
    process.stderr.write(`Error: ${optionName} requires a value\n`);
    process.exit(1);
  }
  return value;
}

for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  if (a === '--all')          includeAllAccounts = true;
  else if (a === '--only')         explicitSelections.push(...readOptionValue(a, i++).split(',').map(v => v.trim()).filter(Boolean));
  else if (a === '--init')         doInit = true;
  else if (a === '--config')       configPath = readOptionValue(a, i++);
  else if (a === '--update')       skipFetch = false;
  else if (a === '--report-only')  skipFetch = true;
  else if (a === '--dry-run')      dryRun = true;
  else if (a === '--debug')        debugEnabled = true;
  else if (a === '--month')        month = readOptionValue(a, i++);
  else if (a === '--archive-dir')  archiveDirOverride = readOptionValue(a, i++);
  else if (a === '--backfill')     { skipFetch = false; doBackfill = true; }
  else if (a === '-h' || a === '--help') wantHelp = true;
  else { process.stderr.write(`Unknown option: ${a}\n`); process.exit(1); }
}

if (!month) {
  const now = new Date();
  month = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
}

debug(`Arguments parsed: month=${month}, skipFetch=${skipFetch}, backfill=${doBackfill}, dryRun=${dryRun}, config=${configPath}`);

if (doBackfill && !month) {
  process.stderr.write('Error: --backfill requires --month YYYY-MM\n');
  process.exit(1);
}

if (doInit && !wantHelp) {
  try {
    const writtenPath = initConfig(configPath);
    process.stdout.write(`Wrote ${writtenPath}\n`);
    process.stdout.write('Added example accounts. Edit this file with your own account names, API paths, archive dirs, and token source.\n');
    process.stdout.write('Then run: copilot-leaderboard --help\n');
    process.exit(0);
  } catch (error) {
    process.stderr.write(`${error.message}\n`);
    process.exit(1);
  }
}

let accountState;
try {
  accountState = loadAccounts(configPath);
} catch (error) {
  process.stderr.write(`${error.message}\n`);
  process.exit(1);
}

debug(`Loaded configuration: exists=${accountState.configExists}, accounts=${Object.keys(accountState.accounts).sort().join(', ') || '(none)'}`);

const availableNames = Object.keys(accountState.accounts).sort();

if (wantHelp) {
  printHelp(accountState);
  process.exit(0);
}

if (!accountState.configExists) {
  process.stderr.write(`Config not found: ${accountState.configPath}\n`);
  process.stderr.write(`Create a starter config with: copilot-leaderboard --init\n`);
  process.exit(1);
}

const selectionNames = includeAllAccounts
  ? availableNames
  : [...new Set(explicitSelections)];

if (selectionNames.length === 0) {
  printHelp(accountState);
  process.exit(1);
}

let selectedAccounts;
try {
  selectedAccounts = resolveSelectedAccounts(selectionNames, accountState.accounts);
} catch (error) {
  process.stderr.write(`${error.message}\n`);
  process.exit(1);
}

debug(`Selected accounts: ${selectedAccounts.map(account => account.name).join(', ')}`);

if (availableNames.length === 0) {
  process.stderr.write(`No accounts configured in ${accountState.configPath}.\n`);
  process.stderr.write(`Create a starter config with: copilot-leaderboard --init\n`);
  process.exit(1);
}

if (archiveDirOverride && selectedAccounts.length !== 1) {
  process.stderr.write('Error: --archive-dir only supports a single selected account\n');
  process.exit(1);
}

async function runForAccount(account) {
  const cfg = { ...account };
  if (archiveDirOverride) cfg.archive_dir = archiveDirOverride;

  process.stderr.write(`Using config: ${accountState.configPath}\n`);
  process.stderr.write(`Using account: ${cfg.name} (${cfg.label})\n`);

  const archivePath = join(cfg.archive_dir, 'archive');
  const today = new Date().toISOString().slice(0, 10);
  const archiveFile = join(archivePath, `${today}.ndjson`);
  const apiUrl = `https://api.github.com/${cfg.api_path}/copilot/metrics/reports/users-28-day/latest`;
  debug(`Starting account ${cfg.name}: archive=${cfg.archive_dir}, month=${month}, mode=${skipFetch ? 'report-only' : (doBackfill ? 'backfill' : 'update')}`);

  if (dryRun) {
    process.stderr.write(`[dry-run] Would fetch: ${apiUrl}\n`);
    process.stderr.write(`[dry-run] Would save to: ${archiveFile}\n`);
    process.stderr.write(`[dry-run] Would write: ${join(cfg.archive_dir, `${month}-report.md`)}\n`);
    return;
  }

  if (!skipFetch) {
    if (cfg.token_from_env) {
      process.stderr.write(`Reading token from env (${cfg.token_from_env})...\n`);
    } else {
      process.stderr.write(`Fetching token from 1Password (${cfg.token_from_1password_item})...\n`);
    }
    const token = fetchToken(cfg);
    debug('Token acquired (value redacted)');
    mkdirSync(archivePath, { recursive: true });

    if (doBackfill) {
      const [year, mon] = month.split('-');
      const numDays = new Date(Number(year), Number(mon), 0).getDate();
      const dates = [];
      for (let d = 1; d <= numDays; d++) {
        dates.push(`${year}-${mon}-${String(d).padStart(2, '0')}`);
      }
      const missing = dates.filter(day => !existsSync(join(archivePath, `${day}-1day-meta.json`)));
      const cached = dates.length - missing.length;
      debug(`Backfill plan: ${dates.length} day(s), ${missing.length} missing, ${cached} cached`);
      process.stderr.write(`Backfilling ${missing.length}/${dates.length} day(s) in ${month}${cached > 0 ? ` (${cached} already cached, skipping)` : ''}...\n`);

      const fetchDay = async (day) => {
        let raw;
        try {
          raw = execSync(
            `curl -fsSL -H "Accept: application/vnd.github+json" -H "Authorization: Bearer ${token}" -H "X-GitHub-Api-Version: 2026-03-10" "https://api.github.com/${cfg.api_path}/copilot/metrics/reports/users-1-day?day=${day}"`,
            { encoding: 'utf8', maxBuffer: 1024 * 1024 }
          );
          debug(`Backfill response for ${day}: ${raw.length} bytes`);
          writeFileSync(join(archivePath, `${day}-1day-meta.json`), raw);
          const meta = JSON.parse(raw);
          if (!meta.download_links?.length) {
            process.stderr.write(`  - ${day} (no data)\n`);
            return;
          }
          const ndjson = downloadAllNdjson(meta.download_links);
          writeFileSync(join(archivePath, `${day}-1day.ndjson`), ndjson);
          process.stderr.write(`  ✓ ${day}\n`);
        } catch (error) {
          if (raw !== undefined) writeFileSync(join(archivePath, `${day}-1day-meta.json`), raw);
          const detail = raw === '' ? 'empty response' : error.message.split('\n')[0];
          process.stderr.write(`  - ${day} (${detail})\n`);
        }
      };

      await pMap(missing, fetchDay, 1);
    } else {
      process.stderr.write(`GET ${apiUrl}\n`);
      const { raw: metaRaw, json: meta } = fetchMeta(token, cfg.api_path);
      writeFileSync(join(archivePath, `${today}-meta.json`), metaRaw);
      const linkCount = meta.download_links.length;
      process.stderr.write(`Downloading ${linkCount} NDJSON shard(s)...\n`);
      const ndjson = downloadAllNdjson(meta.download_links);
      writeFileSync(archiveFile, ndjson);
      debug(`Wrote metadata and archive snapshot: ${archiveFile}`);
      process.stderr.write(`Archived: ${archiveFile} (${linkCount} shard${linkCount > 1 ? 's' : ''})\n`);
    }
  }

  const records = loadArchive(cfg.archive_dir);
  if (records.length === 0) {
    process.stderr.write(`No archive data found in ${cfg.archive_dir}/archive/\n`);
    process.exit(1);
  }

  const leaderboard = buildLeaderboard(records, month);
  debug(`Built leaderboard for ${month}: ${leaderboard.users.length} user(s), ${leaderboard.days.length} day(s), ${leaderboard.grandCredits} credits, ${leaderboard.grandInteractions} interactions`);
  const markdown = renderMarkdown(leaderboard, cfg.label);

  mkdirSync(cfg.archive_dir, { recursive: true });
  const reportFile = join(cfg.archive_dir, `${month}-report.md`);
  writeFileSync(reportFile, markdown);
  debug(`Wrote report: ${reportFile} (${markdown.length} bytes)`);
  process.stdout.write(markdown + '\n');
  process.stderr.write(`\nReport saved → ${reportFile}\n`);

  const self = `copilot-leaderboard --only ${cfg.name}`;
  process.stderr.write('\nNext steps:\n');
  if (skipFetch) {
    process.stderr.write(`  ${self} --update                      # fetch today's 28-day snapshot\n`);
    process.stderr.write(`  ${self} --backfill --month ${month}   # backfill all days in ${month}\n`);
    const prevMonth = new Date(Number(month.split('-')[0]), Number(month.split('-')[1]) - 1, 1);
    const prevMonthStr = `${prevMonth.getFullYear()}-${String(prevMonth.getMonth() + 1).padStart(2, '0')}`;
    process.stderr.write(`  ${self} --backfill --month ${prevMonthStr}   # backfill previous month\n`);
  } else {
    process.stderr.write(`  ${self}                    # view report offline\n`);
    process.stderr.write(`  ${self} --month ${month}   # same month, offline\n`);
  }
}

for (const account of selectedAccounts) {
  await runForAccount(account);
}
