#!/usr/bin/env bash
# Install a macOS LaunchAgent that syncs the Podman VM clock after host wake.
# The agent polls every 2 minutes and runs chronyc makestep when drift > 30s,
# so the VM clock is corrected within 2 minutes of returning from hibernation.
#
# Usage:
#   podman-install-wake-handler          # install/update
#   podman-install-wake-handler --remove # uninstall

set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
LABEL="dk.nine.podman-clock-sync"
PLIST_PATH="$HOME/Library/LaunchAgents/${LABEL}.plist"

# Resolve absolute path of podman-sync-clock so the agent can call it
# without needing the user's PATH.
SYNC_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/podman-sync-clock"

if [[ "${1:-}" == "--remove" ]]; then
  if launchctl list "$LABEL" >/dev/null 2>&1; then
    launchctl unload "$PLIST_PATH" 2>/dev/null || true
    printf 'unloaded: %s\n' "$LABEL"
  fi
  rm -f "$PLIST_PATH"
  printf 'removed: %s\n' "$PLIST_PATH"
  exit 0
fi

if [[ ! -x "$SYNC_BIN" ]]; then
  printf '%s: %s not found or not executable\n' "$SCRIPT_NAME" "$SYNC_BIN" >&2
  exit 1
fi

# The agent runs a small wrapper: check VM clock drift, and only call makestep
# when drift > 30s to avoid noisy log entries when everything is fine.
WRAPPER="$(cat <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
machine_running() {
  podman machine list --format json 2>/dev/null | \
    command -p jq -e -r '.[] | select(.Running == true) | .Name' >/dev/null 2>&1
}
machine_running || exit 0
host_epoch="$(date +%s)"
vm_epoch="$(podman machine ssh 'date +%s' 2>/dev/null | tr -d '\r' || true)"
[[ -n "$vm_epoch" && "$vm_epoch" =~ ^[0-9]+$ ]] || exit 0
drift=$(( vm_epoch - host_epoch ))
(( drift < 0 )) && drift=$(( -drift ))
(( drift > 30 )) || exit 0
podman machine ssh 'sudo chronyc makestep' >/dev/null 2>&1 || true
EOF
)"

WRAPPER_PATH="$HOME/.local/share/podman-clock-sync-agent.sh"
mkdir -p "$(dirname "$WRAPPER_PATH")"
printf '%s\n' "$WRAPPER" > "$WRAPPER_PATH"
chmod +x "$WRAPPER_PATH"

mkdir -p "$HOME/Library/LaunchAgents"
cat > "$PLIST_PATH" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>${WRAPPER_PATH}</string>
  </array>
  <key>StartInterval</key>
  <integer>120</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>${HOME}/Library/Logs/podman-clock-sync.log</string>
  <key>StandardErrorPath</key>
  <string>${HOME}/Library/Logs/podman-clock-sync.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
PLIST

# Unload old version if present before reloading
if launchctl list "$LABEL" >/dev/null 2>&1; then
  launchctl unload "$PLIST_PATH" 2>/dev/null || true
fi
launchctl load "$PLIST_PATH"

printf 'installed: %s\n' "$PLIST_PATH"
printf 'agent:     %s\n' "$LABEL"
printf 'interval:  every 120s (VM clock corrected within 2 minutes of host wake)\n'
printf 'log:       %s/Library/Logs/podman-clock-sync.log\n' "$HOME"
printf '\nTo remove: %s --remove\n' "$SCRIPT_NAME"
