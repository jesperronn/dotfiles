#!/usr/bin/env bash
# shellcheck shell=bash

set -euo pipefail

# ── Global flags and cached state ──────────────────────────────────────
#
# Purpose:
#   Interactive git worktree manager using fzf. Lists existing worktrees,
#   lets you select one or more to delete, or press Ctrl-A to create a new one.
#
# Usage:
#   bin/gwt
#
# Interactions:
#   fzf worktree picker   Select one or more worktrees to delete (Tab toggles).
#   Ctrl-A                Create a new worktree (auto-generated name).
#   -h, --help            Show this help and exit.
#
# Notes:
#   - Must be run inside (or below) a git repository.
#   - Worktrees are created at repo_root/../<repo_name>-wt<N>.
#   - After creating a worktree, a 3-second countdown lets you cd into it (press y).
#   - Each row is tagged <dirty|merged|unmerged|no-commits|clean|missing>.
#   - fzf is required for interactive mode.

GWT_TILDE='~'
GWT_COLOR_ENABLED=0
GWT_VERBOSE=0
GWT_FZF_FOUND=0
GWT_REPOSITORY_ROOT=""
GWT_WORKTREE_LINES=()

GWT_C_RESET=$'\033[0m'
GWT_C_DIM=$'\033[2m'
GWT_C_BOLD=$'\033[1m'
GWT_C_RED=$'\033[31m'
GWT_C_GREEN=$'\033[32m'
GWT_C_SECTION=$'\033[33m'
GWT_C_ACCENT=$'\033[35m'

# ── Reset helpers ──────────────────────────────────────────────────────

gwt_reset_state() {
  GWT_COLOR_ENABLED=0
  GWT_VERBOSE=0
  GWT_FZF_FOUND=0
  GWT_REPOSITORY_ROOT=""
  GWT_WORKTREE_LINES=()
}

# ── Output helpers ─────────────────────────────────────────────────────

gwt_color_print() {
  local color="$1"
  shift

  if (( GWT_COLOR_ENABLED )); then
    printf '%b%s%b\n' "$color" "$*" "$GWT_C_RESET"
  else
    printf '%s\n' "$*"
  fi
}

gwt_info() {
  gwt_color_print "${GWT_C_BOLD}${GWT_C_SECTION}" "$*"
}

gwt_success() {
  gwt_color_print "$GWT_C_GREEN" "$*"
}

gwt_warn() {
  gwt_color_print "${GWT_C_RED}" "$*" >&2
}

gwt_error() {
  gwt_color_print "${GWT_C_RED}${GWT_C_BOLD}" "$*" >&2
}

gwt_dim() {
  gwt_color_print "$GWT_C_DIM" "$*"
}

gwt_verbose() {
  if (( GWT_VERBOSE )); then
    gwt_dim "$*"
  fi
}

# Erase the line above the cursor (the yellow prompt line) once fzf has
# closed, so only the final status output remains. No-op when not a tty.
gwt_clear_prompt_line() {
  if [[ -t 1 || "${GWT_FORCE_CLEAR:-0}" == 1 ]]; then
    printf '\033[1A\033[2K\r'
  fi
}

# ── Usage ──────────────────────────────────────────────────────────────

gwt_usage() {
  local section_style="" tool_style="" reset_style=""

  if (( GWT_COLOR_ENABLED )); then
    section_style="${GWT_C_BOLD}${GWT_C_SECTION}"
    tool_style="${GWT_C_BOLD}${GWT_C_ACCENT}"
    reset_style="$GWT_C_RESET"
  fi

  printf '%sUsage:%s %sgwt%s\n\n' "$section_style" "$reset_style" "$tool_style" "$reset_style"
  printf '%sDescription:%s Manage git worktrees interactively.\n' "$section_style" "$reset_style"
  printf '  Lists existing worktrees via fzf. Select one or more to delete.\n'
  printf '  Tab toggles selection; Enter deletes everything selected.\n'
  printf '  Press Ctrl-A (or your fzf binding) to create a new worktree.\n'
  printf '  Each row ends with <status>: dirty, merged (into main), unmerged,\n'
  printf '  no-commits, clean or missing.\n\n'
  printf '%sOptions:%s\n' "$section_style" "$reset_style"
  printf '  %s-h, --help%s  Show this help.\n\n' "$GWT_C_GREEN" "$GWT_C_RESET"
}

# ── Option parsing ─────────────────────────────────────────────────────

gwt_parse_opts() {
  if [[ $# -eq 0 ]]; then
    return 0
  fi

  case "${1-}" in
    -h|--help)
      gwt_usage
      return 1
      ;;
  esac

  return 0
}

# ── Prerequisites ──────────────────────────────────────────────────────

gwt_parse_prereqs() {
  # Detect terminal capabilities
  if command -v tput >/dev/null 2>&1 && [[ -t 1 ]]; then
    GWT_COLOR_ENABLED=1
  else
    GWT_COLOR_ENABLED=0
  fi

  # Check git
  if ! command -v git >/dev/null 2>&1; then
    gwt_error "git is not installed or not in PATH."
    return 1
  fi

  # Check fzf
  if command -v fzf >/dev/null 2>&1; then
    GWT_FZF_FOUND=1
  else
    gwt_error "fzf is not installed or not in PATH."
    gwt_error "Install it with: brew install fzf"
    return 1
  fi
}

# ── Repository discovery ───────────────────────────────────────────────

gwt_find_repo_root() {
  local toplevel

  toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" || true

  if [[ -z "$toplevel" ]]; then
    gwt_error "Not inside a git repository."
    gwt_error "Run gwt from within (or below) a git repository."
    return 1
  fi

  GWT_REPOSITORY_ROOT="$toplevel"
  gwt_verbose "Repository root: $GWT_REPOSITORY_ROOT"
  return 0
}

# ── Worktree listing ───────────────────────────────────────────────────

gwt_list_worktrees() {
  # Raw output: path  branch  HEAD
  local raw_output=""

  raw_output="$(git -C "$GWT_REPOSITORY_ROOT" worktree list 2>&1)" || true

  GWT_WORKTREE_LINES=()
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    GWT_WORKTREE_LINES+=("$line")
  done <<< "$raw_output"

  gwt_verbose "Found ${#GWT_WORKTREE_LINES[@]} worktree(s)"
}

# ── Worktree status ────────────────────────────────────────────────────

# Branch worktrees are compared against: origin/HEAD, else main, else master.
gwt_base_ref() {
  local ref=""

  ref="$(git -C "$GWT_REPOSITORY_ROOT" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)" || ref=""
  if [[ -z "$ref" ]]; then
    local candidate
    for candidate in main master; do
      if git -C "$GWT_REPOSITORY_ROOT" rev-parse --verify --quiet "refs/heads/$candidate" >/dev/null; then
        ref="$candidate"
        break
      fi
    done
  fi
  printf '%s\n' "$ref"
}

# Print status tags for one `git worktree list` line, comma-joined:
# dirty, merged (tip is an ancestor of base, not equal to it), no-commits
# (tip equals base), unmerged, clean, or missing. Squash-merged branches
# show as unmerged because ancestry cannot see them.
gwt_worktree_status() {
  local line="$1"
  local base="${2-}"
  local path="" sha="" tags=()

  path="$(gwt_line_path "$line")"
  if [[ ! -d "$path" ]]; then
    printf 'missing\n'
    return 0
  fi

  if [[ -n "$(git -C "$path" status --porcelain 2>/dev/null | head -n1)" ]]; then
    tags+=("dirty")
  fi

  if [[ "$line" =~ \[([^]]+)\][[:space:]]*$ && -n "$base" ]]; then
    local branch="${BASH_REMATCH[1]}"
    if [[ "$branch" != "$base" && "$branch" != "${base#origin/}" ]]; then
      sha="$(git -C "$path" rev-parse HEAD 2>/dev/null)" || sha=""
      if [[ -n "$sha" ]] && git -C "$path" merge-base --is-ancestor "$sha" "$base" 2>/dev/null; then
        if [[ "$sha" == "$(git -C "$path" rev-parse "$base" 2>/dev/null)" ]]; then
          tags+=("no-commits")
        else
          tags+=("merged")
        fi
      elif [[ -n "$sha" ]]; then
        tags+=("unmerged")
      fi
    fi
  fi

  if (( ${#tags[@]} == 0 )); then
    printf 'clean\n'
  else
    local IFS=,
    printf '%s\n' "${tags[*]}"
  fi
}

# Shorten a path for display: $HOME becomes ~, and anything deeper than
# three components keeps only the last two (".../scratchpad/wt-x").
gwt_short_path() {
  local path="$1"

  if [[ -n "${HOME-}" && "$path" == "$HOME"* ]]; then
    path="${GWT_TILDE}${path#"$HOME"}"
  fi

  local trimmed="${path#/}"
  local rest="$trimmed" depth=1
  while [[ "$rest" == */* ]]; do
    rest="${rest#*/}"
    depth=$((depth + 1))
  done

  if (( depth > 3 )); then
    local last="${path##*/}"
    local parent="${path%/*}"
    printf '…/%s/%s\n' "${parent##*/}" "$last"
  else
    printf '%s\n' "$path"
  fi
}

# Build one fzf row: "<full path><TAB><status> <branch> <sha> <short path>".
# fzf shows only the part after the tab (--with-nth); the full path stays in
# field 1 so gwt_line_path can recover it from the selected output.
# Args: line status branch_width
gwt_display_row() {
  local line="$1" status="$2" width="${3:-0}"
  local path="" sha="" branch=""

  path="$(gwt_line_path "$line")"
  local row_re='[[:space:]]([0-9a-f]{7,40})[[:space:]]+[[(]([^])]*)[])][[:space:]]*$'
  if [[ "$line" =~ $row_re ]]; then
    sha="${BASH_REMATCH[1]}"
    branch="${BASH_REMATCH[2]}"
  fi

  printf '%s\t%-16s %-*s  %s  %s\n' \
    "$path" "$status" "$width" "$branch" "$sha" "$(gwt_short_path "$path")"
}

# ── Fzf selector ───────────────────────────────────────────────────────

gwt_select_worktree() {
  if (( ! GWT_FZF_FOUND )); then
    gwt_error "fzf is required for interactive mode."
    return 1
  fi

  # Build fzf input: display lines
  local display_lines=()
  local entry=""
  local base="" status="" statuses=() width=0 i=0
  base="$(gwt_base_ref)"
  for entry in "${GWT_WORKTREE_LINES[@]}"; do
    statuses+=("$(gwt_worktree_status "$entry" "$base")")
    if [[ "$entry" =~ \[([^]]*)\][[:space:]]*$ ]] && (( ${#BASH_REMATCH[1]} > width )); then
      width=${#BASH_REMATCH[1]}
    fi
  done
  for entry in "${GWT_WORKTREE_LINES[@]}"; do
    display_lines+=("$(gwt_display_row "$entry" "${statuses[i]}" "$width")")
    i=$((i + 1))
  done

  # Default fzf layout is bottom-up, so the first line (the main checkout)
  # sits at the bottom. 'load:last' puts the cursor on the last item, the top
  # row on screen. Tab keeps fzf's default (toggle, then move to the next line down).
  # Height is adaptive (~50%): fits the list, grows up to half the terminal
  # (not tput, which is unreliable inside $(...)).
  # We use a signal file to communicate "add" vs "select"
  # because fzf's --bind execute can't return a value to bash easily.
  # --multi lets the user toggle several worktrees with Tab; fzf prints
  # every selected line, newline-separated.
  local fzf_output=""
  local fzf_args=(--multi --delimiter=$'\t' --with-nth=2 --prompt='Delete> ' --header='Tab: select · Enter: delete · Ctrl-A: add' --height "${GWT_FZF_HEIGHT:-~50%}" --bind 'load:last,ctrl-a:execute(echo ADD > /tmp/gwt-add-signal)')

  fzf_output="$(printf '%s\n' "${display_lines[@]}" | fzf "${fzf_args[@]}" 2>/dev/null)" || true

  # Check if user pressed Ctrl-A (the signal file would exist)
  if [[ -f /tmp/gwt-add-signal ]]; then
    rm -f /tmp/gwt-add-signal
    echo "ADD"
    return 0
  fi

  if [[ -z "$fzf_output" ]]; then
    # User cancelled — exit cleanly
    return 1
  fi

  echo "$fzf_output"
  return 0
}

# ── Worktree name generation ───────────────────────────────────────────

gwt_generate_worktree_name() {
  # <repo_name>-wt, <repo_name>-wt1, <repo_name>-wt2, ...
  local repo_name

  repo_name="$(basename "$GWT_REPOSITORY_ROOT")"

  local candidate="${repo_name}-wt"
  local full_path="${GWT_REPOSITORY_ROOT%/..*}/../${candidate}"

  # Check if the path already exists as a worktree
  if git -C "$GWT_REPOSITORY_ROOT" worktree list 2>/dev/null | grep -q "${full_path}	"; then
    local i=1
    while true; do
      candidate="${repo_name}-wt${i}"
      full_path="${GWT_REPOSITORY_ROOT%/..*}/../${candidate}"
      if ! git -C "$GWT_REPOSITORY_ROOT" worktree list 2>/dev/null | grep -q "${full_path}	"; then
        break
      fi
      (( i++ ))
    done
  fi

  echo "$full_path"
}

# ── Add worktree ───────────────────────────────────────────────────────

gwt_apply_add() {
  local worktree_path

  worktree_path="$(gwt_generate_worktree_name)"

  gwt_dim "git worktree add ${worktree_path}"
  gwt_verbose "Creating worktree at: $worktree_path"

  if git -C "$GWT_REPOSITORY_ROOT" worktree add "$worktree_path" 2>&1; then
    gwt_success "Worktree created at: $worktree_path"
  else
    gwt_error "Failed to create worktree at: $worktree_path"
    return 1
  fi

  gwt_countdown_navigate "$worktree_path"
}

# ── 3-second countdown ─────────────────────────────────────────────────

gwt_countdown_navigate() {
  local worktree_path="$1"
  local remaining=3
  local key=""

  gwt_verbose "Starting 3s countdown for auto-navigate"

  while (( remaining > 0 )); do
    # Print countdown in-place (same line)
    printf '\r%sNavigate to %s? [y/N] (%ss)%s' \
      "$GWT_C_DIM" "$worktree_path" "$remaining" "$GWT_C_RESET"

    # Read a single character with a short timeout
    if read -rs -n1 -t 1 key 2>/dev/null; then
      if [[ "$key" == "y" || "$key" == "Y" ]]; then
        printf '\r%sNavigating to %s%s\n' "$GWT_C_GREEN" "$worktree_path" "$GWT_C_RESET"
        cd "$worktree_path" || return 1
        gwt_success "Now in: $(pwd)"
        return 0
      else
        # Any other key — just ignore, continue countdown
        key=""
      fi
    fi

    (( remaining-- ))
  done

  # Clear the countdown line
  local spacer
  spacer="$(printf '%0.s ' $(seq 1 60))"
  printf '\r%s%s%s\n' "$spacer" "$GWT_C_RESET" "$spacer"
  gwt_verbose "Countdown expired — staying in $(pwd)"
  return 0
}

# ── Delete worktree(s) ─────────────────────────────────────────────────

# Extract the worktree path from a `git worktree list` line. The path may
# contain spaces, so strip the trailing "<hash> [branch]" / "<hash> (detached
# HEAD)" columns instead of taking the first word. Tab-separated lines (path
# first) are handled too.
gwt_line_path() {
  local line="$1"

  if [[ "$line" == *$'\t'* ]]; then
    printf '%s\n' "${line%%$'\t'*}"
  elif [[ "$line" =~ ^(.*[^[:space:]])[[:space:]]+[0-9a-f]{7,40}[[:space:]]+[\[\(] ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  else
    printf '%s\n' "${line%% *}"
  fi
}

# Ask before force-removing a dirty worktree (it deletes untracked files).
# GWT_ASSUME_FORCE=y|n answers without prompting (used by tests).
gwt_confirm_force() {
  local worktree_path="$1"
  local answer="${GWT_ASSUME_FORCE:-}"

  if [[ -z "$answer" ]]; then
    printf '%s has modified or untracked files. Force remove? [y/N] ' "$worktree_path" >&2
    read -r answer </dev/tty 2>/dev/null || answer=""
  fi

  [[ "$answer" == "y" || "$answer" == "Y" ]]
}

# Remove one worktree; prints git's own error and returns 1 on failure.
gwt_remove_one() {
  local worktree_path="$1"
  local err=""

  if err="$(git -C "$GWT_REPOSITORY_ROOT" worktree remove "$worktree_path" 2>&1)"; then
    return 0
  fi

  if [[ "$err" == *"modified or untracked files"* ]]; then
    if gwt_confirm_force "$worktree_path"; then
      gwt_dim "git worktree remove --force ${worktree_path}"
      if err="$(git -C "$GWT_REPOSITORY_ROOT" worktree remove --force "$worktree_path" 2>&1)"; then
        return 0
      fi
    else
      gwt_warn "Skipped (dirty worktree): $worktree_path"
      return 1
    fi
  fi

  gwt_error "Failed to remove worktree: $worktree_path"
  while IFS= read -r err_line; do
    gwt_warn "  $err_line"
  done <<< "$err"
  if [[ "$err" == *"locked"* ]]; then
    gwt_warn "  Unlock it first: git worktree unlock \"$worktree_path\""
  fi
  return 1
}

gwt_apply_delete() {
  local selected_lines="$1"
  local worktree_path=""
  local removed=0
  local failed=0

  # Remove every selected worktree line.
  local line
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue

    worktree_path="$(gwt_line_path "$line")"

    if [[ -z "$worktree_path" ]]; then
      gwt_error "Could not parse worktree path from: $line"
      failed=$((failed + 1))
      continue
    fi

    gwt_dim "git worktree remove ${worktree_path}"
    if gwt_remove_one "$worktree_path"; then
      removed=$((removed + 1))
    else
      failed=$((failed + 1))
    fi
  done <<< "$selected_lines"

  if (( removed == 0 && failed == 0 )); then
    return 0
  fi

  gwt_dim "git worktree prune"
  git -C "$GWT_REPOSITORY_ROOT" worktree prune 2>&1 || true

  if (( failed > 0 )); then
    return 1
  fi

  gwt_success "Removed $removed worktree(s) and pruned"
  return 0
}

# ── Main entry point ───────────────────────────────────────────────────

gwt_run_main() {
  gwt_reset_state
  gwt_parse_opts "$@" || return $?
  gwt_parse_prereqs

  gwt_find_repo_root || return $?

  gwt_list_worktrees

  # Only the main checkout: nothing to delete.
  if (( ${#GWT_WORKTREE_LINES[@]} <= 1 )); then
    local line
    for line in "${GWT_WORKTREE_LINES[@]}"; do
      gwt_dim "$line"
    done
    gwt_dim "No worktrees found to delete."
    return 0
  fi

  gwt_info "Select worktree(s) to delete — Tab toggles, Enter confirms (Ctrl-A adds new):"

  local selected=""
  local select_status=0
  selected="$(gwt_select_worktree)" || select_status=$?
  gwt_clear_prompt_line
  (( select_status == 0 )) || return 0

  if [[ "$selected" == "ADD" ]]; then
    gwt_apply_add
  elif [[ -n "$selected" ]]; then
    gwt_apply_delete "$selected"
  fi

  return 0
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  gwt_run_main "$@"
fi
