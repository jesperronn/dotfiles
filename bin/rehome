#!/usr/bin/env bash
# shellcheck shell=bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
REHOME_REPO_ROOT="${REHOME_REPO_ROOT:-$ROOT_DIR}"
REHOME_DEFAULT_FILE_DEST="${REHOME_DEFAULT_FILE_DEST:-}"
REHOME_DEFAULT_FOLDER_DEST="${REHOME_DEFAULT_FOLDER_DEST:-}"
REHOME_TARGET=""
REHOME_SHOW_HELP=0

rehome_usage() {
  cat <<HELP
Move an existing file or folder into a managed repo and leave a symlink behind.

Usage: $(basename "$0") [options] [path]

Options:
  -r, --repo-root PATH  Repo to write into.
  -h, --help            Show this help.

Defaults:
  Files are moved to REHOME_DEFAULT_FILE_DEST.
  Folders are moved to REHOME_DEFAULT_FOLDER_DEST.
  If those variables are unset, files go to link-file/ and folders go to link-dir/
  under the selected repo root.

Environment:
  REHOME_REPO_ROOT            Repo to write into. Defaults to the directory
                              that contains this script.
  REHOME_DEFAULT_FILE_DEST    Default destination for files.
  REHOME_DEFAULT_FOLDER_DEST  Default destination for folders.

Behavior:
  - If the target is a file, it is moved into the file destination and symlinked back.
  - If the target is a folder, it is moved into the folder destination and symlinked back.
  - Relative paths are resolved from the current working directory.
  - Existing symlinks are rejected.
HELP
}

rehome_error() {
  printf '%s\n' "$*" >&2
}

rehome_success() {
  printf '✔ %s\n' "$*"
}

rehome_resolve_target() {
  local target="$1"
  local parent=""

  parent="$(cd "$(dirname "$target")" && pwd -P)"
  printf '%s/%s\n' "$parent" "$(basename "$target")"
}

rehome_path_is_absolute() {
  [[ "$1" == /* ]]
}

rehome_abs_path() {
  local path="$1"
  local base_dir="$2"

  if rehome_path_is_absolute "$path"; then
    printf '%s\n' "$path"
  else
    printf '%s/%s\n' "$base_dir" "$path"
  fi
}

rehome_dest_root() {
  local kind="$1"
  local repo_root="$2"
  local env_value=""

  case "$kind" in
    file)
      env_value="$REHOME_DEFAULT_FILE_DEST"
      if [[ -z "$env_value" ]]; then
        env_value="link-file"
      fi
      ;;
    folder)
      env_value="$REHOME_DEFAULT_FOLDER_DEST"
      if [[ -z "$env_value" ]]; then
        env_value="link-dir"
      fi
      ;;
    *)
      rehome_error "Unknown kind: $kind"
      return 1
      ;;
  esac

  rehome_abs_path "$env_value" "$repo_root"
}

rehome_repo_rel_path() {
  local resolved_target="$1"
  local original_target="$2"
  local home_root="$3"
  local cwd_root="$4"
  local rel=""

  if [[ "$resolved_target" == "$home_root/"* ]]; then
    rel="${resolved_target#"$home_root"/}"
  elif [[ "$original_target" != /* && "$resolved_target" == "$cwd_root/"* ]]; then
    rel="${resolved_target#"$cwd_root"/}"
  else
    rel="$(basename "$resolved_target")"
  fi

  printf '%s\n' "$rel"
}

rehome_parse_opts() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        rehome_usage
        REHOME_SHOW_HELP=1
        return 0
        ;;
      -r|--repo-root)
        shift
        REHOME_REPO_ROOT="${1:-}"
        if [[ -z "$REHOME_REPO_ROOT" ]]; then
          rehome_error "Missing path after --repo-root"
          return 1
        fi
        ;;
      --repo-root=*)
        REHOME_REPO_ROOT="${1#--repo-root=}"
        if [[ -z "$REHOME_REPO_ROOT" ]]; then
          rehome_error "Missing path after --repo-root"
          return 1
        fi
        ;;
      --)
        shift
        if [[ $# -gt 0 ]]; then
          if [[ -n "$REHOME_TARGET" ]]; then
            rehome_error "Only one target is supported."
            return 1
          fi
          REHOME_TARGET="$1"
          shift
          if [[ $# -gt 0 ]]; then
            rehome_error "Only one target is supported."
            return 1
          fi
        fi
        return 0
        ;;
      -*)
        rehome_error "Unknown option: $1"
        return 1
        ;;
      *)
        if [[ -n "$REHOME_TARGET" ]]; then
          rehome_error "Only one target is supported."
          return 1
        fi
        REHOME_TARGET="$1"
        ;;
    esac
    shift
  done

  if [[ -z "$REHOME_TARGET" ]]; then
    rehome_usage
    return 1
  fi
}

rehome_run() {
  local target="$1"
  local resolved_target=""
  local repo_root=""
  local home_root=""
  local cwd_root=""
  local repo_rel=""
  local repo_dest=""
  local dest_kind=""

  if [[ ! -e "$target" ]]; then
    rehome_error "Missing path: $target"
    return 1
  fi

  if [[ -L "$target" ]]; then
    rehome_error "Target is already a symlink: $target"
    return 1
  fi

  resolved_target="$(rehome_resolve_target "$target")"
  repo_root="$(cd "$REHOME_REPO_ROOT" && pwd -P)"
  home_root="$(cd "$HOME" && pwd -P)"
  cwd_root="$(pwd -P)"

  if [[ "$resolved_target" == "$repo_root" || "$resolved_target" == "$repo_root/"* ]]; then
    rehome_error "Target must not live inside the repo root: $resolved_target"
    return 1
  fi

  if [[ -d "$resolved_target" ]]; then
    dest_kind="folder"
  else
    dest_kind="file"
  fi

  repo_dest="$(rehome_dest_root "$dest_kind" "$repo_root")"
  repo_rel="$(rehome_repo_rel_path "$resolved_target" "$target" "$home_root" "$cwd_root")"
  repo_dest="$repo_dest/$repo_rel"

  if [[ -e "$repo_dest" || -L "$repo_dest" ]]; then
    rehome_error "Destination already exists: ${repo_dest#"$repo_root"/}"
    return 1
  fi

  mkdir -p "$(dirname "$repo_dest")"
  mv "$resolved_target" "$repo_dest"
  ln -s "$repo_dest" "$resolved_target"
  rehome_success "Moved $resolved_target into ${repo_dest#"$repo_root"/} and linked it back."
}

run_main() {
  rehome_parse_opts "$@" || return $?
  if [[ "$REHOME_SHOW_HELP" == 1 ]]; then
    return 0
  fi
  rehome_run "$REHOME_TARGET"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  run_main "$@"
fi
