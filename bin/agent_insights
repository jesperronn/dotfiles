#!/usr/bin/env python3
"""agent_insights — /insights-style usage reports for local coding-agent session logs.

Usage: agent_insights <harness> [report|list|analyze|tune] [--root DIR] [--since YYYY-MM-DD] [--until YYYY-MM-DD]
                                [--project SUBSTR] [--top N] [--json] [--no-subagents]
                                [analyze: --llm CMD --format html|md --out FILE|- --open --config FILE --no-config]
                                [tune: --model SUBSTR --no-llm --no-server (plus the analyze options)]
Harnesses: see HARNESSES below. Each reads its own on-disk format; --root overrides the default location.
"""
import argparse
import importlib
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"))

from agent_insights import common  # noqa: E402

HARNESSES = ("omp", "copilot", "codex", "pi")


def open_file(path):
    import subprocess

    opener = "open" if sys.platform == "darwin" else "xdg-open"
    try:
        subprocess.run([opener, path], check=False)
    except OSError as exc:
        print(f"agent_insights: could not run {opener}: {exc}", file=sys.stderr)


def run_analyze(args, sessions) -> int:
    from agent_insights import analyze

    if not sessions:
        print(f"{args.harness}: no sessions found.", file=sys.stderr)
        return 1
    cmd = args.llm or analyze.DEFAULT_LLM
    size = max(1, args.batch_size)
    try:
        config_text, included = analyze.load_config_files(
            analyze.config_candidates(args.harness, args.config or [], not args.no_config))
    except OSError as exc:
        print(f"agent_insights: cannot read --config file: {exc}", file=sys.stderr)
        return 1
    if args.dry_run:
        print(analyze.dry_run_text(args.harness, sessions, cmd, size, args.top, config_text))
        print(f"agent_insights: dry run; {analyze.config_summary(included)}", file=sys.stderr)
        return 0
    digest_bytes = sum(len(d.encode()) + 1 for d in analyze.build_digests(sessions))
    print(f"agent_insights: sending {len(sessions)} sessions ({digest_bytes} digest bytes, no full "
          f"transcripts) to LLM command: {cmd}; {analyze.config_summary(included)}", file=sys.stderr)
    status = 0
    try:
        report = analyze.analyze(args.harness, sessions, cmd, size, args.top, config_text)
    except analyze.AnalyzeError as exc:
        print(f"agent_insights: analyze failed: {exc}; emitting raw LLM output", file=sys.stderr)
        report = analyze.raw_report(exc.raw)
        status = 1
    stats = common.summarize(sessions)
    text = analyze.render(args.format, args.harness, report, analyze.meta_line(sessions), stats)
    if args.out == "-" or (args.format == "md" and not args.out):
        sys.stdout.write(text)
        return status
    path = os.path.expanduser(args.out) if args.out else analyze.default_out_path(args.harness)
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(text)
    print(f"agent_insights: wrote {path}", file=sys.stderr)
    if args.open:
        open_file(path)
    return status


def run_tune(args, sessions) -> int:
    from agent_insights import tune

    return tune.run_tune(args, sessions, open_file)


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="agent_insights", description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="harness", required=True, metavar="HARNESS")
    for name in HARNESSES:
        p = sub.add_parser(name, help=f"usage insights for {name} sessions")
        p.add_argument("mode", nargs="?", choices=("report", "list", "analyze", "tune"), default="report")
        p.add_argument("--root", help="session directory (default: the harness's standard location)")
        p.add_argument("--since", help="only sessions started on/after YYYY-MM-DD")
        p.add_argument("--until", help="only sessions started on/before YYYY-MM-DD")
        p.add_argument("--project", help="only sessions whose working directory contains this text")
        p.add_argument("--no-subagents", action="store_true",
                       help="exclude subagent sessions (omp task children, codex spawned/guardian agents)")
        p.add_argument("--top", type=int, default=10, help="rows per ranking (default 10)")
        p.add_argument("--json", action="store_true", help="machine-readable output (with per-session rows)")
        p.add_argument("--llm", help="analyze: shell command reading the prompt on stdin, answer on stdout "
                                     "(default: 'claude -p')")
        p.add_argument("--format", choices=("md", "html"), default="html",
                       help="analyze: output format (default html; md goes to stdout unless --out is given)")
        p.add_argument("--out", help="analyze: report file (default ~/.cache/agent_insights/<harness>-<date>.html; "
                                     "'-' prints to stdout)")
        p.add_argument("--open", action="store_true", help="analyze: open the written HTML file (open/xdg-open)")
        p.add_argument("--config", action="append", metavar="FILE",
                       help="analyze: also include this config file, redacted, as read-only context in the "
                            "reduce prompt (repeatable; added to the harness's default config files)")
        p.add_argument("--no-config", action="store_true",
                       help="analyze: do not read the harness's default config/instruction files")
        p.add_argument("--dry-run", action="store_true", help="analyze: print prompts, make no LLM call")
        p.add_argument("--model", help="tune: only models whose normalized name contains this text "
                                       "(default: every model with at least 3 sessions)")
        p.add_argument("--no-llm", action="store_true", help="tune: print the local metrics and server evidence, "
                                                              "no LLM call")
        p.add_argument("--no-server", action="store_true", help="tune: skip reading local model-server files")
        p.add_argument("--batch-size", type=int, default=40, help="analyze: sessions per map call (default 40)")
    args = parser.parse_args(argv)

    module = importlib.import_module(f"agent_insights.{args.harness}")
    root = os.path.expanduser(args.root or module.DEFAULT_ROOT)
    if not os.path.isdir(root):
        print(f"agent_insights: {args.harness}: no such directory: {root}", file=sys.stderr)
        return 1
    sessions = common.filter_sessions(module.load_sessions(root), args.since, args.until, args.project)
    excluded = 0
    if args.no_subagents:
        kept = [s for s in sessions if not s["extra"].get("subagent")]
        excluded, sessions = len(sessions) - len(kept), kept
    if args.mode == "analyze":
        return run_analyze(args, sessions)
    if args.mode == "tune":
        return run_tune(args, sessions)
    if args.json:
        print(common.render_json(args.harness, sessions, with_sessions=True))
    elif args.mode == "list":
        print(common.render_list(sessions, limit=args.top * 3))
    else:
        print(common.render_report(args.harness, sessions, top=args.top,
                                   excluded_subagents=excluded if args.no_subagents else None))
    return 0


if __name__ == "__main__":
    sys.exit(main())
