#!/usr/bin/env bash
# shellcheck shell=bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
REHOME_REPO_ROOT="${REHOME_REPO_ROOT:-$ROOT_DIR}"

SHOW_ALL=0
INTERACTIVE=0
SCAN_DIR="${HOME}"

# System/junk items that are never worth rehoming (skipped unless --all)
SKIP_ITEMS=(
  .DS_Store
  .Trash
  .localized
  .CFUserTextEncoding
  .bash_sessions
  .zsh_sessions
  .bash_history
  .zsh_history
  .lesshst
  .node_repl_history
  .python_history
)

# Colors (only when stdout is a terminal)
if [[ -t 1 ]]; then
  C_GREEN='\033[0;32m'
  C_YELLOW='\033[0;33m'
  C_CYAN='\033[0;36m'
  C_DIM='\033[2m'
  C_RESET='\033[0m'
else
  C_GREEN='' C_YELLOW='' C_CYAN='' C_DIM='' C_RESET=''
fi

usage() {
  cat <<HELP
Scan \$HOME for dotfiles that are candidates for rehome management.

Usage: $(basename "$0") [options]

Options:
  -a, --all           Include system/junk items normally skipped
  -i, --interactive   Pick candidates via fzf and rehome selected items
  -d, --dir PATH      Scan this directory instead of \$HOME
  -r, --repo-root PATH  Repo root (default: directory containing this script)
  -h, --help          Show this help

Symbols:
  ✓  Managed   — symlink pointing into this repo
  ?  Candidate — real file/dir, not yet managed
  →  Other     — symlink pointing elsewhere
  -  Skipped   — system/junk item (use --all to see)
HELP
}

is_skipped() {
  local name="$1"
  [[ "$SHOW_ALL" == 1 ]] && return 1
  local skip
  for skip in "${SKIP_ITEMS[@]}"; do
    [[ "$name" == "$skip" ]] && return 0
  done
  return 1
}

format_size() {
  local path="$1"
  if [[ -d "$path" ]]; then
    local count
    count="$(find "$path" -maxdepth 1 -mindepth 1 2>/dev/null | wc -l | tr -d ' ')"
    printf '%s items' "$count"
  elif [[ ! -r "$path" ]]; then
    printf 'no read permission'
  else
    local bytes
    bytes="$(wc -c < "$path" 2>/dev/null || printf '0')"
    if (( bytes >= 1048576 )); then
      printf '%dM' $(( bytes / 1048576 ))
    elif (( bytes >= 1024 )); then
      printf '%dK' $(( bytes / 1024 ))
    else
      printf '%dB' "$bytes"
    fi
  fi
}

format_symlink_target() {
  local target="$1"
  local repo_root="$2"
  local home_root="$3"
  local resolved
  resolved="$(readlink "$target")"

  # Show path relative to repo root if inside it
  if [[ "$resolved" == "$repo_root/"* ]]; then
    printf '%s' "${resolved#"$repo_root"/}"
  elif [[ "$resolved" == "$home_root/"* ]]; then
    printf '~/%s' "${resolved#"$home_root"/}"
  else
    printf '%s' "$resolved"
  fi
}

parse_opts() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)    usage; exit 0 ;;
      -a|--all)     SHOW_ALL=1 ;;
      -i|--interactive) INTERACTIVE=1 ;;
      -d|--dir)
        shift
        SCAN_DIR="${1:-}"
        [[ -z "$SCAN_DIR" ]] && { printf 'Missing path after --dir\n' >&2; exit 1; }
        ;;
      -r|--repo-root)
        shift
        REHOME_REPO_ROOT="${1:-}"
        [[ -z "$REHOME_REPO_ROOT" ]] && { printf 'Missing path after --repo-root\n' >&2; exit 1; }
        ;;
      *) printf 'Unknown option: %s\n' "$1" >&2; usage; exit 1 ;;
    esac
    shift
  done
}

run_main() {
  parse_opts "$@"

  local repo_root home_root
  repo_root="$(cd "$REHOME_REPO_ROOT" && pwd -P)"
  home_root="$(cd "$HOME" && pwd -P)"
  local scan_dir
  scan_dir="$(cd "$SCAN_DIR" && pwd -P)"

  local managed=() candidates=() others=() skipped=()

  # Also collect copy/ items so they show as managed (not candidates)
  local copy_dir="$repo_root/copy"
  local copy_managed=()
  if [[ -d "$copy_dir" ]]; then
    while IFS= read -r -d '' f; do
      copy_managed+=("$(basename "$f")")
    done < <(find "$copy_dir" -maxdepth 1 -mindepth 1 -print0 2>/dev/null)
  fi

  is_copy_managed() {
    local name="$1"
    local n
    for n in "${copy_managed[@]+"${copy_managed[@]}"}"; do
      [[ "$n" == "$name" ]] && return 0
    done
    return 1
  }

  while IFS= read -r -d '' item; do
    local name
    name="$(basename "$item")"

    # Skip special files (sockets, devices, pipes) — not rehomeable
    if [[ ! -L "$item" && ! -f "$item" && ! -d "$item" ]]; then
      skipped+=("$item")
      continue
    fi

    if [[ -L "$item" ]]; then
      local target
      target="$(readlink "$item")"
      # Resolve relative symlinks
      if [[ "$target" != /* ]]; then
        target="$(cd "$(dirname "$item")" && cd "$(dirname "$target")" && pwd -P)/$(basename "$target")"
      fi
      if [[ "$target" == "$repo_root/"* ]]; then
        managed+=("$item")
      else
        others+=("$item")
      fi
    elif is_copy_managed "$name"; then
      managed+=("$item")
    elif is_skipped "$name"; then
      skipped+=("$item")
    else
      candidates+=("$item")
    fi
  done < <(find "$scan_dir" -maxdepth 1 -mindepth 1 -name '.*' -print0 | sort -z)

  # Print summary header
  local n_managed=${#managed[@]} n_cand=${#candidates[@]} n_other=${#others[@]}
  printf '\n'
  printf "Dotfile scan: %s\n" "$(
    [[ "$scan_dir" == "$home_root" ]] && printf '~/' || printf '%s' "$scan_dir"
  )"
  printf '%s managed  %s candidates  %s other\n\n' \
    "$n_managed" "$n_cand" "$n_other"

  if [[ ${#managed[@]} -gt 0 ]]; then
    printf "${C_GREEN}MANAGED (already in repo):${C_RESET}\n"
    for item in "${managed[@]}"; do
      local name label
      name="$(basename "$item")"
      if [[ -L "$item" ]]; then
        label="→ $(format_symlink_target "$item" "$repo_root" "$home_root")"
      elif is_copy_managed "$name"; then
        label="copy/${name}"
      else
        label="(unknown)"
      fi
      printf "  ${C_GREEN}✓${C_RESET}  %-30s  %s\n" "$name" "$label"
    done
    printf '\n'
  fi

  if [[ ${#candidates[@]} -gt 0 ]]; then
    printf "${C_YELLOW}CANDIDATES (not yet managed):${C_RESET}\n"
    for item in "${candidates[@]}"; do
      local kind size
      [[ -d "$item" ]] && kind="dir" || kind="file"
      size="$(format_size "$item")"
      printf "  ${C_YELLOW}?${C_RESET}  %-30s [%s, %s]\n" "$(basename "$item")" "$kind" "$size"
    done
    printf '\n'
  fi

  if [[ ${#others[@]} -gt 0 ]]; then
    printf "${C_CYAN}OTHER SYMLINKS (not repo-managed):${C_RESET}\n"
    for item in "${others[@]}"; do
      local label
      label="$(format_symlink_target "$item" "$repo_root" "$home_root")"
      printf "  ${C_CYAN}→${C_RESET}  %-30s → %s\n" "$(basename "$item")" "$label"
    done
    printf '\n'
  fi

  if [[ "$SHOW_ALL" == 1 && ${#skipped[@]} -gt 0 ]]; then
    printf "${C_DIM}SKIPPED:${C_RESET}\n"
    for item in "${skipped[@]}"; do
      printf "  ${C_DIM}-  %s${C_RESET}\n" "$(basename "$item")"
    done
    printf '\n'
  fi

  if [[ ${#candidates[@]} -eq 0 ]]; then
    if [[ "$INTERACTIVE" == 1 ]]; then
      printf 'No candidates to rehome.\n'
    fi
    return 0
  fi

  if [[ "$INTERACTIVE" == 1 ]]; then
    if ! command -v fzf &>/dev/null; then
      printf 'Error: --interactive requires fzf (not found in PATH)\n' >&2
      return 1
    fi

    # Build fzf input: one line per candidate
    local fzf_input=()
    for item in "${candidates[@]}"; do
      local kind size
      [[ -d "$item" ]] && kind="dir" || kind="file"
      size="$(format_size "$item")"
      fzf_input+=("$(basename "$item")  [${kind}, ${size}]  ${item}")
    done

    local selected
    selected="$(printf '%s\n' "${fzf_input[@]}" \
      | fzf --multi \
            --prompt='Select candidates to rehome (TAB=multi-select, ENTER=confirm): ' \
            --with-nth=1,2 \
            --delimiter='  ' \
      || true)"

    if [[ -z "$selected" ]]; then
      printf 'No items selected.\n'
      return 0
    fi

    local rehome_bin
    rehome_bin="$(dirname "${BASH_SOURCE[0]}")/rehome"

    while IFS= read -r line; do
      # Extract the full path (3rd field)
      local full_path
      full_path="$(printf '%s' "$line" | awk -F'  ' '{print $NF}')"
      printf '\nRehoming: %s\n' "$full_path"
      REHOME_REPO_ROOT="$repo_root" "$rehome_bin" "$full_path"
    done <<< "$selected"
  fi
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  run_main "$@"
fi
