#!/usr/bin/env python3
"""Regenerate link-dir/.agents/skills/README.md from SKILL.md frontmatter.

Each skill's SKILL.md must have:
  group:   one of the GROUP_ORDER keys below
  summary: one-line description for the table

Run manually: bin/gen_skills_readme
Or via the pre-commit hook (bin/git-hooks/pre-commit).
Exits 1 and prints paste-ready AI prompts for any skills missing required fields.
"""

import datetime
import os
import re
import sys

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
REPO_ROOT   = os.path.dirname(SCRIPT_DIR)
SKILLS_DIR  = os.path.join(REPO_ROOT, "link-dir", ".agents", "skills")
README_PATH = os.path.join(SKILLS_DIR, "README.md")

REQUIRED = ("group", "summary")

GROUP_ORDER = [
    ("spec-build",     "Spec / Build Loop"),
    ("shell-bash",     "Shell / Bash"),
    ("wiki-obsidian",  "Wiki / Obsidian"),
    ("memory-session", "Memory / Session"),
    ("writing-format", "Writing / Format"),
    ("skills-meta",    "Skills Meta"),
    ("domain",         "Domain-Specific"),
]
VALID_GROUPS = " | ".join(k for k, _ in GROUP_ORDER)


def parse_frontmatter(path):
    """Extract scalar and multiline key:value pairs from the first YAML block."""
    with open(path, encoding="utf-8") as f:
        content = f.read()
    if not content.startswith("---"):
        return {}
    try:
        end = content.index("---", 3)
    except ValueError:
        return {}

    fm = {}
    lines = content[3:end].splitlines()
    i = 0
    while i < len(lines):
        m = re.match(r'^(\w[\w-]*):\s*(.*)', lines[i])
        if not m:
            i += 1
            continue
        key, val = m.group(1), m.group(2).strip()
        if val in ('|', '>', '>-', '|-', '>+', '|+'):
            # Collect indented continuation lines
            parts = []
            i += 1
            while i < len(lines) and (lines[i].startswith(' ') or lines[i].startswith('\t')):
                parts.append(lines[i].strip())
                i += 1
            fm[key] = ' '.join(parts)
        else:
            if (val.startswith('"') and val.endswith('"')) or \
               (val.startswith("'") and val.endswith("'")):
                val = val[1:-1]
            if val:
                fm[key] = val
            i += 1
    return fm


def load_skills():
    skills = []
    for entry in sorted(os.scandir(SKILLS_DIR), key=lambda e: e.name):
        if not entry.is_dir() or entry.name.startswith("."):
            continue
        skill_file = os.path.join(entry.path, "SKILL.md")
        if not os.path.exists(skill_file):
            continue
        fm = parse_frontmatter(skill_file)
        missing = [f for f in REQUIRED if not fm.get(f)]
        skills.append({
            "name":        fm.get("name") or entry.name,
            "group":       fm.get("group", "unknown"),
            "summary":     fm.get("summary", "—"),
            "description": fm.get("description", ""),
            "path":        os.path.relpath(skill_file, REPO_ROOT),
            "missing":     missing,
        })
    return skills


def render(skills):
    grouped = {}
    for s in skills:
        grouped.setdefault(s["group"], []).append(s)

    lines = [
        "# Skills Index",
        "",
        f"{len(skills)} skills — grouped by domain.",
        "",
        "> **To update:** edit `group` and `summary` in the skill's `SKILL.md` frontmatter.",
        "> The pre-commit hook regenerates this file automatically on commit.",
        "> To regenerate manually: `bin/gen_skills_readme`",
        "",
        "---",
        "",
    ]

    for key, label in GROUP_ORDER:
        entries = grouped.get(key)
        if not entries:
            continue
        lines += [
            f"## {label}",
            "",
            "| Skill | Does |",
            "|-------|------|",
        ]
        for s in sorted(entries, key=lambda x: x["name"]):
            lines.append(f"| **{s['name']}** | {s['summary']} |")
        lines += ["", "---", ""]

    unknowns = grouped.get("unknown", [])
    if unknowns:
        lines += [
            "## Uncategorized",
            "",
            "| Skill | Does |",
            "|-------|------|",
        ]
        for s in sorted(unknowns, key=lambda x: x["name"]):
            lines.append(f"| **{s['name']}** | {s['summary']} |")
        lines += ["", "---", ""]

    today = datetime.date.today().isoformat()
    lines.append(f"*Last updated: {today} · {len(skills)} skills*")
    lines.append("")

    return "\n".join(lines)


def next_step_prompt(skill):
    """Return a paste-ready AI prompt for a skill missing required fields."""
    missing = ", ".join(skill["missing"])
    desc = skill["description"]
    if len(desc) > 120:
        desc = desc[:117] + "..."
    sep = "─" * 64
    lines = [
        f"── {skill['name']} (missing: {missing}) ──",
        "Paste into your AI:",
        "",
        f"  Skill `{skill['name']}` in `{skill['path']}`",
        f"  is missing frontmatter fields: {missing}.",
    ]
    if desc:
        lines.append(f"  Description: \"{desc}\"")
    lines += [
        "",
        "  Add after `name: " + skill["name"] + "`:",
    ]
    if "group" in skill["missing"]:
        lines.append(f"    group: <one of: {VALID_GROUPS}>")
    if "summary" in skill["missing"]:
        lines.append( "    summary: \"One-line: what it does + key behaviour.\"")
    lines += [
        "",
        "  Then run: bin/gen-skills-readme",
        sep,
    ]
    return "\n".join(lines)


def main():
    skills = load_skills()
    if not skills:
        print(f"No SKILL.md files found in {SKILLS_DIR}", file=sys.stderr)
        sys.exit(1)

    readme = render(skills)
    with open(README_PATH, "w", encoding="utf-8") as f:
        f.write(readme)
    print(f"Wrote {os.path.relpath(README_PATH)} ({len(skills)} skills)")

    broken = [s for s in skills if s["missing"]]
    if broken:
        n = len(broken)
        print(f"\n⚠  {n} skill{'s' if n > 1 else ''} missing required frontmatter:\n")
        for s in broken:
            print(next_step_prompt(s))
        sys.exit(1)


if __name__ == "__main__":
    main()
