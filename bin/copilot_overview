#!/usr/bin/env python3
"""copilot_overview — one HTML overview of a folder of copied Copilot sessions, to pick a talk shortlist.

Usage: copilot_overview <sessions-dir> [--out DIR] [--max-result N] [--open]
<sessions-dir> holds <session-id>/{workspace.yaml,events.jsonl} (e.g. made by copilot_shortlist --copy).
Writes DIR/index.html (generic page), DIR/sessions.json (+ sessions.js, the same list for file:// use),
and DIR/s/<id8>.html (one transcript per session, via copilot_show).
Favourites, role, tags and notes live in the browser's localStorage; use the export button to keep them.
Default DIR: <sessions-dir>/../overview
"""
import argparse
import importlib.machinery
import importlib.util
import json
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))


def load_script(name):
    """Import a sibling extension-less script as a module."""
    path = os.path.join(HERE, name)
    loader = importlib.machinery.SourceFileLoader(name, path)
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def session_row(s, link, project_name):
    return {
        "id": s["id"], "id8": s["id"][:8], "date": s["started"][:10], "project": project_name(s["project"]),
        "client": s["client"], "userTurns": s["user_turns"], "turns": s["turns"], "minutes": round(s["duration_min"]),
        "tokens": s["tokens_total"], "toolCalls": s["tool_calls"], "toolErrors": s["tool_errors"],
        "added": s["lines_added"], "removed": s["lines_removed"], "bad": s["bad"], "good": s["good"],
        "outlier": s["outlier"], "labels": s["labels"], "prompt": s["first_prompt"], "link": link,
    }


PAGE = r"""<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Copilot sessions overview</title><style>
:root{--bg:#fff;--fg:#1f2328;--mut:#656d76;--line:#d0d7de;--card:#f6f8fa;--acc:#0969da;--star:#bf8700;--bad:#cf222e;--good:#1a7f37;--out:#8250df}
@media(prefers-color-scheme:dark){:root{--bg:#0d1117;--fg:#e6edf3;--mut:#8d96a0;--line:#30363d;--card:#161b22;--acc:#58a6ff;--star:#e3b341;--bad:#ff7b72;--good:#3fb950;--out:#d2a8ff}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:14px/1.45 -apple-system,system-ui,sans-serif}
header{position:sticky;top:0;background:var(--bg);border-bottom:1px solid var(--line);padding:8px 12px;z-index:5}
h1{font-size:16px;margin:0 0 6px}.bar{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-top:6px}
.dim{color:var(--mut);font-size:12px}.bar input[type=search]{padding:4px 8px;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--fg);min-width:200px}
button{padding:3px 10px;border:1px solid var(--line);border-radius:14px;background:var(--card);color:var(--fg);cursor:pointer;font:inherit;font-size:12px}
button.on{background:color-mix(in srgb,var(--acc) 16%,var(--bg));border-color:var(--acc);box-shadow:0 0 0 1px var(--acc)}.count{color:var(--mut);margin-left:auto;font-size:12px}
#filters{max-height:32vh;overflow:auto;border-top:1px dashed var(--line);padding-top:6px}#filters[hidden],#legend[hidden]{display:none}
#legend{font-size:12px;color:var(--mut);margin-top:6px;line-height:1.6}#legend b{color:var(--fg)}
main{padding:0 8px 40px;overflow-x:auto}table{border-collapse:collapse;width:100%;font-size:13px;min-width:860px}
tbody.item{border-bottom:1px solid var(--line);cursor:pointer}tbody.item:hover td{background:var(--card)}tbody.fav td{background:color-mix(in srgb,var(--star) 12%,transparent)}
td{padding:2px 6px;white-space:nowrap;vertical-align:middle}tr.l1 td{padding-top:5px}tr.l2 td{padding-bottom:5px}
td.p{max-width:0;width:100%;min-width:180px;overflow:hidden;text-overflow:ellipsis;font-weight:600}td.p a{color:var(--acc);text-decoration:none}td.p a:hover{text-decoration:underline}
td.n{width:1%;text-align:right}.k{color:var(--mut);font-size:11px;margin-right:2px}td.n b{font-variant-numeric:tabular-nums;font-weight:600}
.pill{display:inline-block;padding:0 7px;border-radius:10px}
.bad .pill{color:var(--bad);background:color-mix(in srgb,var(--bad) 16%,transparent)}.good .pill{color:var(--good);background:color-mix(in srgb,var(--good) 16%,transparent)}.out .pill{color:var(--out);background:color-mix(in srgb,var(--out) 16%,transparent)}
.star{font-size:17px;line-height:1;background:none;border:0;padding:0 2px;color:var(--mut)}.fav .star{color:var(--star)}
.chip{font-size:11px;padding:0 7px;border-radius:5px;border:1px solid var(--line);background:var(--bg);color:var(--mut);margin-right:3px;display:inline-block;cursor:pointer}
.chip.tag{color:var(--acc)}
.chip.hl{background:color-mix(in srgb,var(--acc) 10%,var(--bg));border-color:color-mix(in srgb,var(--acc) 55%,var(--line));color:var(--fg)}
