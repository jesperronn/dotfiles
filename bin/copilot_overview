.role{font-size:11px;padding:0 7px;border-radius:4px;color:#fff;margin-right:4px}.role.bad{background:var(--bad)}.role.good{background:var(--good)}.role.outlier{background:var(--out)}
.note{color:var(--mut);font-size:12px;font-style:italic}.sub{padding-left:10px;white-space:normal;max-width:0}
