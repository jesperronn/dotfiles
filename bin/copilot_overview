.edit input,.edit textarea{padding:4px 8px;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--fg);font:inherit}
.edit textarea{flex:1;min-width:240px;height:60px;resize:vertical}.edit input{width:220px}
dialog{max-width:700px;width:90%;background:var(--bg);color:var(--fg);border:1px solid var(--line);border-radius:8px}dialog textarea{width:100%;height:300px;font:12px ui-monospace,monospace}
</style></head><body>
<header><h1>Copilot sessions overview</h1>
<div class="bar"><button id="fall" class="on">All</button><button id="ffav">Favourites</button>
<input type="search" id="q" placeholder="search prompt, project, labels, notes, tags"><button id="exp">Export…</button><button id="help" title="what do the numbers mean?">?</button></div>
<div class="bar" id="sorts"><span class="dim">sort</span></div>
<div class="bar"><button id="ftoggle">Filters ▾</button><span class="dim" id="fsum"></span><button id="fclear" hidden>clear</button><span class="count" id="count"></span></div>
<div id="filters" hidden><div class="bar"><span class="dim">project</span><span id="fproj"></span></div><div class="bar"><span class="dim">label</span><span id="flab"></span></div></div>
<div id="legend" hidden></div></header>
<main id="list"></main>
<dialog id="dlg"><p><b>Favourites and notes</b> — copy this somewhere safe; localStorage is per browser.</p><textarea id="out" readonly></textarea>
<p><button id="cmd">Markdown</button> <button id="cjson">JSON</button> <button id="imp">Import JSON</button> <button id="cls">Close</button></p></dialog>
<script src="sessions.js"></script>
<script>
const SESSIONS=window.SESSIONS||[];
const KEY='copilot_overview_v1';
let state={};
try{state=JSON.parse(localStorage.getItem(KEY)||'{}')}catch(e){}
function save(){try{localStorage.setItem(KEY,JSON.stringify(state))}catch(e){}}
function st(id){return state[id]||(state[id]={fav:false,role:'',tags:'',note:''})}
const $=id=>document.getElementById(id);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const tok=n=>n>=1e6?(n/1e6).toFixed(1)+'M':n>=1e3?Math.round(n/1e3)+'k':String(n);
const METRICS=[
 {k:'date',get:s=>s.date,tip:'Date the session started.'},
 {k:'msgs',get:s=>s.userTurns,tip:'Messages you typed in this session. Many messages usually means a lot of steering.'},
 {k:'tokens',get:s=>s.tokens,tip:'Tokens the model read (uncached) plus wrote. Cached re-reads are not counted.'},
 {k:'err',get:s=>s.toolErrors,tip:'Failed tool calls / all tool calls (file not found, command failed, ...).'},
 {k:'bad',get:s=>s.bad,tip:'Struggle score: tool errors, loops, corrections, repeated instructions, aborts. Higher = worse.'},
 {k:'good',get:s=>s.good,tip:'Smooth-run score: finished with real code changes, few messages, few errors. Higher = better.'},
 {k:'out',get:s=>s.outlier,tip:'Outlier score: unusually many tokens, minutes, turns, tool calls, or a huge diff, compared with this folder.'}];
const LABEL_HELP={'repeated-instruction':'You restated an earlier message (60%+ same words): the first instruction was not acted on.',
 'user-corrections':'Follow-ups that read as a correction: no, don\'t, I said, again, stop, nej, igen ...','tool-loop':'The same tool call with identical arguments ran 4+ times.',
 'error-rate':'20%+ of tool calls failed.','aborted':'You interrupted the agent (count shown).','no-shutdown':'Session never ended cleanly (crash or left open); token totals are estimates.',
 'abandoned':'Ended on your message or an abort, with no code written.','compacted':'The context window was compacted (count shown): a very long session.',
 'permission-prompts':'Number of permission requests: approval friction.','session-errors':'Copilot reported session-level errors.',
 'burn-no-edits':'Top 5% token use but no lines changed.','clean-run':'Finished with real changes, few prompts and almost no errors.',
 'outlier-tokens':'Top 5% of this folder for tokens.','outlier-duration':'Top 5% of this folder for active minutes.','outlier-turns':'Top 5% of this folder for assistant turns.',
 'outlier-tool-calls':'Top 5% of this folder for tool calls.','outlier-premium':'Top 5% of this folder for premium requests.','subagents':'Spawned 3+ subagents.','big-diff':'2000+ lines added.'};
const base=l=>l.replace(/\s.*$/,'');
const chip=l=>`<span data-hl="l:${esc(base(l))}" data-l="${esc(base(l))}" class="chip${fLab.has(base(l))?' on':''}" title="${esc((LABEL_HELP[base(l)]||l)+' (click to filter by this label)')}">${esc(l)}</span>`;
const toggle=(set,v)=>set.has(v)?set.delete(v):set.add(v);
let onlyFav=false,sortKey='bad',sortDir=-1;const fProj=new Set(),fLab=new Set(),open=new Set();
function visible(){
  const q=$('q').value.toLowerCase(),m=METRICS.find(x=>x.k===sortKey).get;
  const rows=SESSIONS.filter(s=>{const x=st(s.id);
    if(onlyFav&&!x.fav)return false;
    if(fProj.size&&!fProj.has(s.project))return false;
    if(fLab.size&&!s.labels.some(l=>fLab.has(base(l))))return false;
    return !q||(s.prompt+' '+s.project+' '+s.labels.join(' ')+' '+x.note+' '+x.tags).toLowerCase().includes(q)});
  return rows.sort((a,b)=>{const A=m(a),B=m(b);return A<B?-sortDir:A>B?sortDir:(a.id<b.id?-1:1)});
}
function pills(){
  $('sorts').innerHTML='<span class="dim">sort</span>'+METRICS.map(m=>`<button data-k="${m.k}" class="${m.k===sortKey?'on':''}" title="${esc(m.tip)} Click to sort; double-click to reverse.">${m.k}${m.k===sortKey?(sortDir<0?' ↓':' ↑'):''}</button>`).join('');
  const cnt=(f)=>{const c={};SESSIONS.forEach(s=>f(s).forEach(v=>c[v]=(c[v]||0)+1));return Object.entries(c).sort((a,b)=>b[1]-a[1])};
  $('fproj').innerHTML=cnt(s=>[s.project]).map(([p,n])=>`<button data-p="${esc(p)}" class="${fProj.has(p)?'on':''}">${esc(p)} ${n}</button>`).join(' ');
  $('flab').innerHTML=cnt(s=>[...new Set(s.labels.map(base))]).map(([l,n])=>`<button data-l="${esc(l)}" class="${fLab.has(l)?'on':''}" title="${esc(LABEL_HELP[l]||l)}">${esc(l)} ${n}</button>`).join(' ');
  const n=fProj.size+fLab.size;$('fclear').hidden=!n;$('fsum').textContent=n?n+' filter'+(n>1?'s':'')+' active':'';
}
function render(){
  pills();
  const rows=visible(),favs=SESSIONS.filter(s=>st(s.id).fav).length;
  $('count').textContent=rows.length+' shown · '+favs+' ★ of '+SESSIONS.length;
  const kv=(k,v,cls,tip)=>`<td class="n ${cls}" title="${esc(tip)}"><span class="k">${k}</span> ${cls?`<span class="pill"><b>${v}</b></span>`:`<b>${v}</b>`}</td>`;
  const tip=k=>METRICS.find(m=>m.k===k).tip;
  $('list').innerHTML='<table>'+rows.map(s=>{const x=st(s.id),isOpen=open.has(s.id);
    const tags=x.tags.split(',').map(t=>t.trim()).filter(Boolean).map(t=>`<span class="chip tag" data-hl="t:${esc(t)}">#${esc(t)}</span>`).join('');
    let h=`<tbody class="item${x.fav?' fav':''}" data-id="${s.id}"><tr class="l1"><td rowspan="2" style="vertical-align:top;padding-top:4px"><button class="star" title="favourite">${x.fav?'★':'☆'}</button></td>
      <td title="${tip('date')}"><span class="dim">${s.date.slice(5)}</span></td><td><span class="dim">${esc(s.project)}</span></td>
      <td class="p"><a href="${esc(s.link)}" target="_blank">${esc(s.prompt||'(no prompt)')}</a></td>
      ${kv('msgs',s.userTurns,'',tip('msgs'))}${kv('tokens',tok(s.tokens),'',tip('tokens'))}${kv('err',s.toolErrors+'/'+s.toolCalls,'',tip('err'))}
      ${kv('bad',s.bad,'bad',tip('bad'))}${kv('good',s.good,'good',tip('good'))}${kv('out',s.outlier,'out',tip('out'))}</tr>
      <tr class="l2"><td colspan="9" class="sub">${x.role?`<span class="role ${x.role}">${x.role}</span>`:''}${s.labels.map(chip).join('')}${tags}${x.note?` <span class="note">📝 ${esc(x.note.slice(0,120))}</span>`:''}</td></tr>`;
    if(isOpen)h+=`<tr class="edit"><td></td><td colspan="9"><div class="dim">${esc(s.client)} · ${s.id8} · ${s.turns} turns · ${s.minutes}m active · +${s.added}/−${s.removed} lines</div>
      <div class="row"><span class="dim">role</span>${['bad','good','outlier',''].map(r=>`<button data-role="${r}" class="${x.role===r?'on':''}">${r||'none'}</button>`).join('')}
      <input class="tags" placeholder="tags, comma separated" value="${esc(x.tags)}"></div>
      <div class="row"><textarea class="notebox" placeholder="note: why this one?">${esc(x.note)}</textarea></div></td></tr>`;
    return h+'</tbody>'}).join('')+'</table>';
}
$('list').addEventListener('click',e=>{
  if(e.target.closest('a'))return;
  const lc=e.target.closest('.chip[data-l]');if(lc){toggle(fLab,lc.dataset.l);render();return}
  const tb=e.target.closest('tbody.item');if(!tb)return;const id=tb.dataset.id;
  if(e.target.closest('.edit')){const r=e.target.closest('[data-role]');if(r){st(id).role=r.dataset.role;save();render()}return}
  if(e.target.classList.contains('star'))st(id).fav=!st(id).fav;else open.has(id)?open.delete(id):open.add(id);
  save();render()});
$('list').addEventListener('change',e=>{const tb=e.target.closest('tbody.item');if(!tb)return;const id=tb.dataset.id;
  if(e.target.classList.contains('tags'))st(id).tags=e.target.value;else if(e.target.classList.contains('notebox'))st(id).note=e.target.value;
  save();render()});
$('sorts').addEventListener('click',e=>{const k=e.target.dataset.k;if(!k||k===sortKey)return;sortKey=k;sortDir=-1;render()});
$('sorts').addEventListener('dblclick',e=>{if(e.target.dataset.k){sortKey=e.target.dataset.k;sortDir=-sortDir;render()}});
$('fproj').addEventListener('click',e=>{if(e.target.dataset.p){toggle(fProj,e.target.dataset.p);render()}});
$('flab').addEventListener('click',e=>{if(e.target.dataset.l){toggle(fLab,e.target.dataset.l);render()}});
const hl=(key,on)=>document.querySelectorAll('.chip[data-hl]').forEach(c=>{if(c.dataset.hl===key)c.classList.toggle('hl',on)});
$('list').addEventListener('mouseover',e=>{const c=e.target.closest('.chip[data-hl]');if(c)hl(c.dataset.hl,true)});
$('list').addEventListener('mouseout',e=>{const c=e.target.closest('.chip[data-hl]');if(c)hl(c.dataset.hl,false)});
$('fclear').onclick=()=>{fProj.clear();fLab.clear();render()};
$('ftoggle').onclick=()=>{const f=$('filters');f.hidden=!f.hidden;$('ftoggle').textContent=f.hidden?'Filters ▾':'Filters ▴'};
$('help').onclick=()=>{const l=$('legend');l.hidden=!l.hidden;
  l.innerHTML=METRICS.map(m=>`<div><b>${m.k}</b> — ${esc(m.tip)}</div>`).join('')+'<div class="dim">Hover any label chip for its meaning. Sort: click a pill; double-click reverses.</div>'};
$('fall').onclick=()=>{onlyFav=false;$('fall').classList.add('on');$('ffav').classList.remove('on');render()};
$('ffav').onclick=()=>{onlyFav=true;$('ffav').classList.add('on');$('fall').classList.remove('on');render()};
$('q').addEventListener('input',render);
function exportMd(){return SESSIONS.filter(s=>st(s.id).fav).map(s=>{const x=st(s.id);
  return `- [${x.role||'?'}] ${s.id8} ${s.project} ${s.date} — ${s.prompt}\n  labels: ${s.labels.join(', ')}${x.tags?'\n  tags: '+x.tags:''}${x.note?'\n  note: '+x.note:''}`}).join('\n')}
$('exp').onclick=()=>{$('out').value=exportMd();$('dlg').showModal()};
$('cmd').onclick=()=>{$('out').value=exportMd()};
$('cjson').onclick=()=>{$('out').value=JSON.stringify(state,null,1);$('out').readOnly=false};
$('imp').onclick=()=>{try{state=Object.assign(state,JSON.parse($('out').value));save();render();$('dlg').close()}catch(e){alert('Not valid JSON')}};
$('cls').onclick=()=>$('dlg').close();
render();
</script></body></html>"""


def main(argv=None):
    p = argparse.ArgumentParser(prog="copilot_overview", description=__doc__.split("\n\n")[0])
    p.add_argument("sessions", help="folder of copied session directories")
    p.add_argument("--out", help="output directory (default: <sessions>/../overview)")
    p.add_argument("--max-result", type=int, default=1500)
    p.add_argument("--open", action="store_true")
    args = p.parse_args(argv)
    root = os.path.abspath(os.path.expanduser(args.sessions))
    if not os.path.isdir(root):
        print(f"copilot_overview: no such directory: {root}", file=sys.stderr)
        return 1
    out = os.path.abspath(os.path.expanduser(args.out)) if args.out else os.path.join(os.path.dirname(root), "overview")
    short, show = load_script("copilot_shortlist"), load_script("copilot_show")
    sessions = []
    for sid in sorted(os.listdir(root)):
        path = os.path.join(root, sid)
        if os.path.isdir(path):
            s = short.analyze_session(path, sid)
            if s:
                sessions.append(s)
    if not sessions:
        print("copilot_overview: no sessions with events.jsonl found.", file=sys.stderr)
        return 1
    short.score(sessions)  # outlier cut-offs are relative to this folder, not your whole history
    os.makedirs(os.path.join(out, "s"), exist_ok=True)
    rows = []
    for s in sessions:
        meta = show.read_meta(s["path"])
        page = show.render(meta, show.build_items(show.load_events(os.path.join(s["path"], "events.jsonl"))),
                           max(0, args.max_result), True)
        rel = f"s/{s['id'][:8]}.html"
        with open(os.path.join(out, rel), "w", encoding="utf-8") as fh:
            fh.write(page)
        row = session_row(s, rel, short.project_name)
        row["prompt"] = show.redact(row["prompt"])
        rows.append(row)
    data = json.dumps(rows, ensure_ascii=False)
    with open(os.path.join(out, "sessions.json"), "w", encoding="utf-8") as fh:
        fh.write(data)
    with open(os.path.join(out, "sessions.js"), "w", encoding="utf-8") as fh:  # file:// pages cannot fetch() JSON
        fh.write("window.SESSIONS=" + data.replace("</", "<\\/") + ";\n")
    index = os.path.join(out, "index.html")
    with open(index, "w", encoding="utf-8") as fh:
        fh.write(PAGE)
    print(index)
    if args.open:
        subprocess.run(["open" if sys.platform == "darwin" else "xdg-open", index], check=False)
    return 0


if __name__ == "__main__":
    sys.exit(main())
