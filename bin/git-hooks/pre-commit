#!/usr/bin/env bash
# Regenerate skills README when any skill's SKILL.md is staged.
set -euo pipefail

if git diff --cached --name-only | grep -q 'link-dir/\.agents/skills/.*/SKILL\.md'; then
    python3 "$(git rev-parse --show-toplevel)/bin/gen-skills-readme"
    git add link-dir/.agents/skills/README.md
fi
