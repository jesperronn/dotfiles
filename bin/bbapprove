#!/usr/bin/env bash
# shellcheck shell=bash
# bbapprove — wrapper: runs ~/src/bbapprove with the BITBUCKET_TOKEN_JRJ token from 1Password; passes all flags through.

set -euo pipefail

BBAPPROVE_BIN="${BBAPPROVE_BIN:-$HOME/src/bbapprove/bin/bbapprove}"

if [[ ! -x "$BBAPPROVE_BIN" ]]; then
  printf 'bbapprove: not found or not executable: %s\n' "$BBAPPROVE_BIN" >&2
  exit 127
fi

# Help needs no token: skip 1Password entirely.
for arg in "$@"; do
  case "$arg" in
    -h|--help) exec "$BBAPPROVE_BIN" "$@" ;;
  esac
done

# Always use the BITBUCKET_TOKEN_JRJ token from 1Password (ignores any preset BBAPPROVE_TOKEN).
BBAPPROVE_TOKEN="$(op item get BITBUCKET_TOKEN_JRJ --fields label=token --reveal)"
export BBAPPROVE_TOKEN

exec "$BBAPPROVE_BIN" "$@"
