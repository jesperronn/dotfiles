#!/usr/bin/env bash

set -u
# shellcheck shell=bash

SCRIPT_NAME="$(basename "$0")"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
#
# Purpose:
#   Diagnose and fix Podman VM issues: start/stop machines, check health,
#   fix socket mounts, resolve clock drift, and set port-443 sysctl.
#
# Usage:
#   bin/podman_troubleshoot [OPTIONS] [image_name]
#
# Options:
#       --init             Initialize/start the tracked Podman machine (creates it if
#                          missing) and converge its state, then exit. See init_machine().
#       --fix              Prompt before each recovery step and apply fixes.
#                          Also recreates the machine if its memory is at or below
#                          PODMAN_TROUBLESHOOT_MIN_MEMORY_MB.
#       --force            Skip prompts when --fix is set.
#       --verbose          Show progress for long-running checks.
#       --log-health       Log health check failures to a file.
#       --log-emergency    Log emergency failures.
#     -h, --help           Show this help and exit.
#
# Arguments:
#   image_name       Optional image name to test pull (e.g. postgres:18.3-alpine).
#                    If omitted, only system/registry checks run.
#
# Environment:
#   NO_COLOR              Disables color output.
#   PODMAN_TROUBLESHOOT_START_TIMEOUT_SECONDS
#                         Seconds to wait for podman machine start (default: 90).
#   PODMAN_TROUBLESHOOT_VM_REGISTRY_IP_PROBE_TIMEOUT_SECONDS
#                         Timeout for VM registry IP probe (default: 30).
#   PODMAN_TROUBLESHOOT_PS_TIMEOUT_SECONDS
#                         Timeout for podman ps checks (default: 30).
#   PODMAN_TROUBLESHOOT_CLOCK_DRIFT_THRESHOLD_SECONDS
#                         Allowed clock drift before reporting (default: 10).
#   PODMAN_TROUBLESHOOT_MIN_MEMORY_MB
#                         Recreate the machine in --fix if its memory is at or below
#                         this many MB (default: 4096).
#   PODMAN_TROUBLESHOOT_MACHINE_MEMORY_MB
#                         Memory (MB) for a machine created via --init or a --fix
#                         recreate (default: 8192).
#   PODMAN_TROUBLESHOOT_MACHINE_CPUS
#                         CPUs for a machine created via --init or a --fix recreate
#                         (default: 9).
#
# Dependencies:
#   podman, jq, bash >= 4
#
# Notes:
#   If no image is provided, only system and registry checks are run.
#   --fix prompts before each recovery step unless --force is also passed.
#   For the intended rootless setup and docker.sock model, see docs/podman-rootless-plan.md.
#   Edit run_main() to comment checks in or out as needed.
IMAGE_NAME=""
INIT_MODE=0
FIX_MODE=0
FORCE_MODE=0
VERBOSE_MODE=0
FAILURES=0
LOG_HEALTH_FAILURES=0
LOG_EMERGENCY_FAILURES=0
START_TIMEOUT_SECONDS="${PODMAN_TROUBLESHOOT_START_TIMEOUT_SECONDS:-90}"
VM_REGISTRY_IP_PROBE_TIMEOUT_SECONDS="${PODMAN_TROUBLESHOOT_VM_REGISTRY_IP_PROBE_TIMEOUT_SECONDS:-30}"
PODMAN_PS_TIMEOUT_SECONDS="${PODMAN_TROUBLESHOOT_PS_TIMEOUT_SECONDS:-30}"
VM_CLOCK_DRIFT_THRESHOLD_SECONDS="${PODMAN_TROUBLESHOOT_CLOCK_DRIFT_THRESHOLD_SECONDS:-10}"
MIN_MACHINE_MEMORY_MB="${PODMAN_TROUBLESHOOT_MIN_MEMORY_MB:-4096}"
MACHINE_MEMORY_MB="${PODMAN_TROUBLESHOOT_MACHINE_MEMORY_MB:-8192}"
MACHINE_CPUS="${PODMAN_TROUBLESHOOT_MACHINE_CPUS:-9}"
DEFAULT_MACHINE_NAME="podman-machine-default"

if [[ -n "${NO_COLOR:-}" ]]; then
  C_RESET=""
  C_GREEN=""
  C_YELLOW=""
  C_RED=""
  C_CYAN=""
else
  C_RESET=$'\033[0m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_RED=$'\033[31m'
  C_CYAN=$'\033[36m'
fi

log_section() {
  printf '\n%b== %s ==%b\n' "$C_CYAN" "$1" "$C_RESET"
}

status_line() {
  local color="$1"
  local marker="$2"
  local message="$3"
  printf '%b%s%b %s\n' "$color" "$marker" "$C_RESET" "$message"
}

log_ok() {
  status_line "$C_GREEN" "[OK]" "$1"
}

log_action() {
  status_line "$C_YELLOW" "[ACTION]" "$1"
}

log_troubleshoot() {
  status_line "$C_RED" "[TROUBLESHOOT]" "$1"
}

log_verbose() {
  if [[ "$VERBOSE_MODE" == "1" ]]; then
    status_line "$C_CYAN" "[VERBOSE]" "$1"
  fi
}

show_detail() {
  local detail="$1"
  [[ -n "$detail" ]] || return 0
  while IFS= read -r line; do
    printf '    %s\n' "$line"
  done <<<"$detail"
  return 0
}

capture_command() {
  local output_var="$1"
  local status_var="$2"
  shift 2

  local output_file
  local status=0
  output_file="$(mktemp)"

  if "$@" >"$output_file" 2>&1; then
    status=0
  else
    status=$?
  fi

  printf -v "$output_var" '%s' "$(<"$output_file")"
  rm -f "$output_file"
  printf -v "$status_var" '%s' "$status"
}

capture_command_with_timeout() {
  local output_var="$1"
  local status_var="$2"
  local timeout_seconds="$3"
  shift 3

  local output_file
  local pid=""
  local waited=0
  local status=0

  output_file="$(mktemp)"

  "$@" >"$output_file" 2>&1 &
  pid=$!

  while kill -0 "$pid" 2>/dev/null; do
    if [[ "$VERBOSE_MODE" == "1" ]] && (( waited == 0 || waited % 5 == 0 )); then
      log_verbose "still waiting (${waited}s/${timeout_seconds}s)"
    fi
    if (( waited >= timeout_seconds )); then
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      printf -v "$output_var" '%s' "$(<"$output_file")"$'\n'"timed out after ${timeout_seconds}s"
      rm -f "$output_file"
      printf -v "$status_var" '%s' "124"
      return 0
    fi

    sleep 1
    waited=$((waited + 1))
  done

  if wait "$pid"; then
    status=0
  else
    status=$?
  fi

  printf -v "$output_var" '%s' "$(<"$output_file")"
  rm -f "$output_file"
  printf -v "$status_var" '%s' "$status"
}

run_check() {
  local ok_message="$1"
  local fail_marker="$2"
  local fail_message="$3"
  local next_step="$4"
  shift 4

  local output=""
  local status=0
  if [[ "$VERBOSE_MODE" == "1" ]]; then
    log_verbose "running: $(printf '%q ' "$@")"
  fi
  capture_command output status "$@"

  if [[ $status -eq 0 ]]; then
    log_ok "$ok_message"
    return 0
  fi

  FAILURES=$((FAILURES + 1))
  if [[ "$fail_marker" == "action" ]]; then
    log_action "$fail_message"
  else
    log_troubleshoot "$fail_message"
  fi
  [[ -n "$next_step" ]] && printf '    next: %s\n' "$next_step"
  show_detail "$output"
  return 0
}

print_usage() {
  cat <<EOF
Usage: $SCRIPT_NAME [--init | --fix] [--force] [--verbose] [image_name]

Examples:
  $SCRIPT_NAME
  $SCRIPT_NAME --init
  $SCRIPT_NAME --fix
  $SCRIPT_NAME --fix --force
  $SCRIPT_NAME --verbose
  $SCRIPT_NAME postgres:18.3-alpine
  $SCRIPT_NAME quay.io/libpod/alpine:latest

Notes:
  - If no image is provided, only system and registry checks are run.
  - Image pull checks run only when an image name is provided.
  - --fix prompts before each recovery step unless --force is also passed.
  - --verbose prints progress for long-running checks.
  - For the intended rootless setup and docker.sock model, see docs/podman-rootless-plan.md.
  - Edit run_main() to comment checks in or out as needed.
EOF
}

have_command() {
  command -v "$1" >/dev/null 2>&1
}

have_jq() {
  have_command jq
}

PODMAN_BIN="$(type -P podman 2>/dev/null || true)"
DOCKER_BIN="$(type -P docker 2>/dev/null || true)"

podman() {
  if [[ -n "$PODMAN_BIN" ]]; then
    command "$PODMAN_BIN" "$@"
  else
    command podman "$@"
  fi
}

docker() {
  if [[ -n "$DOCKER_BIN" ]]; then
    command "$DOCKER_BIN" "$@"
  else
    command docker "$@"
  fi
}

podman_control() {
  if [[ -n "$PODMAN_BIN" ]]; then
    env -u DOCKER_HOST "$PODMAN_BIN" "$@"
  else
    env -u DOCKER_HOST podman "$@"
  fi
}

stable_podman_socket_path() {
  printf '%s/.local/share/containers/podman/machine/podman.sock' "$HOME"
}

port_443_sysctl_value() {
  podman_control machine ssh 'sysctl -n net.ipv4.ip_unprivileged_port_start' 2>/dev/null | tr -d '\r'
}

port_443_sysctl_allows_rootless() {
  local value

  value="$(port_443_sysctl_value)"
  [[ "$value" =~ ^[0-9]+$ ]] || return 1
  (( value <= 443 ))
}

configure_rootless_port_443() {
  podman_control machine ssh "echo 'net.ipv4.ip_unprivileged_port_start=443' | sudo tee /etc/sysctl.d/99-unprivileged-ports.conf >/dev/null && sudo sysctl --system"
}

trim_trailing_slash() {
  local path="$1"
  while [[ "$path" != "/" && "$path" == */ ]]; do
    path="${path%/}"
  done
  printf '%s\n' "$path"
}

podman_current_machine_name() {
  local machine_list_json
  local machine_name

  machine_list_json="$(podman_control machine list --format json 2>/dev/null || true)"
  if [[ -n "$machine_list_json" ]]; then
    machine_name="$(printf '%s\n' "$machine_list_json" | jq -r '.[] | select(.Default == true) | .Name' 2>/dev/null | head -n1)"
    if [[ -n "$machine_name" ]]; then
      printf '%s\n' "$machine_name"
      return 0
    fi

    machine_name="$(printf '%s\n' "$machine_list_json" | jq -r 'if length == 1 then .[0].Name else empty end' 2>/dev/null | head -n1)"
    if [[ -n "$machine_name" ]]; then
      printf '%s\n' "$machine_name"
      return 0
    fi
  fi

  machine_name="$(podman_default_connection_name || true)"
  if [[ -n "$machine_name" ]]; then
    machine_name="${machine_name%-root}"
    printf '%s\n' "$machine_name"
    return 0
  fi

  return 1
}

podman_machine_connection_name() {
  local machine_name="$1"
  local rootful

  rootful="$(podman_control machine inspect "$machine_name" --format '{{.Rootful}}' 2>/dev/null || true)"
  if [[ "$rootful" == "true" ]]; then
    printf '%s-root\n' "$machine_name"
  else
    printf '%s\n' "$machine_name"
  fi
}

require_podman() {
  if ! have_command podman; then
    log_action "podman is not installed or not on PATH"
    printf '    next: install Podman and re-run %s\n' "$SCRIPT_NAME"
    exit 1
  fi
}

print_rootless_socket_recovery_steps() {
  cat <<'EOF'
    next: run podman_troubleshoot --fix to converge the machine and socket state
    next: if the machine still needs a manual reset, do this sequence:
      podman_troubleshoot --fix
      podman machine stop
      podman machine set --rootful=false
      podman machine start
      podman_troubleshoot --fix
      podman ps
    next: if you need rootless Traefik or other Docker-compatible clients, point them at:
      export DOCKER_HOST="unix://${HOME}/.local/share/containers/podman/machine/podman.sock"
    next: if you need port 443 while staying rootless, run once after the VM starts:
      podman-allow-port-443
EOF
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        print_usage
        exit 0
        ;;
      --init)
        INIT_MODE=1
        ;;
      --fix)
        FIX_MODE=1
        ;;
      --force)
        FORCE_MODE=1
        ;;
      --verbose)
        VERBOSE_MODE=1
        ;;
      --)
        shift
        if [[ $# -gt 0 ]]; then
          IMAGE_NAME="$1"
          shift
        fi
        ;;
      -*)
        printf 'Unknown option: %s\n' "$1" >&2
        print_usage >&2
        exit 1
        ;;
      *)
        if [[ -n "$IMAGE_NAME" ]]; then
          printf 'Unexpected extra argument: %s\n' "$1" >&2
          print_usage >&2
          exit 1
        fi
        IMAGE_NAME="$1"
        ;;
    esac
    shift
  done
}

refresh_stable_podman_socket() {
  local machine_name="$1"
  local current_vm_sock
  local stable_sock

  current_vm_sock="$(podman_control machine inspect "$machine_name" --format '{{.ConnectionInfo.PodmanSocket.Path}}' 2>/dev/null || true)"
  [[ -n "$current_vm_sock" ]] || return 1

  stable_sock="$(stable_podman_socket_path)"
  mkdir -p "$(dirname "$stable_sock")"
  ln -sf "$current_vm_sock" "$stable_sock"
  printf 'stable socket: %s -> %s\n' "$stable_sock" "$current_vm_sock"
}

start_podman_machine() {
  local machine_name="$1"
  local output_file=""
  local status=0
  local waited=0
  local pid=0

  output_file="$(mktemp)"
  podman_control machine start "$machine_name" >"$output_file" 2>&1 &
  pid=$!

  while kill -0 "$pid" 2>/dev/null; do
    if [[ "$VERBOSE_MODE" == "1" ]] && (( waited == 0 || waited % 5 == 0 )); then
      log_verbose "waiting for podman machine start (${waited}s/${START_TIMEOUT_SECONDS}s)"
    fi
    if (( waited >= START_TIMEOUT_SECONDS )); then
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      cat "$output_file"
      rm -f "$output_file"
      printf 'start timed out after %ss\n' "$START_TIMEOUT_SECONDS"
      return 124
    fi

    sleep 1
    waited=$((waited + 1))
  done

  if wait "$pid"; then
    status=0
  else
    status=$?
  fi

  cat "$output_file"
  rm -f "$output_file"
  return "$status"
}

podman_machine_running() {
  local machine_name="$1"
  local machine_list_json

  machine_list_json="$(podman_control machine list --format json 2>/dev/null || true)"
  [[ -n "$machine_list_json" ]] || return 1
  printf '%s\n' "$machine_list_json" | jq -e -r --arg name "$machine_name" '.[] | select(.Name == $name and .Running == true) | .Name' >/dev/null 2>&1
}

confirm_fix_step() {
  local prompt="$1"
  local reply=""

  if [[ "$FORCE_MODE" == "1" ]]; then
    return 0
  fi

  printf 'Run fix step: %s? [Y/n] ' "$prompt"
  if ! IFS= read -r reply; then
    printf '\n'
    log_action "no confirmation received; skipping: $prompt"
    printf '    next: rerun %s --fix --force to apply all fix steps non-interactively\n' "$SCRIPT_NAME"
    return 1
  fi

  if [[ -z "$reply" || "$reply" =~ ^[Yy]([Ee][Ss])?$ ]]; then
    return 0
  fi

  log_action "skipped: $prompt"
  return 1
}

run_fix_step() {
  local ok_message="$1"
  local prompt="$2"
  shift 2

  if ! confirm_fix_step "$prompt"; then
    return 0
  fi

  local output=""
  local status=0
  capture_command output status "$@"

  if [[ $status -eq 0 ]] && ! podman_error_output "$output"; then
    log_ok "$ok_message"
    show_detail "$output"
    return 0
  fi

  log_troubleshoot "$ok_message failed"
  show_detail "$output"
  return "$status"
}

verify_fix_result() {
  local output=""
  local status=0

  log_section "Fix Verification"

  capture_command output status podman ps
  if [[ $status -eq 0 ]] && ! printf '%s\n' "$output" | grep -Eq 'Error:|Cannot connect to Podman|connection refused|failed to connect'; then
    log_ok "podman ps succeeded after fix"
    show_detail "$output"
  else
    log_troubleshoot "podman ps still failed after fix"
    show_detail "$output"
    return 1
  fi

  capture_command output status podman info
  if [[ $status -eq 0 ]] && ! printf '%s\n' "$output" | grep -Eq 'Error:|Cannot connect to Podman|connection refused|failed to connect'; then
    log_ok "podman info succeeded after fix"
    return 0
  fi

  log_troubleshoot "podman info still failed after fix"
  show_detail "$output"
  return 1
}

privileged_port_policy_report() {
  local value

  value="$(port_443_sysctl_value)"
  if [[ -z "$value" ]]; then
    printf 'vm sysctl: <unavailable>\n'
    return 1
  fi

  printf 'vm sysctl: net.ipv4.ip_unprivileged_port_start=%s\n' "$value"
  if [[ "$value" =~ ^[0-9]+$ ]] && (( value <= 443 )); then
    printf 'rootless host port 443: allowed\n'
    return 0
  fi

  printf 'rootless host port 443: blocked\n'
  return 1
}

machine_memory_mb() {
  local machine_name="$1"
  podman_control machine inspect "$machine_name" --format '{{.Resources.Memory}}' 2>/dev/null || true
}

# Creates the tracked Podman machine if missing (using MACHINE_CPUS/MACHINE_MEMORY_MB),
# then converges it to rootless, refreshes the stable socket, and allows port 443.
# Inlined from the former bin/podman_machine_init so --init and the --fix low-memory
# recreate path share one implementation.
init_machine() {
  local machine_name="$1"
  local -a init_args
  local connection_name
  local rootful
  local socket_path

  if podman_control machine inspect "$machine_name" >/dev/null 2>&1; then
    printf '🚀 Starting Podman machine: %s\n' "$machine_name"
  else
    printf '🤖 Initializing fresh High-Performance Podman machine: %s (cpus=%s memory=%sMB)\n' \
      "$machine_name" "$MACHINE_CPUS" "$MACHINE_MEMORY_MB"
    init_args=(
      --cpus "$MACHINE_CPUS"
      --memory "$MACHINE_MEMORY_MB"
      --disk-size 100
      --rootful=false
      --provider applehv
    )

    podman_control machine init "${init_args[@]}" "$machine_name"
    printf '🚀 Starting Podman machine: %s\n' "$machine_name"
  fi

  rootful="$(podman_control machine inspect "$machine_name" --format '{{.Rootful}}' 2>/dev/null || true)"
  if [[ "$rootful" == "true" ]]; then
    printf '🔧 Reconfiguring %s to rootless mode...\n' "$machine_name"
    podman_control machine stop "$machine_name" >/dev/null 2>&1 || true
    podman_control machine set --rootful=false "$machine_name"
  fi

  connection_name="$(podman_machine_connection_name "$machine_name")"
  if ! podman_machine_running "$machine_name"; then
    start_podman_machine "$machine_name"
  else
    printf 'ℹ️ Machine already running.\n'
  fi

  socket_path="$(podman_control machine inspect "$machine_name" --format '{{.ConnectionInfo.PodmanSocket.Path}}' 2>/dev/null || true)"
  if [[ -n "$socket_path" ]]; then
    mkdir -p "$HOME/.local/share/containers/podman/machine"
    ln -sf "$socket_path" "$HOME/.local/share/containers/podman/machine/podman.sock"
  fi
  podman_control system connection default "$connection_name" >/dev/null 2>&1 || true

  if ! port_443_sysctl_allows_rootless; then
    configure_rootless_port_443
  fi

  printf '🔗 Active Podman connection: %s\n' "$connection_name"
}

run_init_mode() {
  log_section "Podman Init"

  local machine_name="${IMAGE_NAME:-}"
  if [[ -z "$machine_name" ]]; then
    machine_name="$(podman_current_machine_name || true)"
  fi
  if [[ -z "$machine_name" ]]; then
    machine_name="$DEFAULT_MACHINE_NAME"
  fi

  init_machine "$machine_name"
}

run_fix_mode() {
  log_section "Podman Fix"

  if ! have_jq; then
    log_troubleshoot "jq is required for --fix"
    printf '    next: install jq and rerun %s --fix\n' "$SCRIPT_NAME"
    return 1
  fi

  local machine_name
  local connection_name
  local rootful

  machine_name="$(podman_current_machine_name || true)"
  if [[ -z "$machine_name" ]]; then
    log_troubleshoot "no Podman machine could be resolved"
    printf '    next: run podman machine list\n'
    printf '    next: if nothing is configured yet, run podman machine init && podman machine start\n'
    return 1
  fi

  rootful="$(podman_control machine inspect "$machine_name" --format '{{.Rootful}}' 2>/dev/null || true)"
  connection_name="$(podman_machine_connection_name "$machine_name")"

  show_detail "machine: $machine_name
rootful: ${rootful:-unknown}
connection: $connection_name"

  local current_memory_mb
  current_memory_mb="$(machine_memory_mb "$machine_name")"
  if [[ "$current_memory_mb" =~ ^[0-9]+$ ]] && (( current_memory_mb <= MIN_MACHINE_MEMORY_MB )); then
    log_troubleshoot "machine $machine_name has ${current_memory_mb}MB memory (<= ${MIN_MACHINE_MEMORY_MB}MB threshold)"
    if run_fix_step \
      "machine recreated with ${MACHINE_MEMORY_MB}MB memory" \
      "recreate $machine_name (stop, rm -f, init with ${MACHINE_CPUS} cpus / ${MACHINE_MEMORY_MB}MB memory) to fix low memory" \
      bash -c "podman machine stop '$machine_name' 2>/dev/null; podman machine rm -f '$machine_name'"; then
      init_machine "$machine_name"
      rootful="$(podman_control machine inspect "$machine_name" --format '{{.Rootful}}' 2>/dev/null || true)"
      connection_name="$(podman_machine_connection_name "$machine_name")"
    fi
  else
    log_ok "machine $machine_name memory is above the ${MIN_MACHINE_MEMORY_MB}MB threshold"
  fi

  if [[ "$rootful" == "true" ]]; then
    run_fix_step \
      "machine switched to rootless mode" \
      "stop $machine_name and run podman machine set --rootful=false" \
      bash -lc "podman machine stop '$machine_name' && podman machine set --rootful=false '$machine_name'"
    connection_name="$machine_name"
  fi

  if ! podman_machine_running "$machine_name"; then
    log_troubleshoot "default Podman machine is not running; attempting to start"
    if ! run_fix_step \
      "Podman machine started" \
      "start $machine_name" \
      start_podman_machine "$machine_name"; then
      log_troubleshoot "machine start failed"
      check_machine_log_health
      return 1
    fi
  else
    log_ok "Podman machine is already running"
  fi

  run_fix_step \
    "stable Podman socket refreshed" \
    "refresh the stable Podman socket symlink" \
    refresh_stable_podman_socket "$machine_name" || return 1

  run_fix_step \
    "default Podman connection aligned" \
    "set the default Podman connection to $connection_name" \
    podman_control system connection default "$connection_name" || return 1

  if ! port_443_sysctl_allows_rootless; then
    run_fix_step \
      "rootless privileged port floor updated for port 443" \
      "allow rootless port 443 inside the Podman VM" \
      configure_rootless_port_443 || return 1
  else
    log_ok "rootless privileged port floor already allows port 443"
  fi

  local host_epoch vm_epoch clock_drift
  host_epoch="$(date +%s)"
  vm_epoch="$(podman machine ssh 'date +%s' 2>/dev/null | tr -d '\r' || true)"
  if [[ -n "$vm_epoch" && "$vm_epoch" =~ ^[0-9]+$ ]]; then
    clock_drift=$(( vm_epoch - host_epoch ))
    if (( clock_drift < 0 )); then clock_drift=$(( -clock_drift )); fi
    if (( clock_drift > VM_CLOCK_DRIFT_THRESHOLD_SECONDS )); then
      run_fix_step \
        "VM clock synced to host (drift was ${clock_drift}s)" \
        "sync VM clock via chronyc makestep (drift ${clock_drift}s)" \
        podman machine ssh 'sudo chronyc makestep' || true
    else
      log_ok "VM clock is in sync with host (drift ${clock_drift}s)"
    fi
  fi

  verify_fix_result
}

check_podman_socket_connection() {
  log_section "Podman Socket Connection"

  local output=""
  local status=0
  capture_command_with_timeout output status "$PODMAN_PS_TIMEOUT_SECONDS" podman ps

  if [[ $status -eq 124 ]]; then
    FAILURES=$((FAILURES + 1))
    log_troubleshoot "\`podman ps\` timed out (${PODMAN_PS_TIMEOUT_SECONDS}s)"
    printf '    next: common after host hibernation; wait 10-20s and retry\n'
    printf '    next: or: `podman machine stop && podman machine start`\n'
    printf '    next: or increase timeout: `PODMAN_TROUBLESHOOT_PS_TIMEOUT_SECONDS=90 %s`\n' "$SCRIPT_NAME"
    return 0
  fi

  if [[ $status -eq 0 ]] && ! printf '%s\n' "$output" | grep -Eq 'Error:|Cannot connect to Podman|connection refused|failed to connect'; then
    log_ok "\`podman ps\` OK; socket healthy"
    return 0
  fi

  FAILURES=$((FAILURES + 1))
  if printf '%s\n' "$output" | grep -Eq 'connection refused|Cannot connect to Podman|failed to connect'; then
    log_troubleshoot "\`podman ps\` connection refused"
    if [[ "$FIX_MODE" == "1" ]]; then
      printf '    next: fixing machine and socket state below\n'
    else
      printf '    next: `bin/podman_troubleshoot --fix` to start machine and align socket\n'
    fi
    printf '    next: for rootless clients: `export DOCKER_HOST="unix://${HOME}/.local/share/containers/podman/machine/podman.sock"`\n'
  else
    log_troubleshoot "podman ps failed"
    printf '    next: run: podman info\n'
    printf '    next: run: podman system connection list\n'
  fi
  show_detail "$output"
  return 0
}

have_image_name() {
  [[ -n "$IMAGE_NAME" ]]
}

podman_error_output() {
  local text="$1"
  printf '%s\n' "$text" | grep -Eq 'Error:|Cannot connect to Podman|operation not permitted|vfkit exited unexpectedly|podman helper is installed, but was not able to claim the global docker sock'
}

podman_default_machine_name() {
  local machine_list_json
  local machine_name

  machine_list_json="$(podman_control machine list --format json 2>/dev/null || true)"
  [[ -n "$machine_list_json" ]] || return 1

  machine_name="$(printf '%s\n' "$machine_list_json" | jq -r '.[] | select(.Default == true) | .Name' 2>/dev/null | head -n1)"
  if [[ -n "$machine_name" ]]; then
    printf '%s\n' "$machine_name"
    return 0
  fi

  machine_name="$(printf '%s\n' "$machine_list_json" | jq -r 'if length == 1 then .[0].Name else empty end' 2>/dev/null | head -n1)"
  if [[ -n "$machine_name" ]]; then
    printf '%s\n' "$machine_name"
    return 0
  fi

  return 1
}

podman_default_connection_name() {
  local connection_json

  connection_json="$(podman_control system connection list --format json 2>/dev/null || true)"
  [[ -n "$connection_json" ]] || return 1
  printf '%s\n' "$connection_json" | jq -r '.[] | select(.Default == true) | .Name' 2>/dev/null | head -n1
}

podman_machine_inventory_report() {
  local machine_list_json
  local connection_json
  local default_machine
  local current_machine
  local default_connection
  local expected_connection
  local machine_count
  local default_connection_count
  local status=0

  machine_list_json="$(podman_control machine list --format json 2>&1)"
  status=$?
  if [[ $status -ne 0 ]] || podman_error_output "$machine_list_json"; then
    printf '%s\n' "$machine_list_json"
    return 1
  fi

  connection_json="$(podman_control system connection list --format json 2>&1)"
  status=$?
  if [[ $status -ne 0 ]] || podman_error_output "$connection_json"; then
    printf '%s\n' "$connection_json"
    return 1
  fi

  default_machine="$(printf '%s\n' "$machine_list_json" | jq -r '.[] | select(.Default == true) | .Name' 2>/dev/null | head -n1)"
  current_machine="$default_machine"
  if [[ -z "$current_machine" ]]; then
    current_machine="$(printf '%s\n' "$connection_json" | jq -r '.[] | select(.Default == true) | .Name' 2>/dev/null | head -n1)"
    current_machine="${current_machine%-root}"
  fi
  default_connection="$(printf '%s\n' "$connection_json" | jq -r '.[] | select(.Default == true) | .Name' | head -n1)"
  machine_count="$(printf '%s\n' "$machine_list_json" | jq -r 'length' 2>/dev/null | head -n1)"
  default_connection_count="$(printf '%s\n' "$connection_json" | jq '[.[] | select(.Default == true)] | length')"
  expected_connection="$default_machine"
  if [[ -z "$expected_connection" ]]; then
    expected_connection="$current_machine"
  fi
  if [[ -n "$expected_connection" ]]; then
    expected_connection="$(podman_machine_connection_name "$expected_connection" 2>/dev/null || printf '%s\n' "$expected_connection")"
  fi

  printf 'default machine: %s\n' "${default_machine:-<none>}"
  printf 'current machine: %s\n' "${current_machine:-<none>}"
  printf 'default connection: %s\n' "${default_connection:-<none>}"
  printf 'machine count: %s\n' "$machine_count"
  printf 'default connection entries: %s\n' "$default_connection_count"

  if [[ -z "$expected_connection" || -z "$default_connection" || "$expected_connection" != "$default_connection" ]]; then
    return 1
  fi

  if [[ "$machine_count" -gt 1 ]]; then
    printf 'note: multiple machines are present; confirm the stale one can be removed once it is no longer needed.\n'
  fi
}

podman_machine_start_lock_report() {
  local lock_file="$1"
  local permissions
  local owner

  permissions="$(stat -f '%Sp' "$lock_file" 2>/dev/null)"
  owner="$(stat -f '%Su:%Sg' "$lock_file" 2>/dev/null)"

  printf 'lock file: %s\n' "$lock_file"
  printf 'permissions: %s\n' "${permissions:-<unknown>}"
  printf 'owner: %s\n' "${owner:-<unknown>}"

  [[ "$permissions" == -rw-------* ]]
}

podman_machine_running_state_report() {
  local machine_list_json
  local connection_json
  local default_machine
  local current_machine
  local machine_name
  local running=""
  local starting=""
  local state=""
  local status=0
  local machine_count="0"
  local default_connection=""

  machine_list_json="$(podman_control machine list --format json 2>&1)"
  status=$?
  if [[ $status -ne 0 ]] || podman_error_output "$machine_list_json"; then
    printf '%s\n' "$machine_list_json"
    return 1
  fi

  connection_json="$(podman_control system connection list --format json 2>&1)"
  status=$?
  if [[ $status -ne 0 ]] || podman_error_output "$connection_json"; then
    printf '%s\n' "$connection_json"
    return 1
  fi

  default_machine="$(printf '%s\n' "$machine_list_json" | jq -r '.[] | select(.Default == true) | .Name' 2>/dev/null | head -n1)"
  current_machine="$default_machine"
  if [[ -z "$current_machine" ]]; then
    current_machine="$(printf '%s\n' "$connection_json" | jq -r '.[] | select(.Default == true) | .Name' 2>/dev/null | head -n1)"
    current_machine="${current_machine%-root}"
  fi

  machine_count="$(printf '%s\n' "$machine_list_json" | jq -r 'length' 2>/dev/null | head -n1)"
  if [[ -n "$default_machine" ]]; then
    machine_name="$default_machine"
  else
    machine_name="$current_machine"
  fi

  if [[ -n "$machine_name" ]]; then
    running="$(printf '%s\n' "$machine_list_json" | jq -r --arg name "$machine_name" '.[] | select(.Name == $name) | .Running' 2>/dev/null | head -n1)"
    starting="$(printf '%s\n' "$machine_list_json" | jq -r --arg name "$machine_name" '.[] | select(.Name == $name) | .Starting' 2>/dev/null | head -n1)"
    if [[ "$starting" == "true" ]]; then
      state="starting"
    elif [[ "$running" == "true" ]]; then
      state="running"
    else
      state="stopped"
    fi
  fi

  default_connection="$(printf '%s\n' "$connection_json" | jq -r '.[] | select(.Default == true) | .Name' 2>/dev/null | head -n1)"

  printf 'default machine: %s\n' "${default_machine:-<none>}"
  printf 'current machine: %s\n' "${current_machine:-<none>}"
  printf 'resolved machine: %s\n' "$machine_name"
  printf 'state: %s\n' "${state:-<unknown>}"
  printf 'running: %s\n' "${running:-<unknown>}"
  printf 'starting: %s\n' "${starting:-<unknown>}"
  printf 'machine count: %s\n' "${machine_count:-0}"
  printf 'default connection: %s\n' "${default_connection:-<none>}"

  [[ "$running" == "true" && "$starting" != "true" && "$state" == "running" ]]
}

check_host_loopback_443() {
  log_section "Host Loopback 443"

  if ! have_command lsof; then
    log_action "lsof is not installed; skipping host port 443 listener inspection"
    printf '    next: install lsof and re-run %s\n' "$SCRIPT_NAME"
    return 0
  fi

  local output=""
  local status=0
  capture_command output status lsof -nP -iTCP:443 -sTCP:LISTEN

  if [[ $status -ne 0 || -z "$output" ]]; then
    log_action "nothing is listening on host port 443"
    printf '    next: if Traefik or another local service should be reachable, start the host-side listener or the Podman machine that provides it\n'
    show_detail "$output"
    return 0
  fi

  if printf '%s\n' "$output" | grep -q 'gvproxy'; then
    log_ok "host port 443 is being served by Podman gvproxy"
    printf '    note: \`lsof -nP -iTCP:443 -sTCP:LISTEN\` shows gvproxy; host listener is separate from Podman CLI health\n'
  else
    log_action "host port 443 is occupied by a non-gvproxy listener"
    printf '    next: run \`lsof -nP -iTCP:443 -sTCP:LISTEN\` to inspect the listener before assuming Traefik is coming from Podman\n'
  fi

  show_detail "$output"
}

check_docker_socket_rootless() {
  log_section "Docker Socket Rootless Test"

  if ! have_command curl; then
    log_action "curl not installed; skipping Traefik smoke test"
    printf '    next: install curl to test Docker-label routing\n'
    return 0
  fi

  if [[ ! -x "$SCRIPT_DIR/docker_socket_rootless_test" ]]; then
    log_action "docker_socket_rootless_test not found"
    printf '    next: add bin/docker_socket_rootless_test from repo or test manually\n'
    return 0
  fi

  # Try to run test on available port (443, then 444, 445, ...)
  local port="" test_port=443 max_attempts=10 attempt=0 output="" status=0

  while (( attempt < max_attempts )); do
    if [[ "$VERBOSE_MODE" == "1" ]]; then
      log_verbose "attempting Docker socket test on port $test_port"
    fi

    capture_command_with_timeout output status 60 \
      "$SCRIPT_DIR/docker_socket_rootless_test" --port "$test_port" 2>&1

    if [[ $status -eq 0 ]] || printf '%s\n' "$output" | grep -qi 'working'; then
      log_ok "Docker socket rootless routing working on port $test_port"
      printf '    result: %s\n' "$(printf '%s\n' "$output" | grep -i 'working' | head -1)"
      return 0
    fi

    if printf '%s\n' "$output" | grep -qi 'address already in use'; then
      test_port=$((test_port + 1))
      attempt=$((attempt + 1))
      continue
    fi

    # Other error
    FAILURES=$((FAILURES + 1))
    log_troubleshoot "Docker socket test failed on port $test_port"
    printf '    next: check compose output: %s\n' "$(printf '%s\n' "$output" | head -3)"
    return 0
  done

  log_troubleshoot "No available port found for Docker socket test (tried 443-452)"
  printf '    next: check if ports 443-452 are in use: `lsof -nP -iTCP:443-452 -sTCP:LISTEN`\n'
}

podman_machine_log_health_report() {
  local log_file="$1"
  local suspicious_lines

  suspicious_lines="$(
    strings "$log_file" 2>/dev/null |
      rg -n -i 'vfkit exited unexpectedly|input/output error|operation not permitted|failed to rotate|failed to open|not able to claim the global docker sock|failed to claim the global docker sock|panic|fatal|ignition has failed|entering emergency mode|press enter for system maintenance' -N || true
  )"

  printf 'log file: %s\n' "$log_file"

  if [[ -z "$suspicious_lines" ]]; then
    printf 'recent vfkit log entries look clean\n'
    return 0
  fi

  printf 'suspicious log entries:\n%s\n' "$suspicious_lines"
  return 1
}

docker_sock_report() {
  local docker_sock="/var/run/docker.sock"
  local stable_sock
  local resolved_target
  local stable_target

  stable_sock="$(stable_podman_socket_path)"

  if [[ ! -e "$docker_sock" && ! -L "$docker_sock" ]]; then
    printf 'docker sock: %s\n' "$docker_sock"
    printf 'state: missing\n'
    printf 'expected stable podman socket: %s\n' "$stable_sock"
    return 1
  fi

  printf 'docker sock: %s\n' "$docker_sock"
  stat -f 'type=%HT mode=%Sp owner=%Su:%Sg target=%Y' "$docker_sock" 2>/dev/null || true

  resolved_target="$(readlink "$docker_sock" 2>/dev/null || true)"
  stable_target="$(readlink "$stable_sock" 2>/dev/null || true)"

  if [[ -n "$resolved_target" ]]; then
    printf 'resolved target: %s\n' "$resolved_target"
  fi

  if [[ -L "$stable_sock" ]]; then
    printf 'stable podman socket: %s -> %s\n' "$stable_sock" "$stable_target"
  else
    printf 'stable podman socket: %s\n' "$stable_sock"
  fi

  [[ "$resolved_target" == "$stable_sock" || "$resolved_target" == "$stable_target" ]]
}

check_local_client_versions() {
  log_section "Local Client Versions"

  if have_command docker; then
    run_check \
      "\`docker version\` OK" \
      "troubleshoot" \
      "\`docker version\` failed" \
      "try: docker version" \
      docker version --format 'Client {{.Client.Version}}'
  else
    log_ok "docker not installed"
  fi

  run_check \
    "\`podman version\` OK" \
    "action" \
    "\`podman version\` failed" \
    "try: podman version" \
    podman version --format 'Client {{.Client.Version}}'
}

check_podman_system_container() {
  log_section "Podman System Container"

  local podman_version="" output="" status=0

  if ! have_command podman; then
    log_action "podman not available"
    return 0
  fi

  capture_command output status podman version --format '{{.Version}}'
  if [[ $status -ne 0 ]] || [[ -z "$output" ]]; then
    log_action "`podman version` failed"
    return 0
  fi

  podman_version="$output"
  printf 'version: %s\n' "$podman_version"

  log_ok "System container bundled with client"
  printf '    next: `brew upgrade podman` then `bin/podman_troubleshoot --fix`\n'
}

check_global_docker_socket() {
  log_section "Global Docker Socket"

  local output=""
  local status=0
  capture_command output status docker_sock_report

  if [[ $status -eq 0 ]]; then
    log_ok "/var/run/docker.sock points at the Podman user-space socket"
  else
    FAILURES=$((FAILURES + 1))
    log_troubleshoot "/var/run/docker.sock does not point at the Podman user-space socket"
    printf "%s\n" "    next: decide whether you need \`/var/run/docker.sock\` at all; \`DOCKER_HOST\` is preferred for this setup"
    printf "%s\n" "    next: for rootless Podman clients, export:"
    printf "%s\n" "      export DOCKER_HOST=\"unix://\${HOME}/.local/share/containers/podman/machine/podman.sock\""
    printf "%s\n" "    next: if a client hardcodes \`/var/run/docker.sock\`, inspect what owns the current target before replacing it"
  fi

  show_detail "$output"
}

