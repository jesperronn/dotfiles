    "troubleshoot" \
    "VM DNS lookup failed for registry-1.docker.io" \
    "run: podman machine ssh 'getent hosts registry-1.docker.io'" \
    podman machine ssh 'getent hosts registry-1.docker.io'

  run_check \
    "VM can reach registry-1.docker.io" \
    "troubleshoot" \
    "VM could not reach registry-1.docker.io" \
    "run: podman machine ssh 'curl -I --max-time 15 https://registry-1.docker.io/v2/'" \
    podman machine ssh 'curl -I --max-time 15 https://registry-1.docker.io/v2/'
}

check_container_https_egress() {
  log_section "Rootless Container HTTPS Egress"

  # Diagnostic-only check: distinguish broken container network from broken Podman runtime.
  # Probes HTTPS connectivity from host, VM, and a disposable rootless container.
  # Container probes run only if engine health checks pass.
  # See docs/PLAN-podman-container-egress-handoff.md for context.

  if ! podman_machine_running "$(podman_current_machine_name || true)"; then
    if [[ "$FIX_MODE" == "1" ]]; then
      log_action "machine will be started above; container egress check will run on next invocation"
    else
      log_action "machine is not running; will check after it starts (run: bin/podman_troubleshoot --fix)"
    fi
    return 0
  fi

  local host_result="" vm_result="" container_result=""
  local host_status=0 vm_status=0 container_status=0

  if [[ "$VERBOSE_MODE" == "1" ]]; then
    log_verbose "testing HTTPS connectivity from host, VM, and container (probes only; not full Traefik test)"
  fi

  # Host probe: silent HTTPS connection test
  capture_command_with_timeout host_result host_status 20 \
    curl -sk --connect-timeout 8 --max-time 20 -o /dev/null -w 'host ok' https://example.com 2>/dev/null || echo "host fail"

  # VM probe: silent HTTPS connection from VM
  capture_command_with_timeout vm_result vm_status 20 \
    podman machine ssh 'curl -sk --connect-timeout 8 --max-time 20 -o /dev/null -w "vm ok" https://example.com 2>/dev/null || echo "vm fail"'

  # Container probe: test from rootless container (using a cached image)
  local container_image="docker.io/library/busybox:latest"
  local container_output=""
  if capture_command_with_timeout container_output container_status 30 \
    podman run --rm "$container_image" sh -c 'timeout 20 wget -q -O /dev/null --no-check-certificate https://example.com && echo "container ok" || echo "container fail"' 2>/dev/null; then
    container_result="$container_output"
  else
    container_result="container timeout"
  fi

  # Summarize results
  printf 'HTTPS connectivity:\n'
  printf '  %s\n' "$host_result"
  printf '  %s\n' "$vm_result"
  printf '  %s\n' "$container_result"

  # Diagnose: if host and VM work but container fails, container egress is broken
  if printf '%s\n' "$host_result" | grep -qi 'ok' && \
     printf '%s\n' "$vm_result" | grep -qi 'ok' && \
     printf '%s\n' "$container_result" | grep -qi 'timeout'; then
    FAILURES=$((FAILURES + 1))
    log_troubleshoot "rootless container HTTPS egress broken (host/VM ok, container timeout)"
    printf '    next: container network blocked; verify with \`podman run --rm alpine curl https://example.com\`\n'
    printf '    next: check firewall, NAT, or container network policy\n'
    return 0
  fi

  if printf '%s\n' "$host_result" | grep -qi 'ok' && \
     printf '%s\n' "$vm_result" | grep -qi 'ok' && \
     printf '%s\n' "$container_result" | grep -qi 'ok'; then
    log_ok "HTTPS connectivity OK from host, VM, and container"
    printf '    note: this is a basic connectivity probe; use `bin/docker_socket_rootless_test` for full Traefik routing test\n'
    return 0
  fi

  log_action "HTTPS probe inconclusive (may need manual Traefik test)"
}

check_machine_stability() {
  log_section "Machine Stability After Start"

  # Diagnostic-only check: distinguish runtime lifecycle failure from connection issues.
  # Runs podman ps twice with a 10-second gap, then checks machine list state.
  # See docs/PLAN-podman-container-egress-handoff.md for context.

  local machine_name
  machine_name="$(podman_current_machine_name || true)"
  if [[ -z "$machine_name" ]]; then
    log_action "no current machine; skipping stability check"
    return 0
  fi

  if ! podman_machine_running "$machine_name"; then
    if [[ "$FIX_MODE" == "1" ]]; then
      log_action "machine will be started above; stability check will run on next invocation"
    else
      log_action "machine is not running; will check after it starts (run: bin/podman_troubleshoot --fix)"
    fi
    return 0
  fi

  if [[ "$VERBOSE_MODE" == "1" ]]; then
    log_verbose "checking machine stability: probing podman ps at T+0s and T+10s"
  fi

  local ps_probe_1="" ps_probe_2="" machine_list_probe=""
  local status_1=0 status_2=0 status_list=0

  # First ps probe
  capture_command_with_timeout ps_probe_1 status_1 "$PODMAN_PS_TIMEOUT_SECONDS" \
    podman ps -a

  # Wait 10 seconds to allow vfkit/gvproxy instability to appear
  sleep 10

  # Second ps probe
  capture_command_with_timeout ps_probe_2 status_2 "$PODMAN_PS_TIMEOUT_SECONDS" \
    podman ps -a

  # Machine list probe
  capture_command machine_list_probe status_list \
    podman machine list --format json

  # Diagnose: if first works but second fails, runtime became unstable
  if [[ $status_1 -eq 0 && $status_2 -ne 0 ]]; then
    FAILURES=$((FAILURES + 1))
    log_troubleshoot "AppleHV/Podman runtime lifecycle failure (API works then fails)"
    printf '    next: vfkit or gvproxy may have exited after initial boot\n'
    printf '    next: inspect the vfkit and gvproxy logs:\n'

    local tmpdir_base
    tmpdir_base="$(trim_trailing_slash "${TMPDIR:-/private/var/folders}")"
    printf '      tail -100 %s/podman/%s.log\n' "$tmpdir_base" "$machine_name"
    printf '      tail -100 %s/podman/gvproxy.log\n' "$tmpdir_base"

    printf '    next: after reviewing logs, run: podman_troubleshoot --fix --force\n'
    printf '    next: only if the machine still cannot stay running, see docs/PLAN-podman-container-egress-handoff.md for rebuild steps\n'
    return 0
  fi

  if [[ $status_1 -eq 0 && $status_2 -eq 0 ]]; then
    log_ok "machine API is stable (podman ps succeeded at T+0s and T+10s)"
    return 0
  fi

  if [[ $status_1 -ne 0 && $status_2 -ne 0 ]]; then
    log_action "machine API is not responding at either probe time"
    printf '    next: run: podman machine start\n'
    return 0
  fi

  log_action "machine stability check inconclusive"
}

check_vm_registry_ips() {
  log_section "VM Registry IP Probes"

  local output=""
  local status=0

  if [[ "$VERBOSE_MODE" == "1" ]]; then
    log_verbose "probing registry-1.docker.io by resolved IP inside the VM (timeout ${VM_REGISTRY_IP_PROBE_TIMEOUT_SECONDS}s)"
  fi

  # shellcheck disable=SC2016
  capture_command_with_timeout \
    output \
    status \
    "$VM_REGISTRY_IP_PROBE_TIMEOUT_SECONDS" \
    podman machine ssh 'for ip in $(getent hosts registry-1.docker.io | awk "{print \$1}"); do echo "== ${ip} =="; curl -I --connect-timeout 8 --max-time 12 --resolve registry-1.docker.io:443:${ip} https://registry-1.docker.io/v2/ || true; echo; done'

  if [[ $status -eq 0 ]] && ! podman_error_output "$output"; then
    log_ok "VM IP-level probes to registry-1.docker.io completed"
    return 0
  fi

  FAILURES=$((FAILURES + 1))
  if [[ $status -eq 124 ]]; then
    log_troubleshoot "VM IP-level probes to registry-1.docker.io timed out"
    printf '    next: rerun after the VM is responsive, or raise PODMAN_TROUBLESHOOT_VM_REGISTRY_IP_PROBE_TIMEOUT_SECONDS if you need a longer network probe window\n'
  else
    log_troubleshoot "VM IP-level probes to registry-1.docker.io failed"
    printf "    next: run: podman machine ssh 'getent hosts registry-1.docker.io'\n"
  fi

  show_detail "$output"
}

check_vm_runtime_state() {
  log_section "VM Runtime State"

  # shellcheck disable=SC2016
  run_check \
    "VM boot ID is readable" \
    "troubleshoot" \
    "could not read VM boot ID" \
    "run: podman machine ssh 'cat /proc/sys/kernel/random/boot_id'" \
    podman machine ssh 'printf "boot_id=%s\n" "$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)"'

  run_check \
    "VM runtime directories are readable" \
    "troubleshoot" \
    "could not inspect /run/containers/storage or /run/libpod in the VM" \
    "run: podman machine ssh 'ls -ld /run/containers/storage /run/libpod'" \
    podman machine ssh 'ls -ld /run/containers/storage /run/libpod'
}

check_registry_auth_state() {
  log_section "Registry Auth State"

  if [[ -f "$HOME/.docker/config.json" ]]; then
    run_check \
      "docker auth config is readable" \
      "troubleshoot" \
      "docker auth config exists but could not be read" \
      "run: grep -n 'docker.io\\|registry-1.docker.io\\|auths\\|credsStore\\|credHelpers' ~/.docker/config.json" \
      grep -n 'docker.io\|registry-1.docker.io\|auths\|credsStore\|credHelpers' "$HOME/.docker/config.json"
  else
    log_ok "$HOME/.docker/config.json not found; no Docker auth override to inspect"
  fi
}

check_pull_target_image() {
  log_section "Target Image Pull"

  local test_image="${IMAGE_NAME:-docker.io/library/alpine:latest}"
  local quay_test_image="quay.io/libpod/alpine:latest"
  local status=0

  if have_command docker; then
    if docker pull --quiet "$test_image" >/dev/null 2>&1; then
      log_ok "\`docker pull $test_image\`"
    else
      FAILURES=$((FAILURES + 1))
      log_troubleshoot "\`docker pull $test_image\` failed"
      printf '    next: \`docker --log-level=debug pull %s\`\n' "$test_image"
    fi
  fi

  if podman pull --quiet "$test_image" >/dev/null 2>&1; then
    log_ok "\`podman pull $test_image\`"
  else
    FAILURES=$((FAILURES + 1))
    log_troubleshoot "\`podman pull $test_image\` failed"
    printf '    next: \`podman --log-level=debug pull %s\`\n' "$test_image"
  fi

  if podman machine ssh "podman pull --quiet $quay_test_image" >/dev/null 2>&1; then
    log_ok "\`podman pull $quay_test_image\` (VM)"
  else
    FAILURES=$((FAILURES + 1))
    log_troubleshoot "\`podman pull $quay_test_image\` failed (VM)"
    printf '    next: \`podman machine ssh '"'"'podman pull %s'"'"'\`\n' "$quay_test_image"
  fi
}

print_recovery_hints() {
  log_section "Recovery Hints"
  if [[ $FAILURES -eq 0 ]]; then
    log_ok "all checks passed"
    return 0
  fi

  log_action "$FAILURES check(s) need attention"

  # Show specific next step for critical failures
  if [[ $LOG_EMERGENCY_FAILURES -ge 1 ]]; then
    printf '\n🚨 CRITICAL: VM booted into initramfs emergency mode\n'
    printf '    After backing up important data from inside the VM (VM-local images, volumes), rebuild:\n'
    printf '      podman machine stop\n'
    printf '      podman machine rm -f podman-machine-default\n'
    printf '      podman machine init\n'
    printf '      podman machine start\n'
    printf '      podman_troubleshoot --fix\n'
    return 0
  elif [[ $LOG_HEALTH_FAILURES -ge 1 ]]; then
    printf '\n⚠️  VM log shows I/O errors from systemd-journald\n'
    printf '    After backing up important data from inside the VM, rebuild:\n'
    printf '      podman machine stop\n'
    printf '      podman machine rm -f podman-machine-default\n'
    printf '      podman machine init\n'
    printf '      podman machine start\n'
    printf '      podman_troubleshoot --fix\n'
    return 0
  fi

  # Dynamic hints based on failures
  printf '\nNext steps:\n\n'

  printf '1. `bin/podman_troubleshoot --fix`\n\n'

  printf '2. Verify: `podman ps` && `podman info` && `podman system connection list`\n\n'

  printf '3. Test Docker-label routing: `bin/docker_socket_rootless_test --port 8080`\n\n'

  printf '4. Export for Docker clients: `export DOCKER_HOST="unix://${HOME}/.local/share/containers/podman/machine/podman.sock"`\n\n'

  printf '5. Allow port 443: `podman-allow-port-443`\n\n'

  printf '6. Inspect vfkit log: `tail -100 $TMPDIR/podman/podman-machine-default.log`\n\n'

  printf '7. Check machine alignment: `podman machine list && podman system connection list`\n'
}

check_vm_clock_sync() {
  log_section "VM Clock Sync"

  local host_epoch=""
  local vm_epoch=""
  local vm_date=""
  local drift=0

  host_epoch="$(date +%s)"

  local ssh_output=""
  local ssh_status=0
  # shellcheck disable=SC2016
  capture_command_with_timeout ssh_output ssh_status 15 \
    podman machine ssh 'printf "%s %s\n" "$(date +%s)" "$(date)"'

  if [[ $ssh_status -eq 124 || -z "$ssh_output" ]]; then
    log_action "VM did not respond in time; skipping clock drift check"
    printf '    next: run: podman machine ssh date\n'
    return 0
  fi

  vm_epoch="$(printf '%s\n' "$ssh_output" | awk '{print $1}')"
  vm_date="$(printf '%s\n' "$ssh_output" | cut -d' ' -f2-)"

  if [[ -z "$vm_epoch" || ! "$vm_epoch" =~ ^[0-9]+$ ]]; then
    log_action "could not parse VM clock output; skipping drift check"
    show_detail "$ssh_output"
    return 0
  fi

  drift=$(( vm_epoch - host_epoch ))
  if (( drift < 0 )); then drift=$(( -drift )); fi

  printf 'host time: %s\n' "$(date)"
  printf 'vm time:   %s\n' "$vm_date"
  printf 'drift:     %ss\n' "$drift"

  if (( drift <= VM_CLOCK_DRIFT_THRESHOLD_SECONDS )); then
    log_ok "VM clock is in sync with host (drift ${drift}s)"
    return 0
  fi

  FAILURES=$((FAILURES + 1))
  log_troubleshoot "VM clock is out of sync with host (drift ${drift}s)"
  printf '    next: this is common after host hibernation — the VM clock freezes while NTP slews slowly\n'
  printf '    next: force an immediate NTP step correction inside the VM:\n'
  printf '      podman machine ssh '"'"'sudo chronyc makestep'"'"'\n'
  printf '    next: or run: podman_troubleshoot --fix  (applies makestep automatically)\n'
  printf '    next: to prevent this after future hibernations, run: podman-install-wake-handler\n'
}

run_main() {
  require_podman
  parse_args "$@"

  if [[ "$INIT_MODE" == "1" ]]; then
    run_init_mode
    return $?
  fi

  if [[ "$FIX_MODE" == "1" ]]; then
    run_fix_mode
    return $?
  fi

  check_podman_socket_connection
  check_local_client_versions
  check_podman_system_container
  check_host_loopback_443
  check_global_docker_socket
  check_docker_socket_rootless
  check_podman_machine_list
  check_podman_machine_inspect
  check_podman_machine_alignment
  check_podman_machine_running_state
  check_machine_stability
  check_vm_clock_sync
  check_rootless_privileged_port_policy
  check_machine_start_lock
  check_machine_log_health
  check_engine_info
  check_system_connections
  check_host_registry_connectivity
  check_vm_dns_and_registry
  check_container_https_egress
  check_vm_registry_ips
  check_vm_runtime_state
  check_registry_auth_state
  check_pull_target_image
  print_recovery_hints
}

run_main "$@"
