check_podman_machine_alignment() {
  if ! have_jq; then
    log_action "jq not installed; skipping alignment check"
    printf '    next: install jq to verify machine/connection alignment\n'
    return 0
  fi

  local output=""
  local status=0
  capture_command output status podman_machine_inventory_report

  if [[ $status -eq 0 ]] && ! printf '%s\n' "$output" | grep -Eq 'Error:|Cannot connect to Podman|operation not permitted|vfkit exited unexpectedly'; then
    log_ok "\`podman machine\` and \`podman system connection\` aligned"
  else
    FAILURES=$((FAILURES + 1))
    log_troubleshoot "machine/connection mismatch"
    printf '    next: \`bin/podman_troubleshoot --fix\`\n'
  fi

  show_detail "$output"
}

check_podman_machine_running_state() {

  if ! have_jq; then
    log_action "jq is not installed; running-state checks were skipped"
    printf '    next: install jq and re-run %s\n' "$SCRIPT_NAME"
    return 0
  fi

  local output=""
  local status=0
  capture_command output status podman_machine_running_state_report

  if printf '%s\n' "$output" | grep -Eq 'starting: true|state: starting'; then
    FAILURES=$((FAILURES + 1))
    log_troubleshoot "default Podman machine is still starting"
    printf '    next: wait for startup to complete, or inspect the vfkit log if it never becomes running\n'
  elif printf '%s\n' "$output" | grep -Eq 'running: true|state: running'; then
    log_ok "default Podman machine is running"
  elif printf '%s\n' "$output" | grep -Eq 'running: false|state: stopped'; then
    FAILURES=$((FAILURES + 1))
    log_troubleshoot "machine stopped"
    if [[ "$FIX_MODE" == "1" ]]; then
      printf '    next: starting machine (see below)\n'
    else
      printf '    next: `bin/podman_troubleshoot --fix` to start\n'
    fi
  elif printf '%s\n' "$output" | grep -Eq 'state: <unknown>|Error:|default machine: <none>'; then
    log_action "Podman machine state could not be confirmed"
    printf '    next: run: podman machine info\n'
    printf '    next: run: podman machine list\n'
  else
    FAILURES=$((FAILURES + 1))
    log_troubleshoot "default Podman machine is not running"
    if [[ "$FIX_MODE" == "1" ]]; then
      printf '    next: run will start the machine below\n'
    else
      printf '    next: to start the machine, run: bin/podman_troubleshoot --fix\n'
    fi
  fi

  show_detail "$output"
}

check_rootless_privileged_port_policy() {
  log_section "Rootless Privileged Port Policy"

  if ! have_jq; then
    log_action "jq is not installed; privileged-port policy checks were skipped"
    printf '    next: install jq and re-run %s\n' "$SCRIPT_NAME"
    return 0
  fi

  local machine_name=""
  local rootful=""
  local output=""
  local status=0

  machine_name="$(podman_current_machine_name || true)"
  if [[ -z "$machine_name" ]]; then
    log_action "no Podman machine could be resolved; skipping privileged-port policy inspection"
    printf '    next: run: podman machine list\n'
    return 0
  fi

  rootful="$(podman_control machine inspect "$machine_name" --format '{{.Rootful}}' 2>/dev/null || true)"
  if [[ "$rootful" == "true" ]]; then
    log_ok "machine is rootful; rootless port 443 policy is not required"
    printf '    next: if you switch back to rootless mode, rerun %s to confirm port 443 is still allowed\n' "$SCRIPT_NAME"
    return 0
  fi

  if ! podman_machine_running "$machine_name"; then
    log_action "machine is not running; skipping privileged-port policy inspection"
    printf '    next: start the machine first, then rerun %s to confirm host port 443 is allowed for rootless containers\n' "$SCRIPT_NAME"
    return 0
  fi

  capture_command output status privileged_port_policy_report

  if [[ $status -eq 0 ]] && printf '%s\n' "$output" | grep -q 'rootless host port 443: allowed'; then
    log_ok "rootless host port 443 is allowed inside the Podman VM"
  else
    FAILURES=$((FAILURES + 1))
    log_troubleshoot "rootless host port 443 is still blocked inside the Podman VM"
    printf '    next: run podman-allow-port-443, or rerun %s --fix to apply it automatically\n' "$SCRIPT_NAME"
    printf '    next: this is the setting behind: rootlessport cannot expose privileged port 443\n'
  fi

  show_detail "$output"
}

check_machine_start_lock() {
  log_section "Machine Start Lock"

  local lock_file="$HOME/.local/share/containers/podman/machine/machine-start.lock"
  if [[ ! -e "$lock_file" ]]; then
    log_ok "machine-start.lock is not present"
    return 0
  fi

  local output=""
  local status=0
  capture_command output status podman_machine_start_lock_report "$lock_file"

  if [[ $status -eq 0 ]]; then
    log_ok "machine-start.lock permissions look normal"
  else
    FAILURES=$((FAILURES + 1))
    log_troubleshoot "machine-start.lock is not in the expected state"
    printf '    next: if podman machine start still fails, inspect or remove the stale lock file before retrying\n'
  fi

  show_detail "$output"
}

check_machine_log_health() {
  log_section "Machine Log Health"

  local default_machine
  local current_machine
  local machine_name

  default_machine="$(podman_default_machine_name || true)"
  current_machine="$(podman_current_machine_name || true)"
  machine_name="$default_machine"
  if [[ -z "$machine_name" ]]; then
    machine_name="$current_machine"
  fi

  if [[ -z "$machine_name" ]]; then
    log_action "no machine could be resolved; skipping VM log inspection"
    return 0
  fi

  if [[ -z "$default_machine" && -n "$current_machine" ]]; then
    printf '    note: using current machine %s for log inspection because no default machine is configured\n' "$current_machine"
  fi

  local tmpdir_base
  tmpdir_base="$(trim_trailing_slash "${TMPDIR:-/private/var/folders}")"
  local log_file="${tmpdir_base}/podman/${machine_name}.log"
  if [[ ! -f "$log_file" ]]; then
    log_action "machine log was not found at $log_file"
    printf '    next: rerun after starting the machine so vfkit can write its log\n'
    return 0
  fi

  local output=""
  local status=0
  capture_command output status podman_machine_log_health_report "$log_file"

  if [[ $status -eq 0 ]] && ! printf '%s\n' "$output" | grep -Eqi 'Input/output error|operation not permitted|vfkit exited unexpectedly|failed to claim the global docker sock|failed to rotate|failed to open|Ignition has failed|Entering emergency mode|Press Enter for system maintenance'; then
    log_ok "vfkit log does not show obvious startup errors"
  else
    FAILURES=$((FAILURES + 1))
    LOG_HEALTH_FAILURES=$((LOG_HEALTH_FAILURES + 1))
    if printf '%s\n' "$output" | grep -qi 'Input/output error'; then
      log_action "vfkit log shows repeated journald I/O errors"
      printf '    next: back up anything important from inside the VM first; this recreates the machine and discards VM-local customizations, images, volumes, and container state:\n'
      printf '      podman_troubleshoot --fix\n'
      printf '      podman machine stop\n'
      printf '      podman machine rm -f %s\n' "$machine_name"
      printf '      podman machine init\n'
      printf '      podman machine start\n'
      printf '      podman_troubleshoot --fix\n'
      printf '    next: then rerun %s to verify the fix\n' "$SCRIPT_NAME"
    elif printf '%s\n' "$output" | grep -Eqi 'Ignition has failed|Entering emergency mode|Press Enter for system maintenance'; then
      LOG_EMERGENCY_FAILURES=$((LOG_EMERGENCY_FAILURES + 1))
      log_action "vfkit log shows the VM booted into emergency mode"
      printf '    next: inspect the failed boot details in %s before rebuilding if you need to preserve evidence\n' "$log_file"
      printf '    next: after backing up anything important from inside the VM, rebuild it because startup is blocked in initramfs emergency mode:\n'
      printf '      podman machine stop\n'
      printf '      podman machine rm -f %s\n' "$machine_name"
      printf '      podman machine init\n'
      printf '      podman machine start\n'
      printf '      podman_troubleshoot --fix\n'
      printf '    next: then rerun %s to verify the fix\n' "$SCRIPT_NAME"
    else
      log_troubleshoot "vfkit log contains startup errors"
      printf '    next: inspect the highlighted log lines above\n'
      printf '    next: if start fails with vfkit exit 1, rebuild the machine after preserving anything important\n'
    fi
  fi

  show_detail "$output"
}

check_engine_info() {
  log_section "Container Engine Info"

  if have_command docker; then
    run_check \
      "docker engine responded" \
      "troubleshoot" \
      "docker info failed" \
      "run: docker context ls && docker info" \
      docker info
  fi

  run_check \
    "podman engine responded" \
    "troubleshoot" \
    "podman info failed" \
    "run: podman machine start && podman info" \
    podman info
}

check_system_connections() {
  log_section "System Connections"

  if have_command docker; then
    run_check \
      "docker system connection list is readable" \
      "troubleshoot" \
      "docker system connection list failed" \
      "run: docker context ls" \
      docker system connection list
  fi

  run_check \
    "podman system connection list is readable" \
    "troubleshoot" \
    "podman system connection list failed" \
    "run: podman_control system connection list --format json" \
    podman_control system connection list
}

check_host_registry_connectivity() {
  log_section "Host Registry Connectivity"

  if ! have_command curl; then
    log_action "curl is not installed; host registry checks were skipped"
    printf '    next: install curl and re-run %s\n' "$SCRIPT_NAME"
    return 0
  fi

  run_check \
    "host can reach registry-1.docker.io" \
    "troubleshoot" \
    "host could not reach registry-1.docker.io" \
    "check VPN, proxy, firewall, or DNS on the host; rerun: curl -I --max-time 15 https://registry-1.docker.io/v2/" \
    curl -I --max-time 15 https://registry-1.docker.io/v2/

  run_check \
    "host can reach auth.docker.io" \
    "troubleshoot" \
    "host could not reach auth.docker.io token endpoint" \
    "rerun: curl -I --max-time 15 'https://auth.docker.io/token?service=registry.docker.io&scope=repository:library/postgres:pull'" \
    curl -I --max-time 15 "https://auth.docker.io/token?service=registry.docker.io&scope=repository:library/postgres:pull"
}

