#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: strip-ansi [file ...]

Strip ANSI color escape sequences from stdin or one or more files.
EOF
}

strip_ansi() {
  sed -E $'s/\x1B\\[[0-9;]*m//g'
}

run_main() {
  case "${1:-}" in
    -h|--help)
      usage
      exit 0
      ;;
  esac

  if [[ $# -gt 0 ]]; then
    cat -- "$@" | strip_ansi
    return
  fi

  if [[ -t 0 ]]; then
    usage >&2
    exit 1
  fi

  strip_ansi
}

run_main "$@"
