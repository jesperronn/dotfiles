#!/usr/bin/env python3
"""copilot_shortlist — rank GitHub Copilot sessions as good / bad / outlier examples for a talk.

Standalone and local-only: no LLM calls, no tokens spent. Streams each session's events.jsonl once.

Usage: copilot_shortlist [--root DIR] [--since YYYY-MM-DD] [--project SUBSTR] [--include-bench]
                         [--bucket bad|good|outlier|all] [--top N] [--min-turns N]
                         [--format table|tsv|json] [--copy DIR] [--recurring N]
--copy DIR copies each listed session (workspace.yaml + events.jsonl) to DIR/<id>/.
"""
import argparse
import json
import os
import re
import shutil
import sys
from collections import Counter

DEFAULT_ROOT = "~/.copilot/session-state"
BENCH_MARKERS = ("local-model-evaluator-bench", "local-model-editor-claud", "/private/tmp", "/private/var/folders")

_TYPE_RE = re.compile(r'^\{"type":"([^"]+)"')
_TS_RE = re.compile(r'"timestamp":"([^"]+)"')
_PARSED = {"user.message", "tool.execution_start", "session.shutdown", "session.usage_record"}

# user turns that read as "you got it wrong / you ignored me" (English + Danish)
CORRECTION_RE = re.compile(
    r"\b(no[,.!]|nope|don'?t|do not|stop|wrong|i said|i told you|again|still|instead|not what|you forgot|"
    r"you missed|revert|undo|why did you|that'?s not|nej|ikke|forkert|stadig|igen|jeg sagde|fortryd|hvorfor)\b",
    re.I)
IDLE_GAP_SECONDS = 600
SENTENCE_RE = re.compile(r"[^.!?\n]{15,200}")


def project_name(cwd):
    """Short project name from a cwd: last path part, with a worktree suffix (-wt) folded into its repo."""
    name = os.path.basename(cwd.rstrip("/")) or "/"
    return name[:-3] if name.endswith("-wt") and len(name) > 3 else name


def words(text):
    return re.findall(r"\w+", text.lower())


def jaccard(a, b):
    return len(a & b) / len(a | b) if a and b else 0.0


def parse_yaml_cwd(path):
    meta = {}
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                m = re.match(r"^(cwd|client_name|created_at):\s*(.*)$", line)
                if m:
                    meta[m.group(1)] = m.group(2).strip()
    except OSError:
        pass
    return meta


def tool_key(data):
    args = data.get("arguments")
    try:
        blob = json.dumps(args, sort_keys=True)
    except (TypeError, ValueError):
        blob = str(args)
    return (data.get("toolName"), blob[:300])


def analyze_session(path, sid):
    """Return one metrics dict for a session directory, or None when it has no events."""
    events = os.path.join(path, "events.jsonl")
    if not os.path.isfile(events):
        return None
    meta = parse_yaml_cwd(os.path.join(path, "workspace.yaml"))
    m = {
        "id": sid, "path": path, "project": meta.get("cwd", ""), "client": meta.get("client_name", ""),
        "started": meta.get("created_at", ""), "first_prompt": "", "user_msgs": [], "turns": 0,
        "tool_calls": 0, "tool_errors": 0, "perm_requests": 0, "aborts": 0, "session_errors": 0,
        "compactions": 0, "skills": 0, "subagents": 0, "shutdowns": 0, "shutdown_types": Counter(),
        "premium": 0.0, "lines_added": 0, "lines_removed": 0, "files_modified": 0,
        "tokens_out": 0, "tokens_in": 0, "tokens_cache": 0, "usage_out": 0, "usage_in": 0,
        "active_sec": 0.0, "first_ts": None, "last_ts": None, "last_type": None, "model": "",
    }
    calls = Counter()
    prev = None
    with open(events, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            t = _TYPE_RE.match(line)
            if not t:
                continue
            etype = t.group(1)
            ts = _TS_RE.search(line, max(0, len(line) - 200))
            if ts:
                m["first_ts"] = m["first_ts"] or ts.group(1)
                m["last_ts"] = ts.group(1)
                now = to_epoch(ts.group(1))
                if now is not None:
                    if prev is not None and 0 < now - prev <= IDLE_GAP_SECONDS:
                        m["active_sec"] += now - prev
                    prev = now
            if etype not in ("hook.start", "hook.end"):
                m["last_type"] = etype
            if etype == "assistant.turn_start":
                m["turns"] += 1
            elif etype == "permission.requested":
                m["perm_requests"] += 1
            elif etype == "abort":
                m["aborts"] += 1
            elif etype == "session.error":
                m["session_errors"] += 1
            elif etype == "session.compaction_complete":
                m["compactions"] += 1
            elif etype == "skill.invoked":
                m["skills"] += 1
            elif etype == "subagent.started":
                m["subagents"] += 1
            elif etype == "tool.execution_complete":
                if '"success":false' in line:
                    m["tool_errors"] += 1
            elif etype in _PARSED:
                try:
                    data = json.loads(line).get("data") or {}
                except ValueError:
                    continue
                if etype == "user.message":
                    content = data.get("content")
                    if isinstance(content, str):
                        m["user_msgs"].append(content)
                elif etype == "tool.execution_start":
                    m["tool_calls"] += 1
                    calls[tool_key(data)] += 1
                    m["model"] = data.get("model") or m["model"]
                elif etype == "session.usage_record":
                    u = data.get("usage") or {}
                    m["usage_out"] += u.get("outputTokens") or 0
                    m["usage_in"] += u.get("inputTokens") or 0
                elif etype == "session.shutdown":
                    m["shutdowns"] += 1
                    m["shutdown_types"][str(data.get("shutdownType"))] += 1
                    m["premium"] += data.get("totalPremiumRequests") or 0
                    td = data.get("tokenDetails") or {}
                    tok = lambda k: (td.get(k) or {}).get("tokenCount") or 0  # noqa: E731
                    m["tokens_out"] += tok("output")
                    m["tokens_in"] += tok("input")
                    m["tokens_cache"] += tok("cache_read") + tok("cache_write")
                    cc = data.get("codeChanges") or {}
                    m["lines_added"] += cc.get("linesAdded") or 0
                    m["lines_removed"] += cc.get("linesRemoved") or 0
                    files = cc.get("filesModified")
                    m["files_modified"] += len(files) if isinstance(files, list) else 0
    if m["shutdowns"] == 0:  # crashed/open session: fall back to usage records
        m["tokens_out"], m["tokens_in"] = m["usage_out"], m["usage_in"]
    m["user_turns"] = len(m["user_msgs"])
    m["first_prompt"] = (m["user_msgs"][0] if m["user_msgs"] else "").strip().splitlines()[0][:100] if m["user_msgs"] and m["user_msgs"][0].strip() else ""
    m["duration_min"] = m["active_sec"] / 60  # active time: gaps over 10 min (left-open IDE sessions) excluded
    m["max_repeat"] = max(calls.values()) if calls else 0
    m["loops"] = sum(1 for k, n in calls.items() if n >= 4 and k[0] not in ("skill", "report_intent"))
    follow = m["user_msgs"][1:]  # first message is usually a pasted plan/spec; don't flag it
    m["corrections"] = sum(1 for u in follow if len(u) < 600 and CORRECTION_RE.search(u))
    m["reprompts"] = near_duplicates(follow)
    m["tokens_total"] = m["tokens_out"] + m["tokens_in"]
    return m


def to_epoch(ts):
    from datetime import datetime
    try:
        return datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def near_duplicates(msgs):
    """Count user messages that restate an earlier user message in the same session (word-set Jaccard >= 0.6)."""
    sets = [set(words(u)) for u in msgs if len(words(u)) >= 5]
    return sum(1 for i, s in enumerate(sets) if any(jaccard(s, p) >= 0.6 for p in sets[:i]))


def percentile_cut(values, pct):
    vals = sorted(values)
    return vals[int(len(vals) * pct)] if vals else 0


def score(sessions):
    """Attach bad/good/outlier scores and labels in place."""
    cut = {k: percentile_cut([s[k] for s in sessions], 0.95)
           for k in ("tokens_total", "duration_min", "turns", "tool_calls", "premium")}
    for s in sessions:
        err_rate = s["tool_errors"] / s["tool_calls"] if s["tool_calls"] else 0.0
        s["err_rate"] = err_rate
        crashed = s["shutdowns"] == 0
        abandoned = s["last_type"] in ("user.message", "abort") or s["aborts"] > 0 and s["lines_added"] == 0
        perm_heavy = s["perm_requests"] >= 30
        labels = []
        bad = 0.0
        bad += min(s["tool_errors"], 30) * 0.5 + (err_rate * 20 if s["tool_calls"] >= 10 else 0)
        bad += s["loops"] * 4 + min(s["corrections"], 8) * 3 + min(s["reprompts"], 6) * 4
        bad += s["aborts"] * 3 + s["session_errors"] * 3 + (6 if crashed else 0) + (5 if abandoned else 0)
        bad += s["compactions"] * 2 + (3 if perm_heavy else 0)
        if s["tokens_total"] >= cut["tokens_total"] and s["lines_added"] == 0:
            bad += 8
            labels.append("burn-no-edits")
        if s["reprompts"]:
            labels.append(f"repeated-instruction x{s['reprompts']}")
        if s["corrections"]:
            labels.append(f"user-corrections x{s['corrections']}")
        if s["loops"]:
            labels.append(f"tool-loop x{s['loops']} (max {s['max_repeat']})")
        if err_rate >= 0.2 and s["tool_calls"] >= 10:
            labels.append(f"error-rate {err_rate:.0%}")
        if s["aborts"]:
            labels.append(f"aborted x{s['aborts']}")
        if crashed:
            labels.append("no-shutdown")
        if abandoned:
            labels.append("abandoned")
        if s["compactions"]:
            labels.append(f"compacted x{s['compactions']}")
        if perm_heavy:
            labels.append(f"permission-prompts {s['perm_requests']}")
        if s["session_errors"]:
            labels.append(f"session-errors x{s['session_errors']}")

        good = 0.0
        if not crashed and not abandoned:
            good += 6
        if s["lines_added"] > 0:
            good += 6
        if s["user_turns"] <= 3:
            good += 4
        if s["tool_calls"] >= 5:
            good += 3
        good += min(s["lines_added"], 300) / 60 + min(s["tool_calls"], 40) / 10  # tie-break: real work done
        if s["lines_added"] < 10 or s["tool_calls"] < 10:
            good -= 6  # trivial one-liners make poor talk examples
        good -= bad * 0.7
        if good > 8 and s["lines_added"] >= 10 and bad < 4:
            labels.append("clean-run")

        out = 0.0
        for key, tag in (("tokens_total", "outlier-tokens"), ("duration_min", "outlier-duration"),
                         ("turns", "outlier-turns"), ("tool_calls", "outlier-tool-calls"),
                         ("premium", "outlier-premium")):
            if s[key] >= cut[key] and s[key] > 0:
                out += 3
                labels.append(tag)
        if s["subagents"] >= 3:
            out += 2
            labels.append(f"subagents x{s['subagents']}")
        if s["lines_added"] >= 2000:
            out += 2
            labels.append(f"big-diff +{s['lines_added']}")
        s["bad"], s["good"], s["outlier"] = round(bad, 1), round(good, 1), round(out, 1)
        s["labels"] = labels[:8]


def recurring_instructions(sessions, min_sessions):
    """Sentences users type in follow-up messages across several sessions: unspoken requirements."""
    seen = {}
    for s in sessions:
        for u in s["user_msgs"][1:]:
            if len(u) > 800:
                continue
            for sent in SENTENCE_RE.findall(u):
                key = " ".join(words(sent))
                if len(key.split()) >= 4:
                    seen.setdefault(key, set()).add(s["id"])
    ranked = sorted(((len(v), k) for k, v in seen.items() if len(v) >= min_sessions), reverse=True)
    return ranked[:15]


def fmt_tok(n):
    return f"{n / 1e6:.1f}M" if n >= 1e6 else f"{n / 1e3:.0f}k" if n >= 1e3 else str(int(n))


def row(s):
    return [s["id"][:8], s["started"][:10], project_name(s["project"]), s["client"][-8:],
            str(s["user_turns"]), str(s["turns"]), f"{s['duration_min']:.0f}m", fmt_tok(s["tokens_total"]),
            f"{s['tool_errors']}/{s['tool_calls']}", f"+{s['lines_added']}/-{s['lines_removed']}",
            f"{s['bad']:g}", f"{s['good']:g}", f"{s['outlier']:g}", ", ".join(s["labels"]), s["first_prompt"]]


HEADER = ["id", "date", "project", "client", "usr", "turns", "dur", "tokens", "err/calls", "lines",
          "bad", "good", "outl", "labels", "first prompt"]


def render_table(rows):
    caps = {"labels": 120, "first prompt": 70}
    widths = [min(max(len(r[i]) for r in [HEADER] + rows), caps.get(HEADER[i], 40)) for i in range(len(HEADER))]
    out = []
    for r in [HEADER] + rows:
        out.append("  ".join(c[:widths[i]].ljust(widths[i]) for i, c in enumerate(r)).rstrip())
    return "\n".join(out)


def select(sessions, bucket, top):
    key = {"bad": "bad", "good": "good", "outlier": "outlier"}[bucket]
    return sorted(sessions, key=lambda s: s[key], reverse=True)[:top]


def copy_session(s, dest):
    target = os.path.join(dest, s["id"])
    os.makedirs(target, exist_ok=True)
    for name in ("workspace.yaml", "events.jsonl"):
        src = os.path.join(s["path"], name)
        if os.path.isfile(src):
            shutil.copy2(src, os.path.join(target, name))


def load(root, args):
    sessions = []
    for sid in sorted(os.listdir(root)):
        path = os.path.join(root, sid)
        if not os.path.isdir(path):
            continue
        meta = parse_yaml_cwd(os.path.join(path, "workspace.yaml"))
        project = meta.get("cwd", "")
        if not args.include_bench and any(b in project for b in BENCH_MARKERS):
            continue
        if args.project and os.path.expanduser(args.project) not in project:
            continue
        if args.since and meta.get("created_at", "")[:10] < args.since:
            continue
        s = analyze_session(path, sid)
        if s and s["turns"] >= args.min_turns:
            sessions.append(s)
    return sessions


def main(argv=None):
    p = argparse.ArgumentParser(prog="copilot_shortlist", description=__doc__.split("\n\n")[0])
    p.add_argument("--root", default=DEFAULT_ROOT)
    p.add_argument("--since")
    p.add_argument("--project", help="only sessions whose cwd contains this text")
    p.add_argument("--include-bench", action="store_true", help="include benchmark/sandbox sessions (excluded by default)")
    p.add_argument("--bucket", choices=("bad", "good", "outlier", "all"), default="all")
    p.add_argument("--top", type=int, default=12)
    p.add_argument("--min-turns", type=int, default=3, help="skip trivial sessions with fewer assistant turns")
    p.add_argument("--format", choices=("table", "tsv", "json"), default="table")
    p.add_argument("--copy", metavar="DIR", help="copy listed sessions' workspace.yaml + events.jsonl here")
    p.add_argument("--recurring", type=int, default=3, metavar="N",
                   help="list sentences repeated across >= N sessions (0 disables)")
    args = p.parse_args(argv)
    root = os.path.expanduser(args.root)
    if not os.path.isdir(root):
        print(f"copilot_shortlist: no such directory: {root}", file=sys.stderr)
        return 1
    sessions = load(root, args)
    if not sessions:
        print("copilot_shortlist: no sessions matched.", file=sys.stderr)
        return 1
    score(sessions)
    buckets = ["bad", "good", "outlier"] if args.bucket == "all" else [args.bucket]
    chosen = {b: select(sessions, b, args.top) for b in buckets}
    if args.format == "json":
        slim = {b: [{k: v for k, v in s.items() if k not in ("user_msgs", "shutdown_types")} for s in lst]
                for b, lst in chosen.items()}
        print(json.dumps(slim, indent=2, default=str))
    else:
        print(f"{len(sessions)} sessions analysed (bench excluded: {not args.include_bench})")
        for b, lst in chosen.items():
            print(f"\n== {b.upper()} ==")
            rows = [row(s) for s in lst]
            print(render_table(rows) if args.format == "table" else "\n".join("\t".join(r) for r in [HEADER] + rows))
        if args.recurring:
            rec = recurring_instructions(sessions, args.recurring)
            if rec:
                print(f"\n== RECURRING INSTRUCTIONS (typed in follow-ups across >= {args.recurring} sessions) ==")
                for n, sent in rec:
                    print(f"{n:>4}  {sent}")
    if args.copy:
        dest = os.path.expanduser(args.copy)
        ids = {s["id"]: s for lst in chosen.values() for s in lst}
        for s in ids.values():
            copy_session(s, dest)
        print(f"\ncopied {len(ids)} sessions to {dest}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
