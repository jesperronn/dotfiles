#!/usr/bin/env bash
# shellcheck shell=bash
#
# Purpose:
#   Format a JSON log file or stream via jq, extracting level, sequence,
#   message, stack trace, and timestamp fields into aligned columns.
#
# Usage:
#   bin/jqlog <file>           Read logs from a file.
#   echo "..." | bin/jqlog     Read logs from stdin.
#
# Options:
#   -h, --help                 Show this help and exit.
#
# Fields extracted (space-delimited):
#   .level  .sequence .message .stackTrace ."@timeStamp"
#
# Environment:
#   NO_COLOR              Not used (jqlog does not produce colors).
#
# Dependencies:
#   jq
#
# Notes:
#   If jq fails to parse a line, it prints the error to stderr and exits
#   non-zero; remaining lines are not formatted.
#   If no argument is given and stdin is not a terminal, it reads from stdin.

#

jqlog_usage() {
  cat <<'HELP'
Usage: bin/jqlog <file>           Read logs from a file.
       echo "..." | bin/jqlog     Read logs from stdin.

Options:
  -h, --help                       Show this help and exit.

Fields extracted (space-delimited):
  .level  .sequence .message .stackTrace ."@timeStamp"

Environment:
  NO_COLOR              Not used (jqlog does not produce colors).

Dependencies:
  jq

Notes:
  If jq fails to parse a line, it prints the error to stderr and exits
  non-zero; remaining lines are not formatted.
  If no argument is given and stdin is not a terminal, it reads from stdin.
HELP
}

for arg in "$@"; do
  if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
    jqlog_usage
    exit 0
  fi
done

jqlog() {
  JQ_FLAGS=("--raw-output" "--raw-output" "-a" "$@")
  # Only the first element is passed (existing behaviour; was unquoted ${JQ_FLAGS}).
  jq "${JQ_FLAGS[0]}" '"\(.level)  \(.sequence)  \(.message) \(.stackTrace) \(."@timeStamp")"'
}

# Check if a file is provided as an argument or if input is from stdin
if [ -t 0 ]; then
  # No input from stdin, read from file
  if [ -n "$1" ]; then
    cat "$1" | jqlog 
  else
    echo "Usage: $0 <file or stdin>"
    exit 1
  fi
else
  # Input from stdin
  jqlog "$@"
fi

