#!/usr/bin/env bash
# shellcheck disable=SC1090,SC1091,SC2155
set -euo pipefail

# npm-global-audit — report severity totals for every globally installed npm
# package. npm rejects `npm audit -g` (EAUDITGLOBAL), so we discover the
# top-level packages with `npm ls -g --depth=0 --json`, then for each
# name@version resolve that exact package into a disposable project and audit it
# there. No global package is ever changed; transitive dependencies are freshly
# resolved and are NOT the installed globally hoisted tree.

PROG="$(basename "$0")"

COLOR_MODE="auto"
COLOR_ENABLED=0
WORK_DIR=""
HAD_FAILURE=0
JOBS=""
TTY_ENABLED=0
TTY_COLUMNS=80
TTY_ROWS=24
TTY_SPEC_WIDTH=0
TTY_FULL_TABLE=1
TTY_DRAWN=0
TTY_BLOCK_LINES=0
AUTOWRAP_DISABLED=0
PROGRESS_TOTAL=0
PROGRESS_DONE=0
POLL_INTERVAL="${NPM_GLOBAL_AUDIT_POLL_INTERVAL:-0.05}"
OUTDATED_PID=""
OUTDATED_READY=0
RENDERED_LINE=""
TRUNCATED_TEXT=""

NAMES=()
VERSIONS=()
SPECS=()
JOB_DIRS=()
JOB_PIDS=()
JOB_ACTIVE=()
RESULT_KIND=()
RESULT_TOTAL=()
RESULT_LOW=()
RESULT_MODERATE=()
RESULT_HIGH=()
RESULT_CRITICAL=()
RESULT_ERROR=()
OUTDATED_NAMES=()
VULNERABLE_WITHOUT_UPDATE=()
declare -A LATEST_MAP=()
declare -A ADVISORY_TEXT=()

C_RESET=$'\033[0m'
C_GREEN=$'\033[32m'
C_YELLOW=$'\033[33m'
C_ORANGE=$'\033[38;5;208m'
C_RED=$'\033[31m'
C_DIM=$'\033[2m'

usage_short() {
  printf 'Usage: %s [--jobs N|--color|--no-color|--help]\n' "$PROG" >&2
}

print_help() {
  cat <<EOF
$PROG — report severity totals for every global npm package.

npm rejects "npm audit -g", so this command discovers top-level global packages
with "npm ls -g --depth=0 --json" and, for each name@version, resolves that exact
package into a temporary project and audits it there. Global packages are never
changed; freshly resolved transitive dependencies are reported and are NOT the
installed globally hoisted tree.

Usage:
  $PROG [--jobs N|--color|--no-color|--help]

Options:
  --jobs N        Audit up to N packages concurrently (default: max(CPUs, 8)).
  --color        Force colorized output.
  --no-color     Disable colorized output (also the default when stdout is not a TTY).
  -h, --help     Show this help.

Output:
  One aligned row per package: "name@version" followed by its severity totals.
  Exit status: 0 when every package reports valid metadata, 1 after any package
  failure, 2 for invalid options.
EOF
}

parse_opts() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --jobs)
        shift
        if [[ $# -eq 0 || ! "$1" =~ ^[1-9][0-9]*$ ]]; then
          printf '%s: --jobs requires a positive integer\n' "$PROG" >&2
          usage_short
          exit 2
        fi
        JOBS="$1"
        ;;
      --jobs=*)
        JOBS="${1#--jobs=}"
        if [[ ! "$JOBS" =~ ^[1-9][0-9]*$ ]]; then
          printf '%s: --jobs requires a positive integer\n' "$PROG" >&2
          usage_short
          exit 2
        fi
        ;;
      --color)
        COLOR_MODE="always"
        ;;
      --no-color)
        COLOR_MODE="never"
        ;;
      -h|--help)
        print_help
        exit 0
        ;;
      --)
        shift
        break
        ;;
      -*)
        printf '%s: unknown option: %s\n' "$PROG" "$1" >&2
        usage_short
        exit 2
        ;;
      *)
        printf '%s: unexpected argument: %s\n' "$PROG" "$1" >&2
        usage_short
        exit 2
        ;;
    esac
    shift
  done
}

default_jobs() {
  local processors=""
  processors="$(getconf _NPROCESSORS_ONLN 2>/dev/null || true)"
  if [[ ! "$processors" =~ ^[1-9][0-9]*$ ]]; then
    processors="$(sysctl -n hw.ncpu 2>/dev/null || true)"
  fi
  if [[ ! "$processors" =~ ^[1-9][0-9]*$ ]]; then
    processors=8
  fi
  if (( processors < 8 )); then
    processors=8
  fi
  printf '%s' "$processors"
}

enable_color() {
  case "$COLOR_MODE" in
    always)
      COLOR_ENABLED=1
      ;;
    never)
      COLOR_ENABLED=0
      ;;
    *)
      if [[ -n "${NO_COLOR:-}" ]]; then
        COLOR_ENABLED=0
      elif command -v tput >/dev/null 2>&1 && [[ -t 1 ]]; then
        COLOR_ENABLED=1
      else
        COLOR_ENABLED=0
      fi
      ;;
  esac
}

truncate_plain_text() {
  local text="$1" max_width="$2"
  if (( max_width <= 0 )); then
    TRUNCATED_TEXT=""
  elif (( ${#text} <= max_width )); then
    TRUNCATED_TEXT="$text"
  elif (( max_width == 1 )); then
    TRUNCATED_TEXT="…"
  else
    TRUNCATED_TEXT="${text:0:max_width-1}…"
  fi
}

# Terminal width/height detection. When neither the env overrides nor a real
# terminal query can tell us the actual size (e.g. $TERM unset), fall back to
# 110 columns instead of the historical 80 — most terminals today are wider
# than 80, and 110 gives long npm messages more room without depending on
# exact detection.
#
# `tput cols`/`tput lines` query the window size via an ioctl on their own
# stdout. Called from `$(...)` (as this script does, to capture the value),
# that stdout is a pipe, not the terminal, so the ioctl fails and (at least
# on macOS's /usr/bin/tput) it silently falls back to a terminfo default of
# 80 — even though $COLUMNS in the interactive shell is correct. `stty size`
# instead queries via its *stdin*, which we can point at /dev/tty explicitly
# regardless of where stdout is going, so it stays reliable inside a command
# substitution. Try that first; fall back to `tput` (useful when /dev/tty
# isn't available but stdout genuinely is the terminal) only if it fails.
detect_tty_layout() {
  local spec_width="$1"
  local env_columns="${NPM_GLOBAL_AUDIT_TTY_COLUMNS:-}"
  local env_rows="${NPM_GLOBAL_AUDIT_TTY_ROWS:-}"
  local columns="$env_columns" rows="$env_rows" max_spec_width result_width=24
  local stty_out=""
  if [[ ! "$columns" =~ ^[1-9][0-9]*$ || ! "$rows" =~ ^[1-9][0-9]*$ ]]; then
    stty_out="$(stty size </dev/tty 2>/dev/null)" || true
    if [[ "$stty_out" =~ ^([0-9]+)\ ([0-9]+)$ ]]; then
      local stty_rows="${BASH_REMATCH[1]}" stty_columns="${BASH_REMATCH[2]}"
      [[ "$rows" =~ ^[1-9][0-9]*$ ]] || rows="$stty_rows"
      [[ "$columns" =~ ^[1-9][0-9]*$ ]] || columns="$stty_columns"
    fi
  fi
  if [[ ! "$columns" =~ ^[1-9][0-9]*$ ]]; then
    columns="$(tput cols 2>/dev/null || true)"
  fi
  if [[ ! "$rows" =~ ^[1-9][0-9]*$ ]]; then
    rows="$(tput lines 2>/dev/null || true)"
  fi
  [[ "$columns" =~ ^[1-9][0-9]*$ ]] || columns=110
  [[ "$rows" =~ ^[1-9][0-9]*$ ]] || rows=24
  TTY_COLUMNS="$columns"
  TTY_ROWS="$rows"
  TTY_FULL_TABLE=1
  if (( PROGRESS_TOTAL + 2 > TTY_ROWS )); then
    TTY_FULL_TABLE=0
  fi
  if (( TTY_COLUMNS - 2 < result_width + 1 )); then
    result_width=7
  fi
  max_spec_width=$((TTY_COLUMNS - 2 - result_width))
  (( max_spec_width > 0 )) || max_spec_width=1
  TTY_SPEC_WIDTH="$spec_width"
  (( TTY_SPEC_WIDTH <= max_spec_width )) || TTY_SPEC_WIDTH="$max_spec_width"
}

compose_tty_plain_line() {
  local spec="$1" text="$2" spec_text result_width
  truncate_plain_text "$spec" "$TTY_SPEC_WIDTH"
  spec_text="$TRUNCATED_TEXT"
  result_width=$((TTY_COLUMNS - TTY_SPEC_WIDTH - 2))
  truncate_plain_text "$text" "$result_width"
  printf -v RENDERED_LINE '%-*s  %s' "$TTY_SPEC_WIDTH" "$spec_text" "$TRUNCATED_TEXT"
}

compose_tty_result_line() {
  local spec="$1" total="$2" low="$3" moderate="$4" high="$5" critical="$6" text="$7"
  local spec_text result_text colored result_width
  truncate_plain_text "$spec" "$TTY_SPEC_WIDTH"
  spec_text="$TRUNCATED_TEXT"
  result_width=$((TTY_COLUMNS - TTY_SPEC_WIDTH - 2))
  truncate_plain_text "$text" "$result_width"
  result_text="$TRUNCATED_TEXT"
  colored="$(colorize_result "$total" "$low" "$moderate" "$high" "$critical" "$result_text")"
  printf -v RENDERED_LINE '%-*s  %s' "$TTY_SPEC_WIDTH" "$spec_text" "$colored"
}

# Compose the single status line shown below the table (or alone, when the
# table doesn't fit the terminal height).
compose_progress_status() {
  local base status
  base="Resolving and auditing packages: ${PROGRESS_DONE}/${PROGRESS_TOTAL} complete"
  status="$base"
  if (( ! OUTDATED_READY )); then
    status="${status} — checking for updates..."
  fi
  # Only show the "checking for updates" suffix when it fits whole; on a
  # narrow terminal, drop it rather than truncate it into unreadable noise
  # and lose room for the primary progress count.
  if (( ${#status} > TTY_COLUMNS )); then
    status="$base"
  fi
  truncate_plain_text "$status" "$TTY_COLUMNS"
  RENDERED_LINE="$TRUNCATED_TEXT"
}

# Compose one pending-row line (dim "pending" placeholder) for spec at $1.
compose_tty_pending_line() {
  local spec="$1"
  if (( COLOR_ENABLED )); then
    local spec_text pending_text result_width
    truncate_plain_text "$spec" "$TTY_SPEC_WIDTH"
    spec_text="$TRUNCATED_TEXT"
    result_width=$((TTY_COLUMNS - TTY_SPEC_WIDTH - 2))
    truncate_plain_text "pending" "$result_width"
    pending_text="$TRUNCATED_TEXT"
    printf -v RENDERED_LINE '%-*s  %s%s%s' "$TTY_SPEC_WIDTH" "$spec_text" \
      "$C_DIM" "$pending_text" "$C_RESET"
  else
    compose_tty_plain_line "$spec" "pending"
  fi
}

# Redraw the whole progress block (table rows + status line) in place.
#
# Rather than tracking each row's printed width to move the cursor to an
# exact prior position (the old approach, which broke whenever truncation
# was changed or width detection failed), this always redraws every line of
# a block of known, fixed height: move up exactly that many lines, then
# clear-and-reprint each one top to bottom. Line count is independent of
# terminal width, so this is robust regardless of how wide any given row is.
render_tty_frame() {
  local index
  if (( TTY_DRAWN )); then
    printf '\033[%dA' "$TTY_BLOCK_LINES"
  fi
  if (( TTY_FULL_TABLE )); then
    for index in "${!SPECS[@]}"; do
      if [[ -n "${RESULT_KIND[$index]:-}" ]]; then
        compose_result_line "$index" "${NAMES[$index]}" "${SPECS[$index]}"
      else
        compose_tty_pending_line "${SPECS[$index]}"
      fi
      printf '\033[2K%s\n' "$RENDERED_LINE"
    done
  fi
  compose_progress_status
  printf '\033[2K%s\n' "$RENDERED_LINE"
  TTY_DRAWN=1
}

finish_tty_progress() {
  printf '\033[?7h'
  AUTOWRAP_DISABLED=0
}

# Removed on exit via the trap; shellcheck cannot see trap-based calls.
# shellcheck disable=SC2329
cleanup() {
  if (( AUTOWRAP_DISABLED )); then
    printf '\033[?7h'
  fi
  if [[ -n "$WORK_DIR" && -d "$WORK_DIR" ]]; then
    rm -rf "$WORK_DIR"
  fi
}

# Emit "name<TAB>latest" for every global package with a newer version,
# from `npm outdated -g --json` (which exits nonzero when anything is outdated).
parse_outdated() {
  local file="$1"
  node -e '
    const fs = require("fs");
    let data;
    try { data = JSON.parse(fs.readFileSync(process.argv[1], "utf8")); }
    catch (e) { process.exit(0); }
    if (!data || typeof data !== "object") { process.exit(0); }
    Object.keys(data).forEach(function (name) {
      const info = data[name];
      if (info && typeof info.latest === "string" && info.latest.length > 0) {
        process.stdout.write(name + "\t" + info.latest + "\n");
      }
    });
  ' "$file"
}

# Emit one line per advisory: "severity<TAB>title<TAB>url", for a package that
# has vulnerabilities and no newer version to upgrade to.
parse_advisories() {
  local file="$1"
  node -e '
    const fs = require("fs");
    let data;
    try { data = JSON.parse(fs.readFileSync(process.argv[1], "utf8")); }
    catch (e) { process.exit(0); }
    const vulns = data && data.vulnerabilities;
    if (!vulns || typeof vulns !== "object") { process.exit(0); }
    Object.keys(vulns).forEach(function (depName) {
      const v = vulns[depName];
      const severity = (v && v.severity) || "unknown";
      const via = Array.isArray(v && v.via) ? v.via : [];
      via.forEach(function (item) {
        if (item && typeof item === "object") {
          const title = item.title || depName;
          const url = item.url || "";
          process.stdout.write(severity + "\t" + title + "\t" + url + "\n");
        }
      });
    });
  ' "$file"
}

# Print the last non-empty line of a string (used for error rows).
last_nonempty() {
  local text="$1" line last=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ -n "${line//[[:space:]]/}" ]]; then
      last="$line"
    fi
  done <<<"$text"
  printf '%s' "$last"
}

# Validate one `npm audit --json` response; emit "total<TAB>low<TAB>moderate<TAB>
# high<TAB>critical<TAB>info". Missing keys default to 0; a nonnumeric or
# negative value rejects the response (nonzero exit).
parse_vulns() {
  local file="$1"
  node -e '
    const fs = require("fs");
    let data;
    try { data = JSON.parse(fs.readFileSync(process.argv[1], "utf8")); }
    catch (e) { process.exit(1); }
    const v = data && data.metadata && data.metadata.vulnerabilities;
    if (!v || typeof v !== "object") { process.exit(1); }
    function num(k) {
      if (!(k in v)) { return 0; }
      const x = v[k];
      if (typeof x !== "number" || !Number.isFinite(x) || x < 0) { process.exit(1); }
      return Math.floor(x);
    }
    process.stdout.write([num("total"), num("low"), num("moderate"), num("high"), num("critical"), num("info")].join("\t") + "\n");
  ' "$file"
}

# Format the severity sentence. Singular "vulnerability" only when total is 1;
# a parenthesized breakdown appears for every nonzero total; critical is shown
# only when nonzero.
format_vuln_text() {
  local total="$1" low="$2" moderate="$3" high="$4" critical="$5"
  local word="vulnerabilities"
  [[ "$total" == "1" ]] && word="vulnerability"
  local text="${total} ${word}"
  if [[ "$total" != "0" ]]; then
    text="${text} (${low} low, ${moderate} moderate, ${high} high"
    if [[ "$critical" != "0" ]]; then
      text="${text}, ${critical} critical"
    fi
    text="${text})"
  fi
  printf '%s' "$text"
}

# Wrap severity text in the same color used for that severity elsewhere.
colorize_severity() {
  local severity="$1" text="$2"
  if [[ "$COLOR_ENABLED" != "1" ]]; then
    printf '%s' "$text"
    return 0
  fi
  local color="$C_RESET"
  case "$severity" in
    low) color="$C_YELLOW" ;;
    moderate) color="$C_ORANGE" ;;
    high|critical) color="$C_RED" ;;
  esac
  printf '%s%s%s' "$color" "$text" "$C_RESET"
}

# Wrap only the result text in color: green for zero, yellow for low-only,
# orange when moderate is the highest severity, red for any high/critical.
colorize_result() {
  local total="$1" low="$2" moderate="$3" high="$4" critical="$5" text="$6"
  if [[ "$COLOR_ENABLED" != "1" ]]; then
    printf '%s' "$text"
    return 0
  fi
  local color="$C_GREEN"
  if [[ "$total" != "0" ]]; then
    if [[ "$high" != "0" || "$critical" != "0" ]]; then
      color="$C_RED"
    elif [[ "$moderate" != "0" ]]; then
      color="$C_ORANGE"
    elif [[ "$low" != "0" ]]; then
      color="$C_YELLOW"
    fi
  fi
  printf '%s%s%s' "$color" "$text" "$C_RESET"
}

# Run the registry-bound work for one package in an isolated directory. Results
# are files so concurrent workers cannot interleave terminal output.
audit_package() {
  local spec="$1" job_dir="$2"
  local package_dir="${job_dir}/package"
  local install_out="" install_status=0 audit_out_file="${job_dir}/audit.json"
  local audit_err_file="${job_dir}/audit.err" counts=""

  mkdir -p "$package_dir"
  set +e
  install_out="$(npm --prefix "$package_dir" install --package-lock-only --ignore-scripts --no-audit "$spec" 2>&1)"
  install_status=$?
  set -e
  if (( install_status != 0 )); then
    last_nonempty "$install_out" >"${job_dir}/error"
    printf 'install\n' >"${job_dir}/status.tmp"
    mv "${job_dir}/status.tmp" "${job_dir}/status"
    return 0
  fi

  set +e
  npm --prefix "$package_dir" audit --json >"$audit_out_file" 2>"$audit_err_file" || true
  set -e
  counts="$(parse_vulns "$audit_out_file" 2>/dev/null)" || counts=""
  if [[ -z "$counts" ]]; then
    last_nonempty "$(cat "$audit_err_file" 2>/dev/null || true)" >"${job_dir}/error"
    printf 'audit\n' >"${job_dir}/status.tmp"
    mv "${job_dir}/status.tmp" "${job_dir}/status"
    return 0
  fi

  printf '%s\n' "$counts" >"${job_dir}/counts"
  printf 'ok\n' >"${job_dir}/status.tmp"
  mv "${job_dir}/status.tmp" "${job_dir}/status"
}

start_outdated_lookup() {
  (
    set +e
    npm --no-audit outdated -g --json >"${WORK_DIR}/outdated.json.tmp" 2>/dev/null
    mv "${WORK_DIR}/outdated.json.tmp" "${WORK_DIR}/outdated.json"
    printf 'done\n' >"${WORK_DIR}/outdated.status.tmp"
    mv "${WORK_DIR}/outdated.status.tmp" "${WORK_DIR}/outdated.status"
  ) &
  OUTDATED_PID=$!
}

compose_result_line() {
  local index="$1" name="$2" spec="$3"
  local kind="${RESULT_KIND[$index]}" text="" colored="" latest=""
  if [[ "$kind" != "ok" ]]; then
    if (( TTY_ENABLED )); then
      compose_tty_plain_line "$spec" "${RESULT_ERROR[$index]}"
    else
      printf -v RENDERED_LINE '%-*s  %s' "$width" "$spec" "${RESULT_ERROR[$index]}"
    fi
    return 0
  fi

  text="$(format_vuln_text \
    "${RESULT_TOTAL[$index]}" "${RESULT_LOW[$index]}" \
    "${RESULT_MODERATE[$index]}" "${RESULT_HIGH[$index]}" \
    "${RESULT_CRITICAL[$index]}")"
  if (( OUTDATED_READY )); then
    latest="${LATEST_MAP[$name]:-}"
    if [[ -n "$latest" && "$latest" != "${VERSIONS[$index]}" ]]; then
      text="${text} — outdated, ${latest} available"
    fi
  fi
  if (( TTY_ENABLED )); then
    compose_tty_result_line "$spec" \
      "${RESULT_TOTAL[$index]}" "${RESULT_LOW[$index]}" \
      "${RESULT_MODERATE[$index]}" "${RESULT_HIGH[$index]}" \
      "${RESULT_CRITICAL[$index]}" "$text"
    return 0
  fi
  colored="$(colorize_result \
    "${RESULT_TOTAL[$index]}" "${RESULT_LOW[$index]}" \
    "${RESULT_MODERATE[$index]}" "${RESULT_HIGH[$index]}" \
    "${RESULT_CRITICAL[$index]}" "$text")"
  printf -v RENDERED_LINE '%-*s  %s' "$width" "$spec" "$colored"
}

render_completed_job() {
  local index="$1" job_dir="$2"
  local status="" counts="" err_line="" total low moderate high critical
  if [[ -z "${RESULT_KIND[$index]:-}" ]]; then
    status="$(<"${job_dir}/status")"
    case "$status" in
      install)
        err_line="$(<"${job_dir}/error")"
        RESULT_KIND[index]="error"
        RESULT_ERROR[index]="install failed: ${err_line}"
        HAD_FAILURE=1
        ;;
      audit)
        err_line="$(<"${job_dir}/error")"
        RESULT_KIND[index]="error"
        if [[ -n "$err_line" ]]; then
          RESULT_ERROR[index]="audit failed: ${err_line}"
        else
          RESULT_ERROR[index]="audit failed: invalid npm audit response"
        fi
        HAD_FAILURE=1
        ;;
      ok)
        counts="$(<"${job_dir}/counts")"
        RESULT_KIND[index]="ok"
        IFS=$'\t' read -r total low moderate high critical _ <<<"$counts"
        RESULT_TOTAL[index]="$total"
        RESULT_LOW[index]="$low"
        RESULT_MODERATE[index]="$moderate"
        RESULT_HIGH[index]="$high"
        RESULT_CRITICAL[index]="$critical"
        ;;
      *)
        RESULT_KIND[index]="error"
        RESULT_ERROR[index]="audit failed: invalid worker response"
        HAD_FAILURE=1
        ;;
    esac
  fi
}

start_job() {
  local index="$1"
  audit_package "${SPECS[$index]}" "${JOB_DIRS[$index]}" &
  JOB_PIDS[index]=$!
  JOB_ACTIVE[index]=1
  ACTIVE_COUNT=$((ACTIVE_COUNT + 1))
}

start_queued_jobs() {
  while (( ACTIVE_COUNT < JOBS && NEXT_INDEX < PROGRESS_TOTAL )); do
    start_job "$NEXT_INDEX"
    NEXT_INDEX=$((NEXT_INDEX + 1))
  done
}

reap_completed_jobs() {
  local index
  REAPED_COUNT=0
  for index in "${!SPECS[@]}"; do
    if [[ "${JOB_ACTIVE[$index]:-0}" == "1" && -f "${JOB_DIRS[$index]}/status" ]]; then
      wait "${JOB_PIDS[$index]}" || true
      JOB_ACTIVE[index]=0
      ACTIVE_COUNT=$((ACTIVE_COUNT - 1))
      PROGRESS_DONE=$((PROGRESS_DONE + 1))
      render_completed_job "$index" "${JOB_DIRS[$index]}"
      REAPED_COUNT=$((REAPED_COUNT + 1))
    fi
  done
}

finish_outdated_lookup() {
  local o_name o_latest
  (( OUTDATED_READY == 0 )) || return 0
  [[ -f "${WORK_DIR}/outdated.status" ]] || return 1

  wait "$OUTDATED_PID" || true
  while IFS=$'\t' read -r o_name o_latest; do
    [[ -n "$o_name" ]] || continue
    LATEST_MAP["$o_name"]="$o_latest"
  done < <(parse_outdated "${WORK_DIR}/outdated.json" 2>/dev/null || true)
  OUTDATED_READY=1
}

build_next_data() {
  local index name spec latest total lines="" a_severity a_title a_url entry colored_severity
  OUTDATED_NAMES=()
  VULNERABLE_WITHOUT_UPDATE=()
  ADVISORY_TEXT=()
  for index in "${!SPECS[@]}"; do
    [[ "${RESULT_KIND[$index]}" == "ok" ]] || continue
    name="${NAMES[$index]}"
    spec="${SPECS[$index]}"
    latest="${LATEST_MAP[$name]:-}"
    total="${RESULT_TOTAL[$index]}"
    if [[ -n "$latest" && "$latest" != "${VERSIONS[$index]}" ]]; then
      OUTDATED_NAMES+=("$name")
      continue
    fi
    [[ "$total" != "0" ]] || continue

    VULNERABLE_WITHOUT_UPDATE+=("$spec")
    lines="$(parse_advisories "${JOB_DIRS[$index]}/audit.json" 2>/dev/null || true)"
    entry=""
    while IFS=$'\t' read -r a_severity a_title a_url; do
      [[ -n "$a_severity" ]] || continue
      colored_severity="$(colorize_severity "$a_severity" "$a_severity")"
      if [[ -n "$a_url" ]]; then
        entry="${entry}    - [${colored_severity}] ${a_title} (${a_url})"$'\n'
      else
        entry="${entry}    - [${colored_severity}] ${a_title}"$'\n'
      fi
    done <<<"$lines"
    ADVISORY_TEXT["$spec"]="$entry"
  done
}

main() {
  parse_opts "$@"
  enable_color
  [[ -n "$JOBS" ]] || JOBS="$(default_jobs)"

  trap cleanup EXIT

  local list_json=""
  list_json="$(npm --no-audit ls -g --depth=0 --json 2>/dev/null)" || {
    printf '%s: unable to list global packages\n' "$PROG" >&2
    exit 1
  }

  local records=""
  records="$(printf '%s' "$list_json" | node -e '
    const fs = require("fs");
    let data;
    try { data = JSON.parse(fs.readFileSync(0, "utf8")); }
    catch (e) { process.exit(1); }
    const deps = data && data.dependencies;
    if (!deps || typeof deps !== "object") { process.exit(0); }
    const rows = [];
    Object.keys(deps).forEach(function (name) {
      const info = deps[name];
      if (typeof name === "string" && name.length > 0 && info && typeof info.version === "string" && info.version.length > 0) {
        rows.push(name + "\t" + info.version);
      }
    });
    if (rows.length > 0) { process.stdout.write(rows.join("\n") + "\n"); }
    process.exit(0);
  ' | LC_ALL=C sort)" || {
    printf '%s: unable to list global packages\n' "$PROG" >&2
    exit 1
  }

  if [[ -z "$records" ]]; then
    printf 'No global npm packages found.\n'
    exit 0
  fi

  WORK_DIR="$(mktemp -d "${TMPDIR:-/tmp}/npm-global-audit.XXXXXX")"

  local width=0 name version spec len index
  while IFS=$'\t' read -r name version; do
    [[ -n "$name" ]] || continue
    spec="${name}@${version}"
    index=${#SPECS[@]}
    NAMES+=("$name")
    VERSIONS+=("$version")
    SPECS+=("$spec")
    JOB_DIRS+=("${WORK_DIR}/job.${index}")
    mkdir -p "${JOB_DIRS[$index]}"
    len=${#spec}
    (( len > width )) && width=$len
  done <<<"$records"

  PROGRESS_TOTAL=${#SPECS[@]}
  start_outdated_lookup

  # Redraw the whole TTY progress block on a ~700ms cadence rather than on
  # every job completion: buffering updates this way still reads as
  # real-time to a person watching, and it means the display never needs to
  # move the cursor to a row whose exact printed width it doesn't know.
  local redraw_ticks redraw_countdown=0
  redraw_ticks="$(awk -v p="$POLL_INTERVAL" 'BEGIN { n = (p > 0) ? int(0.7 / p) : 1; if (n < 1) n = 1; print n }')"

  if [[ -t 1 ]]; then
    TTY_ENABLED=1
    detect_tty_layout "$width"
    TTY_BLOCK_LINES=$(( TTY_FULL_TABLE ? PROGRESS_TOTAL + 1 : 1 ))
    printf '\033[?7l'
    AUTOWRAP_DISABLED=1
    render_tty_frame
  fi

  ACTIVE_COUNT=0
  NEXT_INDEX=0
  REAPED_COUNT=0
  start_queued_jobs
  while (( PROGRESS_DONE < PROGRESS_TOTAL )); do
    reap_completed_jobs
    finish_outdated_lookup || true
    start_queued_jobs
    if (( REAPED_COUNT == 0 )); then
      sleep "$POLL_INTERVAL"
      if (( TTY_ENABLED )); then
        redraw_countdown=$((redraw_countdown + 1))
        if (( redraw_countdown >= redraw_ticks )); then
          render_tty_frame
          redraw_countdown=0
        fi
      fi
    fi
  done
  while (( OUTDATED_READY == 0 )); do
    if ! finish_outdated_lookup; then
      sleep "$POLL_INTERVAL"
    fi
  done

  if (( TTY_ENABLED )); then
    render_tty_frame
    finish_tty_progress
    if (( TTY_FULL_TABLE )); then
      # The package rows are the final output; only the transient status
      # line above "Next:" needs to go.
      printf '\r\033[1A\033[2K'
    else
      for index in "${!SPECS[@]}"; do
        compose_result_line "$index" "${NAMES[$index]}" "${SPECS[$index]}"
        printf '%s\n' "$RENDERED_LINE"
      done
      printf '\n'
    fi
  else
    for index in "${!SPECS[@]}"; do
      compose_result_line "$index" "${NAMES[$index]}" "${SPECS[$index]}"
      printf '%s\n' "$RENDERED_LINE"
    done
    printf '\n'
  fi

  build_next_data
  if (( ${#OUTDATED_NAMES[@]} == 0 && ${#VULNERABLE_WITHOUT_UPDATE[@]} == 0 )); then
    printf 'Next: nothing to do — no vulnerabilities found.\n'
  else
    if (( ${#OUTDATED_NAMES[@]} > 0 )); then
      printf 'Next: updates available:\n'
      printf '  npm update -g %s\n' "${OUTDATED_NAMES[@]}"
    fi
    if (( ${#VULNERABLE_WITHOUT_UPDATE[@]} > 0 )); then
      printf 'Next: already on latest, needs manual review:\n'
      local vspec
      for vspec in "${VULNERABLE_WITHOUT_UPDATE[@]}"; do
        printf '  %s\n' "$vspec"
        printf '%s' "${ADVISORY_TEXT[$vspec]:-}"
      done
    fi
  fi

  if (( HAD_FAILURE )); then
    exit 1
  fi
  exit 0
}

main "$@"
