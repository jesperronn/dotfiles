#!/usr/bin/env bash
# shellcheck shell=bash disable=SC2034
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

SKILLS_ENABLED_ROOT="${SKILLS_ENABLED_ROOT:-$ROOT_DIR/link-dir/.agents/skills-enabled}"
SKILLS_SYMLINK_ROOT="${SKILLS_SYMLINK_ROOT:-$ROOT_DIR/link-dir/.agents/skills}"
SKILLS_DISABLED_ROOT="${SKILLS_DISABLED_ROOT:-$ROOT_DIR/link-dir/.agents/skills-disabled}"

SKILLS_SUBCOMMAND=""
SKILLS_SHOW_DISABLED=0
SKILLS_VERBOSE=0
SKILLS_SHOW_HELP=0
SKILLS_COLOR_MODE="auto"
SKILLS_COLOR_ENABLED=0
SKILLS_ENABLE_ID=""
SKILLS_PRUNE=0
SKILLS_DRY_RUN=0

SKILLS_C_RESET=$'\033[0m'
SKILLS_C_BOLD=$'\033[1m'
SKILLS_C_DIM=$'\033[2m'
SKILLS_C_RED=$'\033[31m'
SKILLS_C_GREEN=$'\033[32m'
SKILLS_C_MAGENTA=$'\033[35m'
SKILLS_C_BRIGHT_MAGENTA=$'\033[95m'
SKILLS_C_YELLOW=$'\033[33m'

skills_usage() {
  local section_style="" tool_style="" command_style="" flag_style="" placeholder_style="" reset_style=""
  if (( SKILLS_COLOR_ENABLED )); then
    section_style="${SKILLS_C_BOLD}${SKILLS_C_YELLOW}"
    tool_style="${SKILLS_C_BOLD}${SKILLS_C_MAGENTA}"
    command_style="${SKILLS_C_GREEN}"
    flag_style="${SKILLS_C_GREEN}"
    placeholder_style="${SKILLS_C_BRIGHT_MAGENTA}"
    reset_style="${SKILLS_C_RESET}"
  fi

  printf 'Manage agent skills: list, status, enable, disable, cleanup.\n\n'
  printf '%sUsage:%s %sbin/skill%s %s<subcommand>%s %s[options]%s\n\n' \
    "$section_style" "$reset_style" "$tool_style" "$reset_style" \
    "$placeholder_style" "$reset_style" "$placeholder_style" "$reset_style"
  printf '%sSubcommands:%s\n' "$section_style" "$reset_style"
  printf '  %slist%s              Show enabled skills (optionally disabled)\n' "$command_style" "$reset_style"
  printf '  %sstatus%s            Show enabled and disabled skills with inconsistencies\n' "$command_style" "$reset_style"
  printf '  %senable%s %s<id>%s     Enable a disabled skill\n' "$command_style" "$reset_style" "$placeholder_style" "$reset_style"
  printf '  %sdisable%s %s<id>%s    Disable an enabled skill\n' "$command_style" "$reset_style" "$placeholder_style" "$reset_style"
  printf '  %scleanup%s            Interactive tool to fix skill inconsistencies (fzf)\n' "$command_style" "$reset_style"
  printf '\n%sOptions:%s\n' "$section_style" "$reset_style"
  printf '  %s-h, --help%s        Show this help.\n' "$flag_style" "$reset_style"
  printf '  %s--color%s           Force colored output.\n' "$flag_style" "$reset_style"
  printf '  %s--no-color%s        Disable colored output.\n' "$flag_style" "$reset_style"
  printf '  %s--verbose%s         Show full descriptions and verbose output.\n' "$flag_style" "$reset_style"
}

skills_error() { printf '%s\n' "$*" >&2; }

skills_color_print() {
  local color="$1"
  shift

  if (( SKILLS_COLOR_ENABLED )); then
    printf '%b%s%b\n' "$color" "$*" "$SKILLS_C_RESET"
  else
    printf '%s\n' "$*"
  fi
}

skills_info() {
  if (( SKILLS_COLOR_ENABLED )); then
    skills_color_print "$SKILLS_C_DIM" "$*"
  else
    printf '%s\n' "$*"
  fi
}

skills_success() {
  if (( SKILLS_COLOR_ENABLED )); then
    skills_color_print "$SKILLS_C_GREEN" "$*"
  else
    printf '%s\n' "$*"
  fi
}

skills_warn() {
  printf '%sWarning: %s\n' "$SKILLS_C_RESET" "$*" >&2
}

skills_verbose() {
  if (( SKILLS_VERBOSE )); then
    skills_info "$*"
  fi
}

skills_list_row() {
  local id="$1"
  local is_enabled="${2:-0}"  # 1=enabled, 0=disabled
  local description="${3:-}"

  if (( is_enabled )); then
    if (( SKILLS_COLOR_ENABLED )); then
      printf '  %s✓%s %s%s%s' "$SKILLS_C_GREEN" "$SKILLS_C_RESET" "$SKILLS_C_BOLD" "$id" "$SKILLS_C_RESET"
    else
      printf '  ✓ %s' "$id"
    fi
  else
    if (( SKILLS_COLOR_ENABLED )); then
      printf '  %s-%s %s%s%s' "$SKILLS_C_DIM" "$SKILLS_C_RESET" "$SKILLS_C_BOLD" "$id" "$SKILLS_C_RESET"
    else
      printf '  - %s' "$id"
    fi
  fi

  if [[ -n "$description" ]]; then
    printf ': %s' "$description"
  fi
  printf '\n'
}

skills_list_ids() {
  local root="$1"
  local id=""

  if [[ ! -d "$root" ]]; then
    return 0
  fi

  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    if [[ -d "$root/$id" && -f "$root/$id/SKILL.md" ]]; then
      printf '%s\n' "$id"
    fi
  done < <(find "$root" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) 2>/dev/null | sort | while IFS= read -r dir; do basename "$dir"; done)
}

skills_read_metadata() {
  local skill_dir="$1"
  local skill_file="$skill_dir/SKILL.md"
  local summary=""
  local description=""
  local in_description=0
  local desc_lines=""
  local first_line=1

  if [[ ! -f "$skill_file" ]]; then
    printf '%s\n' "$(basename "$skill_dir")"
    printf '\n'
    return 0
  fi

  while IFS= read -r line; do
    # Skip blank lines at the top (between heading and metadata)
    if [[ $first_line -eq 1 ]]; then
      first_line=0
      if [[ -z "$line" || "$line" == "# "* ]]; then
        continue
      fi
    fi

    # Skip the heading line (starts with #)
    if [[ "$line" == "# "* ]]; then
      continue
    fi

    # Check for summary field
    if [[ $in_description -eq 0 && "$line" =~ ^summary:\ *(.*) ]]; then
      summary="${BASH_REMATCH[1]}"
      summary="$(printf '%s' "$summary" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
      continue
    fi

    # Check for description field
    if [[ $in_description -eq 0 && "$line" == "description:"* ]]; then
      in_description=1
      local desc_value="${line#description:}"
      desc_value="$(printf '%s' "$desc_value" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
      # Check for YAML block literal (> marker)
      if [[ "$desc_value" == ">" ]]; then
        desc_lines=""
      else
        # Single-line description
        desc_value="$(printf '%s' "$desc_value" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        printf '%s\n' "$summary"
        printf '%s\n' "$desc_value"
      fi
      continue
    fi

    # Inside a YAML block description
    if [[ $in_description -eq 1 ]]; then
      if [[ -z "$line" ]]; then
        # Blank line ends the block
        in_description=0
      else
        local clean_line
        clean_line="$(printf '%s' "${line}" | sed 's/^[[:space:]]*//')"
        if [[ -n "$desc_lines" ]]; then
          desc_lines="${desc_lines}"$'\n'"${clean_line}"
        else
          desc_lines="$clean_line"
        fi
      fi
    fi
  done < "$skill_file"

  # Output: summary on first line, description on second
  printf '%s\n' "$summary"
  printf '%s\n' "$desc_lines"
}

skills_discover() {
  local location="$1"
  local root=""

  case "$location" in
    enabled)
      root="$SKILLS_ENABLED_ROOT"
      ;;
    disabled)
      root="$SKILLS_DISABLED_ROOT"
      ;;
    *)
      return 1
      ;;
  esac

  local id=""
  for id in $(skills_list_ids "$root"); do
    printf '%s\n' "$id"
  done
}

skills_read_skill_summary() {
  local skill_dir="$1"
  local result
  result="$(skills_read_metadata "$skill_dir")"
  printf '%s' "$result" | head -n 1
}

skills_read_skill_description() {
  local skill_dir="$1"
  local result
  result="$(skills_read_metadata "$skill_dir")"
  printf '%s' "$result" | sed -n '2p'
}

skills_parse_prereqs() {
  case "$SKILLS_COLOR_MODE" in
    always) SKILLS_COLOR_ENABLED=1 ;;
    never) SKILLS_COLOR_ENABLED=0 ;;
    auto)
      if [[ -n "${NO_COLOR:-}" ]]; then
        SKILLS_COLOR_ENABLED=0
      elif command -v tput >/dev/null 2>&1 && [[ -t 1 ]]; then
        SKILLS_COLOR_ENABLED=1
      else
        SKILLS_COLOR_ENABLED=0
      fi
      ;;
  esac
}

skills_parse_opts() {
  local subcommand_set=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        SKILLS_SHOW_HELP=1
        shift
        ;;
      --color)
        SKILLS_COLOR_MODE="always"
        shift
        ;;
      --no-color)
        SKILLS_COLOR_MODE="never"
        shift
        ;;
      --verbose)
        SKILLS_VERBOSE=1
        shift
        ;;
      --disabled)
        SKILLS_SHOW_DISABLED=1
        shift
        ;;
      --prune)
        SKILLS_PRUNE=1
        shift
        ;;
      --dry-run)
        SKILLS_DRY_RUN=1
        shift
        ;;
      -*)
        skills_error "Unknown option: $1"
        return 1
        ;;
      *)
        if [[ $subcommand_set -eq 0 ]]; then
          # First positional must be a subcommand
          case "$1" in
            help)
              SKILLS_SHOW_HELP=1
              ;;
            list|status|enable|disable|cleanup)
              SKILLS_SUBCOMMAND="$1"
              subcommand_set=1
              ;;
            *)
              skills_error "Unknown subcommand: $1"
              return 1
              ;;
          esac
          shift
        else
          # After a subcommand, positional can be:
          # - skill ID for enable/disable
          # - second subcommand (error)
          case "$1" in
            list|status|enable|disable|cleanup)
              skills_error "Only one subcommand is supported."
              return 1
              ;;
            *)
              case "$SKILLS_SUBCOMMAND" in
                enable|disable)
                  SKILLS_ENABLE_ID="$1"
                  shift
                  ;;
                *)
                  skills_error "Unexpected argument for subcommand '$SKILLS_SUBCOMMAND'"
                  return 1
                  ;;
              esac
            ;;
          esac
        fi
        ;;
    esac
  done

  if [[ $subcommand_set -eq 0 ]]; then
    if [[ "$SKILLS_SHOW_HELP" -eq 1 ]]; then
      return 0
    fi
    return 64
  fi
}

skills_run() {
  if (( SKILLS_SHOW_HELP )); then
    case "$SKILLS_SUBCOMMAND" in
      "")
        skills_usage
        return 0
        ;;
      enable)
        printf 'Enable a disabled skill.\n\n'
        printf 'Usage: %s enable <skill-id>\n' "$(basename "$0")"
        printf 'Options:\n'
        printf '  -h, --help    Show this help.\n'
        printf '  --color       Force colored output.\n'
        printf '  --no-color    Disable colored output.\n'
        return 0
        ;;
      disable)
        printf 'Disable an enabled skill.\n\n'
        printf 'Usage: %s disable <skill-id>\n' "$(basename "$0")"
        printf 'Options:\n'
        printf '  -h, --help    Show this help.\n'
        printf '  --color       Force colored output.\n'
        printf '  --no-color    Disable colored output.\n'
        return 0
        ;;
      cleanup)
        printf 'Fix skill inconsistencies interactively.\n\n'
        printf 'Usage: %s cleanup [options]\n' "$(basename "$0")"
        printf 'Options:\n'
        printf '  -h, --help    Show this help.\n'
        printf '  --dry-run     Show what would be done without making changes.\n'
        printf '  --color       Force colored output.\n'
        printf '  --no-color    Disable colored output.\n'
        return 0
        ;;
      *)
        ;;  # list and status don't need subcommand-specific help
    esac
  fi
  case "$SKILLS_SUBCOMMAND" in
    list)   skills_list ;;
    status) skills_status ;;
    enable) skills_enable "$SKILLS_ENABLE_ID" ;;
    disable) skills_disable "$SKILLS_ENABLE_ID" ;;
    cleanup) skills_cleanup ;;
  esac
}
skills_list() {
  local id=""
  local root=""
  local is_disabled_list=0

  if (( SKILLS_SHOW_DISABLED )); then
    root="$SKILLS_DISABLED_ROOT"
    is_disabled_list=1
  else
    root="$SKILLS_SYMLINK_ROOT"
  fi

  if [[ ! -d "$root" ]]; then
    return 0
  fi

  for id in $(skills_list_ids "$root"); do
    # For symlinked skills, resolve to actual location to read metadata
    local skill_dir="$root/$id"
    if (( ! is_disabled_list )); then
      if [[ -L "$skill_dir" ]]; then
        skill_dir="$(readlink -f "$skill_dir")"
      fi
    fi

    if (( is_disabled_list )); then
      skills_list_row "$id" 0 "$(skills_read_skill_summary "$skill_dir" 2>/dev/null || true)"
      skills_verbose "  $(skills_read_skill_description "$skill_dir" 2>/dev/null || true)"
    else
      skills_list_row "$id" 1 "$(skills_read_skill_summary "$skill_dir" 2>/dev/null || true)"
      skills_verbose "  $(skills_read_skill_description "$skill_dir" 2>/dev/null || true)"
    fi
  done
}

skills_check_inconsistencies() {
  local inconsistent=()
  local id=""

  # Check .agents/skills-enabled/ for real files (should be moved/organized differently)
  if [[ -d "$SKILLS_ENABLED_ROOT" ]]; then
    while IFS= read -r item; do
      [[ -z "$item" ]] && continue
      if [[ -d "$SKILLS_ENABLED_ROOT/$item" && ! -L "$SKILLS_ENABLED_ROOT/$item" ]]; then
        # Real directory in skills-enabled (these should typically be via symlinks)
        inconsistent+=("REAL_FILE_ENABLED:$item")
      fi
    done < <(find "$SKILLS_ENABLED_ROOT" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | xargs -I {} basename {} | sort)
  fi

  # Check .agents/skills/ for real files (should be symlinks)
  if [[ -d "$SKILLS_SYMLINK_ROOT" ]]; then
    while IFS= read -r item; do
      [[ -z "$item" ]] && continue
      local path="$SKILLS_SYMLINK_ROOT/$item"
      if [[ -d "$path" && ! -L "$path" ]]; then
        # Real directory in skills/ (should be symlink)
        inconsistent+=("REAL_FILE_SYMLINK:$item")
      elif [[ -L "$path" ]]; then
        local target
        target="$(readlink -f "$path")"
        if [[ ! -d "$target" ]]; then
          # Broken symlink
          inconsistent+=("BROKEN_SYMLINK:$item")
        fi
      fi
    done < <(find "$SKILLS_SYMLINK_ROOT" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) 2>/dev/null | xargs -I {} basename {} | sort)
  fi

  printf '%s\n' "${inconsistent[@]}"
}

skills_status() {
  local id=""
  local total=0
  local enabled_count=0
  local disabled_count=0
  local enabled_ids=()
  local disabled_ids=()
  local inconsistent_items=()

  mapfile -t enabled_ids < <(skills_list_ids "$SKILLS_SYMLINK_ROOT" 2>/dev/null || true)
  mapfile -t disabled_ids < <(skills_list_ids "$SKILLS_DISABLED_ROOT" 2>/dev/null || true)
  mapfile -t inconsistent_items < <(skills_check_inconsistencies)

  for id in "${enabled_ids[@]}"; do
    [[ -n "$id" ]] || continue
    local skill_dir="$SKILLS_SYMLINK_ROOT/$id"
    if [[ -L "$skill_dir" ]]; then
      skill_dir="$(readlink -f "$skill_dir")"
    fi
    skills_list_row "$id" 1 "$(skills_read_skill_summary "$skill_dir" 2>/dev/null || true)"
    skills_verbose "  $(skills_read_skill_description "$skill_dir" 2>/dev/null || true)"
    enabled_count=$((enabled_count + 1))
  done

  if (( enabled_count > 0 )); then
    printf '\n'
  fi

  # Show inconsistencies if any
  if (( ${#inconsistent_items[@]} > 0 )); then
    if (( SKILLS_COLOR_ENABLED )); then
      printf '%s⚠ Issues found:%s\n' "$SKILLS_C_YELLOW" "$SKILLS_C_RESET"
    else
      printf '⚠ Issues found:\n'
    fi
    for item in "${inconsistent_items[@]}"; do
      local issue_type="${item%%:*}"
      local item_id="${item#*:}"
      case "$issue_type" in
        REAL_FILE_ENABLED)
          printf '  Real file in skills-enabled: %s (should be in skills-disabled or moved)\n' "$item_id"
          ;;
        REAL_FILE_SYMLINK)
          printf '  Real file in skills (not symlinked): %s\n' "$item_id"
          ;;
        BROKEN_SYMLINK)
          printf '  Broken symlink: %s (target missing)\n' "$item_id"
          ;;
      esac
    done
    printf '\n  Run: %s cleanup\n\n' "$(basename "$0")"
  fi

  for id in "${disabled_ids[@]}"; do
    [[ -n "$id" ]] || continue
    skills_list_row "$id" 0 "$(skills_read_skill_summary "$SKILLS_DISABLED_ROOT/$id" 2>/dev/null || true)"
    skills_verbose "  $(skills_read_skill_description "$SKILLS_DISABLED_ROOT/$id" 2>/dev/null || true)"
    disabled_count=$((disabled_count + 1))
  done

  total=$((enabled_count + disabled_count))
  printf '\n'
  printf '  total:  %d\n' "$total"
  printf '  enabled: %d\n' "$enabled_count"
  printf '  disabled: %d\n' "$disabled_count"
}

skills_validate_id() {
  local id="$1"

  # Reject empty
  if [[ -z "$id" ]]; then
    skills_error "Skill ID must not be empty."
    return 1
  fi

  # Reject path separators and dangerous patterns
  if [[ "$id" == *"/"* || "$id" == *".."* || "$id" == "." || "$id" == *"."*/* || "$id" == *"."* ]]; then
    skills_error "Skill ID must not contain path separators, '..', or '.': $id"
    return 1
  fi

  return 0
}

skills_enable() {
  local id="$1"

  if [[ -z "$id" ]]; then
    skills_error "Usage: skill enable <skill-id>"
    return 1
  fi

  if ! skills_validate_id "$id"; then
    return 1
  fi

  local src_dir="$SKILLS_DISABLED_ROOT/$id"
  local dst_dir="$SKILLS_ENABLED_ROOT/$id"

  if [[ ! -d "$src_dir" ]]; then
    skills_error "Skill '$id' not found in disabled skills."
    skills_error "Make sure it exists under: ${SKILLS_DISABLED_ROOT#"$ROOT_DIR"/}/$id"
    return 1
  fi

  if [[ -e "$dst_dir" ]]; then
    skills_error "Skill '$id' already exists in enabled skills."
    return 1
  fi

  mkdir -p "$SKILLS_ENABLED_ROOT"
  mv "$src_dir" "$dst_dir"
  skills_success "Enabled skill '$id'."
}

skills_disable() {
  local id="$1"

  if [[ -z "$id" ]]; then
    skills_error "Usage: skill disable <skill-id>"
    return 1
  fi

  if ! skills_validate_id "$id"; then
    return 1
  fi

  local src_dir="$SKILLS_ENABLED_ROOT/$id"
  local dst_dir="$SKILLS_DISABLED_ROOT/$id"

  if [[ ! -d "$src_dir" ]]; then
    skills_error "Skill '$id' not found in enabled skills."
    skills_error "Make sure it exists under: ${SKILLS_ENABLED_ROOT#"$ROOT_DIR"/}/$id"
    return 1
  fi

  if [[ -e "$dst_dir" ]]; then
    skills_error "Skill '$id' already exists in disabled skills."
    return 1
  fi

  mkdir -p "$SKILLS_DISABLED_ROOT"
  mv "$src_dir" "$dst_dir"
  skills_success "Disabled skill '$id'."
}

skills_cleanup() {
  local inconsistent_items=()

  mapfile -t inconsistent_items < <(skills_check_inconsistencies)

  if (( ${#inconsistent_items[@]} == 0 )); then
    skills_success "No inconsistencies found!"
    return 0
  fi

  printf '\n%sFound %d inconsistencies. Fix them interactively:\n%s\n' \
    "$SKILLS_C_YELLOW" "${#inconsistent_items[@]}" "$SKILLS_C_RESET"

  skills_interactive_cleanup "${inconsistent_items[@]}"
}

skills_interactive_cleanup() {
  local inconsistent_items=("$@")
  local item=""
  local count=1
  local total=${#inconsistent_items[@]}

  if (( SKILLS_DRY_RUN )); then
    skills_info "[DRY-RUN] Showing what would be done (no changes will be made)\n"
  fi

  for item in "${inconsistent_items[@]}"; do
    local issue_type="${item%%:*}"
    local item_id="${item#*:}"
    local symlink_path="$SKILLS_SYMLINK_ROOT/$item_id"
    local enabled_path="$SKILLS_ENABLED_ROOT/$item_id"
    local disabled_path="$SKILLS_DISABLED_ROOT/$item_id"

    printf '\n%s[%d/%d] %s%s\n' "$SKILLS_C_BOLD" "$count" "$total" "$item_id" "$SKILLS_C_RESET"
    count=$((count + 1))

    case "$issue_type" in
      REAL_FILE_SYMLINK)
        printf '  Issue: Real file in skills (should be symlinked)\n'
        printf '  Path: %s\n' "$symlink_path"
        printf '  Options: [E]nable (create symlink from skills-enabled)\n'
        printf '           [D]isable (move to skills-disabled)\n'
        printf '           [X]delete (remove completely)\n'
        printf '           [S]kip\n'
        if (( SKILLS_DRY_RUN )); then
          printf '  Action (dry-run, showing example)? (E/D/X/S) > '
        else
          printf '  Action? (E/D/X/S) > '
        fi
        read -r action
        case "$action" in
          E|e)
            if (( SKILLS_DRY_RUN )); then
              printf '  [DRY-RUN] Would: mv %s %s\n' "$symlink_path" "$enabled_path"
              printf '  [DRY-RUN] Would: ln -s %s %s\n' "$enabled_path" "$symlink_path"
              skills_info "  → (dry-run, no changes made)"
            else
              mkdir -p "$SKILLS_ENABLED_ROOT"
              if [[ -d "$symlink_path" ]]; then
                mv "$symlink_path" "$enabled_path"
                ln -s "$enabled_path" "$symlink_path"
                skills_success "  ✓ Moved to enabled and created symlink"
              else
                skills_warn "  ! Skill not accessible"
              fi
            fi
            ;;
          D|d)
            if (( SKILLS_DRY_RUN )); then
              printf '  [DRY-RUN] Would: mv %s %s\n' "$symlink_path" "$disabled_path"
              skills_info "  → (dry-run, no changes made)"
            else
              mkdir -p "$SKILLS_DISABLED_ROOT"
              if [[ -d "$symlink_path" ]]; then
                mv "$symlink_path" "$disabled_path"
                skills_success "  ✓ Moved to disabled"
              else
                skills_warn "  ! Skill not accessible"
              fi
            fi
            ;;
          X|x)
            if (( SKILLS_DRY_RUN )); then
              printf '  [DRY-RUN] Would: rm -rf %s\n' "$symlink_path"
              skills_info "  → (dry-run, no changes made)"
            else
              printf '  Confirm delete %s? (yes/no) > ' "$item_id"
              read -r confirm
              if [[ "$confirm" == "yes" ]]; then
                rm -rf "$symlink_path"
                skills_success "  ✓ Deleted"
              else
                skills_info "  → Skipped"
              fi
            fi
            ;;
          *)
            skills_info "  → Skipped"
            ;;
        esac
        ;;
      REAL_FILE_ENABLED)
        printf '  Issue: Real file in skills-enabled (inconsistent state)\n'
        printf '  Path: %s\n' "$enabled_path"
        printf '  Options: [S]ymblic (create symlink in skills)\n'
        printf '           [D]isable (move to skills-disabled)\n'
        printf '           [X]delete (remove completely)\n'
        printf '           [K]eep\n'
        if (( SKILLS_DRY_RUN )); then
          printf '  Action (dry-run, showing example)? (S/D/X/K) > '
        else
          printf '  Action? (S/D/X/K) > '
        fi
        read -r action
        case "$action" in
          S|s)
            if (( SKILLS_DRY_RUN )); then
              printf '  [DRY-RUN] Would: ln -s %s %s\n' "$enabled_path" "$symlink_path"
              skills_info "  → (dry-run, no changes made)"
            else
              mkdir -p "$SKILLS_SYMLINK_ROOT"
              ln -s "$enabled_path" "$symlink_path"
              skills_success "  ✓ Created symlink in skills"
            fi
            ;;
          D|d)
            if (( SKILLS_DRY_RUN )); then
              printf '  [DRY-RUN] Would: mv %s %s\n' "$enabled_path" "$disabled_path"
              skills_info "  → (dry-run, no changes made)"
            else
              mkdir -p "$SKILLS_DISABLED_ROOT"
              mv "$enabled_path" "$disabled_path"
              skills_success "  ✓ Moved to disabled"
            fi
            ;;
          X|x)
            if (( SKILLS_DRY_RUN )); then
              printf '  [DRY-RUN] Would: rm -rf %s\n' "$enabled_path"
              skills_info "  → (dry-run, no changes made)"
            else
              printf '  Confirm delete %s? (yes/no) > ' "$item_id"
              read -r confirm
              if [[ "$confirm" == "yes" ]]; then
                rm -rf "$enabled_path"
                skills_success "  ✓ Deleted"
              else
                skills_info "  → Skipped"
              fi
            fi
            ;;
          *)
            skills_info "  → Kept as-is"
            ;;
        esac
        ;;
      BROKEN_SYMLINK)
        local target
        target="$(readlink "$symlink_path" 2>/dev/null || echo 'unknown')"
        printf '  Issue: Broken symlink (target missing)\n'
        printf '  Symlink: %s\n' "$symlink_path"
        printf '  Target: %s (missing)\n' "$target"
        printf '  Options: [R]emove (delete symlink)\n'
        printf '           [D]elete (also remove target if it exists)\n'
        printf '           [S]kip\n'
        if (( SKILLS_DRY_RUN )); then
          printf '  Action (dry-run, showing example)? (R/D/S) > '
        else
          printf '  Action? (R/D/S) > '
        fi
        read -r action
        case "$action" in
          R|r)
            if (( SKILLS_DRY_RUN )); then
              printf '  [DRY-RUN] Would: rm -f %s\n' "$symlink_path"
              skills_info "  → (dry-run, no changes made)"
            else
              rm -f "$symlink_path"
              skills_success "  ✓ Removed broken symlink"
            fi
            ;;
          D|d)
            if (( SKILLS_DRY_RUN )); then
              printf '  [DRY-RUN] Would: rm -f %s\n' "$symlink_path"
              printf '  [DRY-RUN] Would: rm -rf %s\n' "$target"
              skills_info "  → (dry-run, no changes made)"
            else
              rm -f "$symlink_path"
              rm -rf "$target" 2>/dev/null || true
              skills_success "  ✓ Removed symlink and target"
            fi
            ;;
          *)
            skills_info "  → Skipped"
            ;;
        esac
        ;;
    esac
  done

  printf '\n'
  if (( SKILLS_DRY_RUN )); then
    skills_success "[DRY-RUN] Cleanup preview complete (no changes were made)"
  else
    skills_success "Cleanup complete!"
  fi
}

skills_sync() {
  local id=""
  local orphaned=()
  local orphaned_count=0
  local created_count=0
  local skipped_count=0

  if (( SKILLS_DRY_RUN )); then
    skills_info "DRY-RUN: No changes will be made"
  fi

  if (( ! SKILLS_DRY_RUN )); then
    mkdir -p "$SKILLS_SYMLINK_ROOT"
  else
    skills_verbose "Would create: $SKILLS_SYMLINK_ROOT"
  fi

  # Create symlinks for all enabled skills
  for id in $(skills_list_ids "$SKILLS_ENABLED_ROOT"); do
    local src="$SKILLS_ENABLED_ROOT/$id"
    local dst="$SKILLS_SYMLINK_ROOT/$id"

    if [[ ! -d "$src" ]]; then
      continue
    fi

    # Remove existing symlink if it exists and points elsewhere
    if [[ -L "$dst" ]]; then
      if (( SKILLS_DRY_RUN )); then
        skills_verbose "Would update symlink: $id"
      else
        rm "$dst"
        skills_verbose "Linked: $id"
        created_count=$((created_count + 1))
      fi
    elif [[ -e "$dst" ]]; then
      skills_warn "Skipping '$id': target exists and is not a symlink"
      skipped_count=$((skipped_count + 1))
      continue
    else
      if (( SKILLS_DRY_RUN )); then
        skills_verbose "Would link: $id -> $src"
      else
        ln -s "$src" "$dst"
        skills_verbose "Linked: $id"
        created_count=$((created_count + 1))
      fi
    fi
  done

  # Check for orphaned symlinks
  if [[ -d "$SKILLS_SYMLINK_ROOT" ]]; then
    while IFS= read -r link; do
      [[ -z "$link" ]] && continue
      local target
      if [[ -L "$SKILLS_SYMLINK_ROOT/$link" ]]; then
        target="$(readlink -f "$SKILLS_SYMLINK_ROOT/$link")"
        if [[ ! -d "$target" ]]; then
          orphaned+=("$link")
          orphaned_count=$((orphaned_count + 1))
        fi
      fi
    done < <(find "$SKILLS_SYMLINK_ROOT" -mindepth 1 -maxdepth 1 -type l 2>/dev/null | xargs -I {} basename {} | sort)
  fi

  if (( orphaned_count > 0 )); then
    skills_warn "Found $orphaned_count orphaned symlinks in skills:"
    printf '%s\n' "${orphaned[@]}" | sed 's/^/  /'
    if (( ! SKILLS_PRUNE )); then
      skills_warn "Run 'skill sync --prune' to remove them."
      if (( ! SKILLS_DRY_RUN )); then
        return 1
      fi
    fi
  fi

  # Prune orphaned symlinks if requested
  if (( SKILLS_PRUNE )); then
    if (( orphaned_count > 0 )); then
      for id in "${orphaned[@]}"; do
        if (( SKILLS_DRY_RUN )); then
          skills_verbose "Would remove orphan: $id"
        else
          rm "$SKILLS_SYMLINK_ROOT/$id"
          skills_verbose "Removed orphan: $id"
        fi
      done
      skills_success "$([ $SKILLS_DRY_RUN -eq 1 ] && echo "[DRY-RUN] Would prune" || echo "Pruned") $orphaned_count orphaned symlinks."
    fi
  fi

  if (( SKILLS_VERBOSE )); then
    printf '  Created: %d symlinks\n' "$created_count"
    printf '  Skipped: %d items\n' "$skipped_count"
  fi

  if (( SKILLS_DRY_RUN )); then
    skills_success "[DRY-RUN] Sync complete (no changes made)"
  else
    skills_success "Synced skills."
  fi
}

run_main() {
  local parse_status=0

  skills_parse_opts "$@" || parse_status=$?
  skills_parse_prereqs

  if (( parse_status )); then
    if [[ $parse_status -eq 64 ]]; then
      skills_usage
      return 1
    fi
    return "$parse_status"
  fi

  skills_run
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  run_main "$@"
fi
