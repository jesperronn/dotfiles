#!/usr/bin/env bash
# shellcheck shell=bash

set -euo pipefail

DOTFILES_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OLLAMA_KEEP_ALIVE_DEFAULT="30m"
OLLAMA_LAUNCH_AGENT_LABEL="com.jesperronn.ollama-keep-alive"
OLLAMA_HOMEBREW_PLIST="${OLLAMA_HOMEBREW_PLIST:-/opt/homebrew/opt/ollama/homebrew.mxcl.ollama.plist}"
OLLAMA_PROCESS_NAME="${OLLAMA_PROCESS_NAME:-ollama}"
OLLAMA_PLIST_BUDDY="${OLLAMA_PLIST_BUDDY:-/usr/libexec/PlistBuddy}"
OLLAMA_SUDO_CMD="${OLLAMA_SUDO_CMD:-sudo}"
VERIFY_OLLAMA_FIX=0

verify_ollama_desired_keep_alive() {
  printf '%s\n' "${OLLAMA_KEEP_ALIVE:-$OLLAMA_KEEP_ALIVE_DEFAULT}"
}

verify_ollama_is_macos() {
  [[ "$(uname -s)" == "Darwin" ]]
}

verify_ollama_current_keep_alive() {
  launchctl getenv OLLAMA_KEEP_ALIVE 2>/dev/null || true
}

verify_ollama_set_keep_alive() {
  local desired_keep_alive="$1"

  launchctl setenv OLLAMA_KEEP_ALIVE "$desired_keep_alive"
}

verify_ollama_sync_plist_keep_alive() {
  local plist_path="$1"
  local desired_keep_alive="${OLLAMA_KEEP_ALIVE:-30m}"
  local plist_buddy="/usr/libexec/PlistBuddy"

  [[ "$(uname -s)" == "Darwin" ]] || return 0
  [[ -f "$plist_path" && -w "$plist_path" ]] || return 0
  command -v "$plist_buddy" >/dev/null 2>&1 || return 0

  "$plist_buddy" -c "Add :EnvironmentVariables dict" "$plist_path" 2>/dev/null || true
  "$plist_buddy" -c "Set :EnvironmentVariables:OLLAMA_KEEP_ALIVE $desired_keep_alive" "$plist_path" 2>/dev/null \
    || "$plist_buddy" -c "Add :EnvironmentVariables:OLLAMA_KEEP_ALIVE string $desired_keep_alive" "$plist_path"
}

verify_ollama_sync_homebrew_ollama_plist() {
  verify_ollama_sync_plist_keep_alive "$HOME/Library/LaunchAgents/homebrew.mxcl.ollama.plist"
  verify_ollama_sync_plist_keep_alive "/opt/homebrew/opt/ollama/homebrew.mxcl.ollama.plist"
}

verify_ollama_sync_ollama_keep_alive() {
  local desired_keep_alive="${OLLAMA_KEEP_ALIVE:-30m}"
  local current_keep_alive=""

  [[ "$(uname -s)" == "Darwin" ]] || return 0
  command -v launchctl >/dev/null 2>&1 || return 0

  current_keep_alive="$(launchctl getenv OLLAMA_KEEP_ALIVE 2>/dev/null || true)"
  [[ "$current_keep_alive" == "$desired_keep_alive" ]] && return 0

  launchctl setenv OLLAMA_KEEP_ALIVE "$desired_keep_alive" 2>/dev/null || true
  verify_ollama_sync_homebrew_ollama_plist
}

verify_ollama_print_launch_agent_hint() {
  printf 'LaunchAgent: %s/link-file/Library/LaunchAgents/%s.plist\n' \
    "$DOTFILES_ROOT" "$OLLAMA_LAUNCH_AGENT_LABEL"
}

verify_ollama_fail() {
  local message="$1"
  local next_step="$2"

  printf 'FATAL: %s\n' "$message" >&2
  printf 'next step: %s\n' "$next_step" >&2
  return 1
}

verify_ollama_warn() {
  local message="$1"
  local next_step="$2"

  printf 'FATAL: %s\n' "$message" >&2
  printf 'next step: %s\n' "$next_step" >&2
}

verify_ollama_usage() {
  cat <<EOF
Usage: bin/verify_ollama [--fix]

Options:
  --fix   Repair the Homebrew Ollama plist and restart/start ollama when needed.
  -h, --help  Show this help.
EOF
}

verify_ollama_parse_opts() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --fix)
        VERIFY_OLLAMA_FIX=1
        ;;
      -h|--help)
        verify_ollama_usage
        return 0
        ;;
      *)
        printf 'FATAL: Unknown option: %s\n' "$1" >&2
        printf 'next step: run bin/verify_ollama --help\n' >&2
        return 1
        ;;
    esac
    shift
  done

  return 0
}

verify_ollama_plist_keep_alive() {
  local plist_path="$1"

  "$OLLAMA_PLIST_BUDDY" -c 'Print :EnvironmentVariables:OLLAMA_KEEP_ALIVE' "$plist_path" 2>/dev/null || true
}

verify_ollama_set_plist_keep_alive() {
  local plist_path="$1"
  local desired_keep_alive="$2"
  local plist_cmd=()

  if [[ -w "$plist_path" ]]; then
    plist_cmd=("$OLLAMA_PLIST_BUDDY")
  else
    plist_cmd=("$OLLAMA_SUDO_CMD" "$OLLAMA_PLIST_BUDDY")
  fi

  "${plist_cmd[@]}" -c "Add :EnvironmentVariables dict" "$plist_path" 2>/dev/null || true
  "${plist_cmd[@]}" -c "Set :EnvironmentVariables:OLLAMA_KEEP_ALIVE $desired_keep_alive" "$plist_path" 2>/dev/null \
    || "${plist_cmd[@]}" -c "Add :EnvironmentVariables:OLLAMA_KEEP_ALIVE string $desired_keep_alive" "$plist_path"
}

verify_ollama_running_pid() {
  pgrep -x "$OLLAMA_PROCESS_NAME" 2>/dev/null | head -n 1 || true
}

verify_ollama_running_command() {
  local pid="$1"

  ps -p "$pid" -o command= 2>/dev/null | awk '{$1=$1; print}'
}

run_main() {
  local desired_keep_alive=""
  local plist_keep_alive=""
  local running_pid=""
  local running_command=""
  local fix_applied=0
  local restart_required=0

  verify_ollama_parse_opts "$@" || return $?

  desired_keep_alive="$(verify_ollama_desired_keep_alive)"

  if ! verify_ollama_is_macos; then
    printf 'Skipping: Ollama launchd env setup is only needed on macOS.\n'
    printf 'Desired OLLAMA_KEEP_ALIVE=%s\n' "$desired_keep_alive"
    return 0
  fi

  if ! command -v launchctl >/dev/null 2>&1; then
    printf 'FATAL: launchctl is not available.\n' >&2
    return 1
  fi

  plist_keep_alive="$(verify_ollama_plist_keep_alive "$OLLAMA_HOMEBREW_PLIST")"
  if [[ "$plist_keep_alive" != "$desired_keep_alive" ]]; then
    if (( VERIFY_OLLAMA_FIX )); then
      verify_ollama_warn \
        "Homebrew Ollama plist $OLLAMA_HOMEBREW_PLIST does not set OLLAMA_KEEP_ALIVE=$desired_keep_alive (found: ${plist_keep_alive:-unset})." \
        "bin/verify_ollama --fix, or edit $OLLAMA_HOMEBREW_PLIST, then run 'brew services restart ollama'"
      printf 'editing: adding "OLLAMA_KEEP_ALIVE=%s" to %s\n' "$desired_keep_alive" "$OLLAMA_HOMEBREW_PLIST"
      verify_ollama_set_plist_keep_alive "$OLLAMA_HOMEBREW_PLIST" "$desired_keep_alive"
      plist_keep_alive="$(verify_ollama_plist_keep_alive "$OLLAMA_HOMEBREW_PLIST")"
      if [[ "$plist_keep_alive" == "$desired_keep_alive" ]]; then
        fix_applied=1
        printf 'done, edit successful\n'
        restart_required=1
      else
        printf 'FATAL: Homebrew Ollama plist repair did not stick (found: %s).\n' "${plist_keep_alive:-unset}" >&2
        printf "next step: edit %s, then run 'brew services restart ollama'\n" "$OLLAMA_HOMEBREW_PLIST" >&2
        return 1
      fi
    else
      verify_ollama_fail \
        "Homebrew Ollama plist $OLLAMA_HOMEBREW_PLIST does not set OLLAMA_KEEP_ALIVE=$desired_keep_alive (found: ${plist_keep_alive:-unset})." \
        "bin/verify_ollama --fix, or edit $OLLAMA_HOMEBREW_PLIST, then run 'brew services restart ollama'"
      return 1
    fi
  fi

  running_pid="$(verify_ollama_running_pid)"
  if [[ -z "$running_pid" ]]; then
    if (( VERIFY_OLLAMA_FIX )); then
      printf 'FATAL: Ollama is not running.\n' >&2
      printf 'next step: brew services start ollama\n' >&2
    else
      verify_ollama_fail \
        "Ollama is not running." \
        "brew services start ollama"
      return 1
    fi
  fi

  if [[ -n "$running_pid" ]]; then
    running_command="$(verify_ollama_running_command "$running_pid")"
    if [[ "$running_command" != *"$OLLAMA_PROCESS_NAME serve"* ]]; then
      verify_ollama_fail \
        "Running process $running_pid does not look like ollama serve: $running_command" \
        "brew services restart ollama"
      return 1
    fi
  fi

  if [[ "$(verify_ollama_current_keep_alive)" == "$desired_keep_alive" ]]; then
    printf 'OLLAMA_KEEP_ALIVE already set to %s for this login session.\n' "$desired_keep_alive"
  else
    verify_ollama_sync_ollama_keep_alive
    if (( ! fix_applied )); then
      restart_required=1
    fi
    printf 'Set OLLAMA_KEEP_ALIVE=%s for this login session.\n' "$desired_keep_alive"
  fi

  printf 'Homebrew plist: %s has OLLAMA_KEEP_ALIVE=%s\n' "$OLLAMA_HOMEBREW_PLIST" "$plist_keep_alive"
  if [[ -n "$running_pid" ]]; then
    printf 'Running ollama: pid %s (%s)\n' "$running_pid" "$running_command"
  else
    printf 'Running ollama: not running\n'
  fi
  verify_ollama_print_launch_agent_hint

  if (( VERIFY_OLLAMA_FIX )) && (( restart_required )); then
    printf 'next step: brew services restart ollama\n'
  elif (( restart_required )); then
    printf 'Restart Ollama and any VS Code windows that should inherit the updated env.\n'
  fi
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  run_main "$@"
fi
