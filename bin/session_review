#!/usr/bin/env python3
"""session_review — review coding-agent sessions as good / bad / outlier examples (e.g. for a talk).

Usage: session_review shortlist|show|overview [--harness copilot|claude] ...   (see each subcommand's --help)
  shortlist  rank sessions and optionally copy the interesting ones into a folder (--copy DIR)
  show       render one session as a self-contained HTML transcript
  overview   build an overview page (favourites, tags, notes) plus transcripts for a folder of copied sessions
Adapters under lib/session_review/adapters/ read each harness's own log format; add one to support a new harness.
Local only, no LLM calls, no network.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"))

from session_review.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
