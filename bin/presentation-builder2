#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: $(basename "$0") <input.md>" >&2
  exit 1
fi

INPUT="$1"

if [[ ! -f "$INPUT" ]]; then
  echo "Error: file not found: $INPUT" >&2
  exit 1
fi

BASENAME="${INPUT%.md}"
OUTPUT="${BASENAME}.html"
MARKDOWN_CONTENT="$(cat "$INPUT")"

cat > "$OUTPUT" <<'HTMLEOF'
<!DOCTYPE html>
<html lang="da">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Præsentation</title>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<style>
/* ── Theme ─────────────────────────────────────────────────── */
