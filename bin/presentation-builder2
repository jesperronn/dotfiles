</head>
<body>

<script type="text/markdown" id="source">
HTMLEOF

# Append markdown content (avoid heredoc to preserve special chars)
printf '%s\n' "$MARKDOWN_CONTENT" >> "$OUTPUT"

cat >> "$OUTPUT" <<'HTMLEOF'
</script>

<div class="deck" id="deck"></div>

<script>
(function () {

  /* ── Build DOM from markdown ──────────────────────── */
  const source = document.getElementById('source').textContent;
  const allBlocks = source.split(/\n\s*---\s*\n/).map(s => s.trim()).filter(Boolean);
  const blocks = allBlocks.filter(b => !/^\[slide:hidden\]/m.test(b.split('\n')[0]));
  const deck   = document.getElementById('deck');
  const ids    = blocks.map((_, i) => `s${i + 1}`);

  marked.setOptions({ gfm: true, breaks: false });

  blocks.forEach((block, i) => {
    const section = document.createElement('section');
    section.className = 'slide';
    section.id = ids[i];

    const numSpan = document.createElement('span');
    numSpan.className = 'slide-num';
    numSpan.textContent = `${String(i + 1).padStart(2,'0')} / ${String(blocks.length).padStart(2,'0')}`;

    const content = document.createElement('div');
    content.innerHTML = marked.parse(block);

    section.appendChild(numSpan);
    section.appendChild(content);
    deck.appendChild(section);
  });

  /* ── Nav ──────────────────────────────────────────── */
  const nav = document.createElement('nav');

  const dotsEl = document.createElement('div');
  dotsEl.className = 'dots';
  ids.forEach((id, i) => {
    const a = document.createElement('a');
    a.className = 'dot';
    a.href = '#' + id;
    a.setAttribute('aria-label', `Slide ${i + 1}`);
    a.addEventListener('click', () => setTimeout(() => goTo(i), 0));
    dotsEl.appendChild(a);
  });

  const navRight = document.createElement('div');
  navRight.className = 'nav-right';

  const hint = document.createElement('span');
  hint.style.cssText = 'display:flex;gap:4px;align-items:center';
  hint.innerHTML = '<span class="key">←</span><span class="key">→</span>';

  const btnPrev = document.createElement('a');
  btnPrev.id = 'btn-prev';
  btnPrev.className = 'btn';
  btnPrev.textContent = '← prev';
  btnPrev.addEventListener('click', () => setTimeout(() => goTo(current() - 1), 0));

  const btnNext = document.createElement('a');
  btnNext.id = 'btn-next';
  btnNext.className = 'btn';
  btnNext.textContent = 'next →';
  btnNext.addEventListener('click', () => setTimeout(() => goTo(current() + 1), 0));

  const btnFs = document.createElement('button');
  btnFs.className = 'btn btn-fs';
  btnFs.setAttribute('aria-label', 'Toggle fullscreen');
  btnFs.textContent = '⛶ F';
  btnFs.addEventListener('click', toggleFullscreen);

  navRight.append(hint, btnPrev, btnNext, btnFs);
  nav.append(dotsEl, navRight);
  deck.appendChild(nav);

  /* ── Navigation logic ─────────────────────────────── */
  function current() {
    const idx = ids.indexOf(location.hash.slice(1));
    return idx === -1 ? 0 : idx;
  }

  function goTo(i) {
    i = Math.max(0, Math.min(ids.length - 1, i));
    location.hash = ids[i];
    updateNav(i);
  }

  function updateNav(i) {
    document.querySelectorAll('.dot').forEach((d, j) => {
      d.classList.toggle('active', j === i);
    });
    document.getElementById('btn-prev').href = '#' + ids[Math.max(0, i - 1)];
    document.getElementById('btn-next').href = '#' + ids[Math.min(ids.length - 1, i + 1)];
  }

  window.addEventListener('hashchange', () => updateNav(current()));

  document.addEventListener('keydown', e => {
    if (e.key === 'ArrowRight') goTo(current() + 1);
    if (e.key === 'ArrowLeft')  goTo(current() - 1);
    if (e.key === 'f' || e.key === 'F') toggleFullscreen();
  });

  /* ── Fullscreen ───────────────────────────────────── */
  function toggleFullscreen() {
    if (!document.fullscreenElement) {
      document.documentElement.requestFullscreen();
    } else {
      document.exitFullscreen();
    }
  }

  /* ── Init ─────────────────────────────────────────── */
  goTo(current());

})();
</script>

</body>
</html>
HTMLEOF

echo "Built: $OUTPUT"

echo "Press 'o' to open now (auto-skip in 5s)..."
for i in 5 4 3 2 1; do
  if read -r -s -n 1 -t 1 key; then
    if [[ "$key" == "o" || "$key" == "O" ]]; then
      open "$OUTPUT"
      exit 0
    fi
  else
    printf '\r%ds remaining... ' "$((i - 1))"
  fi
done
echo
