}

.slide ol li {
  counter-increment: item;
}

.slide ol li::before {
  content: counter(item) '.';
  position: absolute;
  left: 0;
  color: var(--accent);
  font-weight: 600;
}

.slide a { color: var(--accent); }

.slide strong { color: var(--fg); }

