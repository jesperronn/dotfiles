}

.slide pre code {
  background: none;
  border: none;
  padding: 0;
  color: var(--fg);
  font-size: 0.9rem;
  line-height: 1.6;
}

/* ── Tables ─────────────────────────────────────────────────── */
.slide table {
  border-collapse: collapse;
  width: 100%;
  margin-bottom: 1rem;
