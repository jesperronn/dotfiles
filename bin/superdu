#!/usr/bin/env bash
# shellcheck shell=bash

set -euo pipefail

SUPER_DU_COLOR_ENABLED=1
SUPER_DU_COLOR_MODE="auto"
SUPER_DU_VERBOSE=0
SUPER_DU_PROGRESSIVE=1
SUPER_DU_TTY_ACTIVE=0
SUPER_DU_RENDERED_LINES=0
SUPER_DU_HEADER_PRINTED=0
SUPER_DU_WARNINGS_PRINTED=0

SUPER_DU_GROUP_DOWNLOADS=1
SUPER_DU_GROUP_DESKTOP=1
SUPER_DU_GROUP_DOCUMENTS=1
SUPER_DU_GROUP_PHOTOS=1
SUPER_DU_GROUP_MUSIC=1
SUPER_DU_GROUP_TV=1
SUPER_DU_GROUP_OLLAMA=1
SUPER_DU_GROUP_BREW=1
SUPER_DU_POSITIVE_GROUP_FLAGS=0

SUPER_DU_CATEGORY_ROWS=()
SUPER_DU_OLLAMA_WARNINGS=()

C_DIM=$'\033[2m'
C_BOLD=$'\033[1m'
C_RED=$'\033[31m'
C_GREEN=$'\033[32m'
C_PURPLE=$'\033[38;5;141m'
C_MAGENTA=$'\033[35m'
C_ORANGE=$'\033[38;5;214m'
C_0=$'\033[0m'

superdu_usage() {
  local header_style="" flag_style="" command_style="" parameter_style="" reset_style=""

  if (( SUPER_DU_COLOR_ENABLED )); then
    header_style="${C_BOLD}${C_ORANGE}"
    flag_style="$C_GREEN"
    command_style="${C_BOLD}${C_PURPLE}"
    parameter_style="$C_MAGENTA"
    reset_style="$C_0"
  fi

  printf 'Read-only disk usage overview for large user-data categories.\n\n'
  printf '%sUsage:%s %ssuperdu%s %s[OPTIONS]%s\n\n' "$header_style" "$reset_style" "$command_style" "$reset_style" "$parameter_style" "$reset_style"
  printf '%sOverall flags:%s\n' "$header_style" "$reset_style"
  printf '  %s--overview%s         Show the overview report (default).\n' "$flag_style" "$reset_style"
  printf '  %s--verbose%s          Print extra discovery details.\n' "$flag_style" "$reset_style"
  printf '  %s--progressive%s      Redraw the TTY leaderboard while categories complete (default).\n' "$flag_style" "$reset_style"
  printf '  %s--plain%s            Disable live TTY redraws and print only the final summary.\n' "$flag_style" "$reset_style"
  printf '  %s--color%s            Force colored output.\n' "$flag_style" "$reset_style"
  printf '  %s--no-color%s         Disable colored output.\n' "$flag_style" "$reset_style"
  printf '  %s-h, --help%s         Show this help.\n\n' "$flag_style" "$reset_style"
  printf '%sCategory flags:%s\n' "$header_style" "$reset_style"
  printf '  %s--downloads, --no-downloads%s   Include or exclude ~/Downloads.\n' "$flag_style" "$reset_style"
  printf '  %s--desktop, --no-desktop%s       Include or exclude ~/Desktop.\n' "$flag_style" "$reset_style"
  printf '  %s--documents, --no-documents%s   Include or exclude ~/Documents.\n' "$flag_style" "$reset_style"
  printf '  %s--photos, --no-photos%s         Include or exclude ~/Photos.\n' "$flag_style" "$reset_style"
  printf '  %s--music, --no-music%s           Include or exclude ~/Music.\n' "$flag_style" "$reset_style"
  printf '  %s--tv, --no-tv%s                 Include or exclude ~/TV.\n' "$flag_style" "$reset_style"
  printf '  %s--ollama, --no-ollama%s         Include or exclude Ollama model storage.\n' "$flag_style" "$reset_style"
  printf '  %s--brew, --no-brew%s             Include or exclude Homebrew storage.\n' "$flag_style" "$reset_style"
}

superdu_log() {
  printf '%s\n' "$*"
}

superdu_color_print() {
  local color=$1
  shift

  if (( SUPER_DU_COLOR_ENABLED )); then
    printf '%s%s%s\n' "$color" "$*" "$C_0"
  else
    printf '%s\n' "$*"
  fi
}

superdu_info() {
  superdu_color_print "${C_BOLD}${C_ORANGE}" "$*"
}

superdu_warn() {
  superdu_color_print "$C_RED" "$*" >&2
}

superdu_verbose() {
  if (( SUPER_DU_VERBOSE )); then
    superdu_color_print "$C_DIM" "$*"
  fi
}

superdu_parse_prereqs() {
  case "$SUPER_DU_COLOR_MODE" in
    always) SUPER_DU_COLOR_ENABLED=1 ;;
    never) SUPER_DU_COLOR_ENABLED=0 ;;
    auto)
      if [[ -n "${NO_COLOR:-}" ]]; then
        SUPER_DU_COLOR_ENABLED=0
      elif [[ -t 1 ]]; then
        SUPER_DU_COLOR_ENABLED=1
      else
        SUPER_DU_COLOR_ENABLED=0
      fi
      ;;
  esac

  if [[ -t 1 ]] && (( SUPER_DU_PROGRESSIVE )); then
    SUPER_DU_TTY_ACTIVE=1
  else
    SUPER_DU_TTY_ACTIVE=0
  fi
}

superdu_running_on_macos() {
  [[ "$OSTYPE" == darwin* ]]
}

superdu_any_protected_group_enabled() {
  superdu_group_enabled downloads || \
    superdu_group_enabled desktop || \
    superdu_group_enabled documents || \
    superdu_group_enabled photos || \
    superdu_group_enabled music || \
    superdu_group_enabled tv
}

superdu_full_disk_access_probe_path() {
  printf '%s\n' "$HOME/Library/Application Support/com.apple.TCC/TCC.db"
}

superdu_full_disk_access_url() {
  printf '%s\n' 'x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles'
}

superdu_detect_host_app() {
  local term_program="${TERM_PROGRAM:-}"
  local shell_name parent_name

  if [[ -n "$term_program" ]]; then
    printf '%s\n' "$term_program"
    return 0
  fi

  shell_name=$(ps -p $$ -o comm= 2>/dev/null | awk -F/ 'NR==1 {print $NF}')
  parent_name=$(ps -p "$PPID" -o comm= 2>/dev/null | awk -F/ 'NR==1 {print $NF}')

  if [[ -n "$parent_name" && "$parent_name" != "$shell_name" ]]; then
    printf '%s\n' "$parent_name"
    return 0
  fi

  if [[ -n "$shell_name" ]]; then
    printf '%s\n' "$shell_name"
    return 0
  fi

  printf '%s\n' 'your terminal app'
}

superdu_offer_open_full_disk_access() {
  local reply=""

  [[ -t 0 && -t 1 ]] || return 0

  printf 'Open System Settings to Full Disk Access? [yN] '
  if read -r -t 5 -n 1 reply; then
    printf '\n'
    if [[ "$reply" =~ ^[Yy]$ ]]; then
      open "$(superdu_full_disk_access_url)" >/dev/null 2>&1 || superdu_warn "Could not open System Settings automatically."
    fi
    return 0
  fi

  printf '\n'
}

superdu_has_macos_protected_access() {
  local probe_path

  probe_path=$(superdu_full_disk_access_probe_path)
  [[ -r "$probe_path" ]]
}

superdu_require_macos_protected_access() {
  if ! superdu_running_on_macos; then
    return 0
  fi

  if ! superdu_any_protected_group_enabled; then
    return 0
  fi

  if superdu_has_macos_protected_access; then
    return 0
  fi

  superdu_warn "macOS privacy preflight failed."
  superdu_log "Grant Full Disk Access to $(superdu_detect_host_app) once, then rerun."
  superdu_log 'Suggested path: System Settings -> Privacy & Security -> Full Disk Access.'
  superdu_log 'This avoids repeated Desktop/Documents/Downloads/media access prompts during scans.'
  superdu_offer_open_full_disk_access
  return 1
}

superdu_enable_only_mode() {
  if (( SUPER_DU_POSITIVE_GROUP_FLAGS )); then
    return 0
  fi

  SUPER_DU_POSITIVE_GROUP_FLAGS=1
  SUPER_DU_GROUP_DOWNLOADS=0
  SUPER_DU_GROUP_DESKTOP=0
  SUPER_DU_GROUP_DOCUMENTS=0
  SUPER_DU_GROUP_PHOTOS=0
  SUPER_DU_GROUP_MUSIC=0
  SUPER_DU_GROUP_TV=0
  SUPER_DU_GROUP_OLLAMA=0
  SUPER_DU_GROUP_BREW=0
}

superdu_set_group() {
  local group=$1
  local value=$2

  case "$group" in
    downloads) SUPER_DU_GROUP_DOWNLOADS=$value ;;
    desktop) SUPER_DU_GROUP_DESKTOP=$value ;;
    documents) SUPER_DU_GROUP_DOCUMENTS=$value ;;
    photos) SUPER_DU_GROUP_PHOTOS=$value ;;
    music) SUPER_DU_GROUP_MUSIC=$value ;;
    tv) SUPER_DU_GROUP_TV=$value ;;
    ollama) SUPER_DU_GROUP_OLLAMA=$value ;;
    brew) SUPER_DU_GROUP_BREW=$value ;;
  esac
}

superdu_group_enabled() {
  case "$1" in
    downloads) (( SUPER_DU_GROUP_DOWNLOADS )) ;;
    desktop) (( SUPER_DU_GROUP_DESKTOP )) ;;
    documents) (( SUPER_DU_GROUP_DOCUMENTS )) ;;
    photos) (( SUPER_DU_GROUP_PHOTOS )) ;;
    music) (( SUPER_DU_GROUP_MUSIC )) ;;
    tv) (( SUPER_DU_GROUP_TV )) ;;
    ollama) (( SUPER_DU_GROUP_OLLAMA )) ;;
    brew) (( SUPER_DU_GROUP_BREW )) ;;
    *) return 1 ;;
  esac
}

superdu_parse_opts() {
  local show_help=0

  while (($#)); do
    case "$1" in
      --overview)
        ;;
      --verbose)
        SUPER_DU_VERBOSE=1
        ;;
      --progressive)
        SUPER_DU_PROGRESSIVE=1
        ;;
      --plain)
        SUPER_DU_PROGRESSIVE=0
        ;;
      --color)
        SUPER_DU_COLOR_MODE="always"
        ;;
      --no-color)
        SUPER_DU_COLOR_MODE="never"
        ;;
      --downloads|--desktop|--documents|--photos|--music|--tv|--ollama|--brew)
        superdu_enable_only_mode
        superdu_set_group "${1#--}" 1
        ;;
      --no-downloads|--no-desktop|--no-documents|--no-photos|--no-music|--no-tv|--no-ollama|--no-brew)
        superdu_set_group "${1#--no-}" 0
        ;;
      -h|--help)
        show_help=1
        ;;
      *)
        superdu_warn "Unknown option: $1"
        superdu_usage >&2
        return 2
        ;;
    esac
    shift
  done

  if (( show_help )); then
    superdu_parse_prereqs
    superdu_usage
    return 1
  fi

  return 0
}

superdu_format_kb() {
  local size_kb=${1:-0}

  awk -v size_kb="$size_kb" '
    function human(value, unit) {
      if (unit == "KB") return sprintf("%.1f KB", value)
      if (unit == "MB") return sprintf("%.1f MB", value)
      if (unit == "GB") return sprintf("%.2f GB", value)
      return sprintf("%.2f TB", value)
    }
    BEGIN {
      if (size_kb < 1024) {
        print human(size_kb, "KB")
      } else if (size_kb < 1024 * 1024) {
        print human(size_kb / 1024, "MB")
      } else if (size_kb < 1024 * 1024 * 1024) {
        print human(size_kb / (1024 * 1024), "GB")
      } else {
        print human(size_kb / (1024 * 1024 * 1024), "TB")
      }
    }
  '
}

superdu_path_size_kb() {
  local path=$1
  local du_output

  [[ -e "$path" ]] || {
    printf '0\n'
    return 0
  }

  du_output=$(du -sk "$path" 2>/dev/null || true)
  if [[ -z "$du_output" ]]; then
    printf '0\n'
    return 0
  fi

  awk '{print $1 + 0}' <<<"$du_output"
}

superdu_realpath() {
  local path=$1
  local parent

  [[ -e "$path" ]] || return 1
  if [[ -d "$path" ]]; then
    (cd "$path" 2>/dev/null && pwd -P) || return 1
    return 0
  fi
  parent=$(cd "$(dirname "$path")" 2>/dev/null && pwd -P) || return 1
  printf '%s/%s\n' "$parent" "$(basename "$path")"
}

superdu_dedupe_existing_paths() {
  local path resolved

  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    [[ -e "$path" ]] || continue
    resolved=$(superdu_realpath "$path" 2>/dev/null || printf '%s' "$path")
    [[ -n "$resolved" ]] || continue
    printf '%s\n' "$resolved"
  done | awk 'NF && !seen[$0]++ { print $0 }'
}

superdu_first_existing_path() {
  local path

  for path in "$@"; do
    [[ -e "$path" ]] || continue
    printf '%s\n' "$path"
    return 0
  done

  if (($# > 0)); then
    printf '%s\n' "$1"
  fi
}

superdu_discover_ollama_paths() {
  printf '%s\n' \
    "$HOME/.ollama/models/blobs" \
    "/Users/$USER/.ollama/models/blobs" \
    "/System/Volumes/Data/Users/$USER/.ollama/models/blobs" \
    "/Users/workbrew/.ollama/models/blobs" \
    "/System/Volumes/Data/Users/workbrew/.ollama/models/blobs" | superdu_dedupe_existing_paths
}

superdu_discover_brew_bins() {
  type -a brew 2>/dev/null | awk '{print $3}' | awk 'NF && !seen[$0]++ { print $0 }'
}

superdu_discover_brew_paths() {
  local brew_bin path

  while IFS= read -r brew_bin; do
    [[ -x "$brew_bin" ]] || continue
    for path in \
      "$("$brew_bin" --cache 2>/dev/null || true)" \
      "$("$brew_bin" --cellar 2>/dev/null || true)" \
      "$("$brew_bin" --prefix 2>/dev/null || true)"; do
      [[ -n "$path" ]] && printf '%s\n' "$path"
    done
  done < <(superdu_discover_brew_bins) | superdu_dedupe_existing_paths
}

superdu_emit_paths_for_group() {
  case "$1" in
    downloads) printf '%s\n' "$HOME/Downloads" ;;
    desktop) printf '%s\n' "$HOME/Desktop" ;;
    documents) printf '%s\n' "$HOME/Documents" ;;
    photos) superdu_first_existing_path "$HOME/Pictures" "$HOME/Photos" ;;
    music) printf '%s\n' "$HOME/Music" ;;
    tv) superdu_first_existing_path "$HOME/Movies" "$HOME/TV" ;;
    ollama) superdu_discover_ollama_paths ;;
    brew) superdu_discover_brew_paths ;;
  esac
}

superdu_sum_paths_kb() {
  local total_kb=0
  local path size_kb

  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    size_kb=$(superdu_path_size_kb "$path")
    total_kb=$(( total_kb + size_kb ))
  done

  printf '%s\n' "$total_kb"
}

superdu_group_label() {
  case "$1" in
    downloads) printf '%s' 'downloads' ;;
    desktop) printf '%s' 'desktop' ;;
    documents) printf '%s' 'documents' ;;
    photos) printf '%s' 'photos' ;;
    music) printf '%s' 'music' ;;
    tv) printf '%s' 'tv' ;;
    ollama) printf '%s' 'ollama-models' ;;
    brew) printf '%s' 'brew-storage' ;;
  esac
}

superdu_group_display() {
  case "$1" in
    downloads) printf '%s' "$HOME/Downloads" ;;
    desktop) printf '%s' "$HOME/Desktop" ;;
    documents) printf '%s' "$HOME/Documents" ;;
    photos) superdu_first_existing_path "$HOME/Pictures" "$HOME/Photos" ;;
    music) printf '%s' "$HOME/Music" ;;
    tv) superdu_first_existing_path "$HOME/Movies" "$HOME/TV" ;;
    ollama) printf '%s' 'Ollama model blob roots' ;;
    brew) printf '%s' 'Homebrew cache + cellar + prefix' ;;
  esac
}

superdu_group_next_step() {
  case "$1" in
    downloads) printf '%s' 'next: superclean --downloads --interactive --dry-run' ;;
    desktop) printf '%s' 'next: superclean --desktop --interactive --dry-run' ;;
    documents) printf '%s' 'next: superclean --documents --interactive --dry-run' ;;
    photos) printf '%s' 'next: inspect largest libraries/files and review duplicates manually' ;;
    music) printf '%s' 'next: inspect largest albums/files and review duplicates manually' ;;
    tv) printf '%s' 'next: inspect largest seasons/files and remove unneeded copies manually' ;;
    ollama) printf '%s' 'next: ollama list  or  rm -rf <store-folder> manually' ;;
    brew) printf '%s' 'next: superclean --brew --dry-run' ;;
  esac
}

superdu_format_next_step_line() {
  local text=$1
  local prefix='next: '
  local command="${text#"$prefix"}"

  if (( SUPER_DU_COLOR_ENABLED )); then
    printf '        %snext:%s %s%s%s\n' "$C_DIM" "$C_0" "$C_PURPLE" "$command" "$C_0"
  else
    printf '        next: %s\n' "$command"
  fi
}

superdu_render_bar() {
  local size_kb=$1
  local max_kb=$2
  local width=${3:-26}
  local filled=0 empty=0

  if (( max_kb > 0 && size_kb > 0 )); then
    filled=$(( (size_kb * width + max_kb - 1) / max_kb ))
    (( filled > width )) && filled=$width
  fi
  empty=$(( width - filled ))

  printf '%*s' "$filled" '' | tr ' ' '#'
  printf '%*s' "$empty" '' | tr ' ' ' '
}

superdu_percent_of_max() {
  local size_kb=$1
  local max_kb=$2

  if (( max_kb <= 0 || size_kb <= 0 )); then
    printf '  0%%'
    return 0
  fi

  printf '%3d%%' $(( (size_kb * 100) / max_kb ))
}

superdu_build_category_rows() {
  local row max_kb=0
  local -a rows=()

  while IFS= read -r row; do
    [[ -n "$row" ]] && rows+=("$row")
  done < <(printf '%s\n' "${SUPER_DU_CATEGORY_ROWS[@]}" | awk 'NF' | sort -t $'\t' -k1,1nr -k2,2)

  ((${#rows[@]} > 0)) || return 0

  max_kb=${rows[0]%%$'\t'*}

  for row in "${rows[@]}"; do
    local size_kb group label display next bar percent
    IFS=$'\t' read -r size_kb group label display next <<<"$row"
    bar=$(superdu_render_bar "$((10#$size_kb))" "$((10#$max_kb))")
    percent=$(superdu_percent_of_max "$((10#$size_kb))" "$((10#$max_kb))")
    printf '  %10s  %-14s [%s] %s  %s\n' \
      "$(superdu_format_kb "$((10#$size_kb))")" \
      "$label" \
      "$bar" \
      "$percent" \
      "$display"
    superdu_format_next_step_line "$next"
  done
}

superdu_clear_rendered_lines() {
  local i

  if (( ! SUPER_DU_TTY_ACTIVE || SUPER_DU_RENDERED_LINES <= 0 )); then
    return 0
  fi

  for ((i = 0; i < SUPER_DU_RENDERED_LINES; i++)); do
    printf '\r\033[2K'
    if (( i + 1 < SUPER_DU_RENDERED_LINES )); then
      printf '\033[1A'
    fi
  done
}

superdu_render_overview() {
  local rendered_rows="" warning line_count=0

  if (( SUPER_DU_TTY_ACTIVE )); then
    superdu_clear_rendered_lines
  fi

  if (( ! SUPER_DU_HEADER_PRINTED )); then
    superdu_info "[+] Inventory: system-scale disk usage overview"
    superdu_log '  DRY_RUN only. This command never deletes files.'
    SUPER_DU_HEADER_PRINTED=1
  fi

  rendered_rows=$(superdu_build_category_rows)
  if [[ -n "$rendered_rows" ]]; then
    printf '%s\n' "$rendered_rows"
    line_count=$(( $(printf '%s\n' "$rendered_rows" | wc -l | awk '{print $1 + 0}') ))
  else
    superdu_log '  no configured categories found'
    line_count=1
  fi

  if (( SUPER_DU_TTY_ACTIVE )); then
    SUPER_DU_RENDERED_LINES=$line_count
  fi
}

superdu_print_warnings() {
  local warning

  (( SUPER_DU_WARNINGS_PRINTED == 0 )) || return 0

  for warning in "${SUPER_DU_OLLAMA_WARNINGS[@]}"; do
    if (( SUPER_DU_COLOR_ENABLED )); then
      printf '%s%s%s\n' "$C_RED" "$warning" "$C_0" >&2
      printf '        %snext:%s %s%s%s\n' "$C_DIM" "$C_0" "$C_PURPLE" "ollama list  or  rm -rf <store-folder> manually" "$C_0" >&2
    else
      printf '%s\n' "$warning" >&2
      printf '        next: %s\n' 'ollama list  or  rm -rf <store-folder> manually' >&2
    fi
  done

  SUPER_DU_WARNINGS_PRINTED=1
}

superdu_append_category_row() {
  local group=$1
  local size_kb=$2

  SUPER_DU_CATEGORY_ROWS+=("$(printf '%012d\t%s\t%s\t%s\t%s' \
    "$size_kb" \
    "$group" \
    "$(superdu_group_label "$group")" \
    "$(superdu_group_display "$group")" \
    "$(superdu_group_next_step "$group")")")
}

superdu_scan_group() {
  local group=$1
  local size_kb=0
  local root_count=0

  superdu_verbose "Scanning $group"

  if [[ "$group" == "ollama" ]]; then
    root_count=$(superdu_discover_ollama_paths | awk 'END { print NR + 0 }')
    if (( root_count > 1 )); then
      SUPER_DU_OLLAMA_WARNINGS+=("Warning: multiple Ollama model roots found; totals combine distinct locations.")
    fi
  fi

  size_kb=$(superdu_emit_paths_for_group "$group" | superdu_sum_paths_kb)
  superdu_append_category_row "$group" "$size_kb"
  if (( SUPER_DU_TTY_ACTIVE )); then
    superdu_render_overview
  fi
}

superdu_run_overview() {
  local group

  SUPER_DU_CATEGORY_ROWS=()
  SUPER_DU_OLLAMA_WARNINGS=()
  SUPER_DU_HEADER_PRINTED=0
  SUPER_DU_WARNINGS_PRINTED=0

  for group in downloads desktop documents photos music tv ollama brew; do
    superdu_group_enabled "$group" || continue
    superdu_scan_group "$group"
  done

  if (( ! SUPER_DU_TTY_ACTIVE )); then
    superdu_render_overview
  fi

  superdu_print_warnings
}

run_main() {
  superdu_parse_opts "$@" || return $?
  superdu_parse_prereqs
  superdu_require_macos_protected_access || return 1
  superdu_run_overview
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  run_main "$@"
fi
