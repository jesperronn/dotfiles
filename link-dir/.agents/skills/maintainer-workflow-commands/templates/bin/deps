#!/usr/bin/env bash
# deps — list outdated dependencies, or update them up to a level. Never commits.
# shellcheck disable=SC2329 # run_step and the deps_<group> dispatch call these indirectly
set -euo pipefail
# shellcheck source=lib/project.sh disable=SC1091
source "${BASH_SOURCE[0]%/*}/lib/project.sh"

usage() {
  cat <<'USAGE'
Usage: bin/deps [--patch|--minor|--major] [--ruby] [--js] [--go] [--java] [--dry-run] [PACKAGE...]

No level: read-only list of outdated direct dependencies.
A level updates up to it (mutually exclusive); scope flags pick ecosystems
(default: all detected). Named packages need exactly one scope flag.
  ruby   bundle outdated --only-explicit | bundle update --patch|--minor|(all)
  js     npx npm-check-updates [--target L -u], then <pm> install
  go     go list -u -m | go get -u=patch|(-u) ./..., go mod tidy; major is by hand (/vN)
  java   mvn versions:display-dependency-updates | versions:use-latest-releases;
         gradle: ben-manes dependencyUpdates to list, edit versions by hand
Never commits: run bin/test and bin/lint, then commit.
Exit: 0 ok, 1 a step failed, 9 tool missing, 2 usage. Env: DRY_RUN=1 like --dry-run.
USAGE
}

LEVEL=""
PKGS=()

# Outdated listers exit 1 when something is outdated; that is not a failure.
ruby_list() { bundle outdated --only-explicit || [[ $? -eq 1 ]]; }

deps_ruby() {
  local flag=()
  if [[ -z "$LEVEL" ]]; then
    run_step "ruby outdated" ruby_list
    return
  fi
  [[ "$LEVEL" != major ]] && flag=("--$LEVEL")
  run_step "ruby bundle update $LEVEL" bundle update ${flag[@]+"${flag[@]}"} ${PKGS[@]+"${PKGS[@]}"}
}

js_update() {
  local filter=()
  local target="$1"
  [[ "$target" == major ]] && target=latest
  [[ ${#PKGS[@]} -gt 0 ]] && filter=(--filter "$(join_csv "${PKGS[@]}")")
  npx --yes npm-check-updates --target "$target" -u ${filter[@]+"${filter[@]}"} && "$(js_pm)" install
}

deps_js() {
  if [[ -z "$LEVEL" ]]; then
    run_step "js outdated" npx --yes npm-check-updates
    return
  fi
  run_step "js update $LEVEL" js_update "$LEVEL"
}

go_update() { go get "$@" && go mod tidy; }

deps_go() {
  local flag=(-u)
  if [[ -z "$LEVEL" ]]; then
    run_step "go outdated" go list -u -m -f '{{if and (not .Indirect) .Update}}{{.Path}} {{.Version}} -> {{.Update.Version}}{{end}}' all
    return
  fi
  if [[ "$LEVEL" == major ]]; then
    skip_step "go major" "a major version changes the import path (/vN): edit imports and go.mod by hand"
    return
  fi
  [[ "$LEVEL" == patch ]] && flag=(-u=patch)
  run_step "go get $LEVEL" go_update "${flag[@]}" "${PKGS[@]:-./...}"
}

# versions:commit drops the pom.xml.versionsBackup files the plugin leaves.
java_update() {
  local tool="$1"
  shift
  "$tool" -B versions:use-latest-releases "$@" && "$tool" -B versions:commit
}

deps_java() {
  local tool allow=()
  tool="$(java_tool)"
  if is_gradle; then
    if [[ -z "$LEVEL" ]]; then
      run_step "java gradle dependencyUpdates" "$tool" dependencyUpdates
    else
      skip_step "java $LEVEL" "gradle has no portable updater: edit libs.versions.toml or build.gradle"
    fi
    return
  fi
  if [[ -z "$LEVEL" ]]; then
    run_step "java outdated" "$tool" -B versions:display-dependency-updates
    return
  fi
  case "$LEVEL" in
    patch) allow=(-DallowMajorUpdates=false -DallowMinorUpdates=false) ;;
    minor) allow=(-DallowMajorUpdates=false) ;;
  esac
  run_step "java versions:use-latest-releases $LEVEL" java_update "$tool" ${allow[@]+"${allow[@]}"} \
    ${PKGS[@]+"-Dincludes=$(join_csv "${PKGS[@]}")"}
}

main() {
  local arg g
  local groups=()
  while [[ $# -gt 0 ]]; do
    arg="$1"
    shift
    case "$arg" in
      -h | --help)
        usage
        exit 0
        ;;
      --dry-run) export DRY_RUN=1 ;;
      --patch | --minor | --major)
        [[ -z "$LEVEL" || "$LEVEL" == "${arg#--}" ]] || die_usage "--patch, --minor and --major are mutually exclusive"
        LEVEL="${arg#--}"
        ;;
      --*) select_group_flag "$arg" || die_usage "unknown option: $arg" ;;
      -*) die_usage "unknown option: $arg" ;;
      *) PKGS+=("$arg") ;;
    esac
  done
  if [[ ${#PKGS[@]} -gt 0 ]]; then
    [[ -n "$LEVEL" ]] || die_usage "named packages need a level (--patch, --minor or --major)"
    [[ ${#SELECTED_GROUPS[@]} -eq 1 ]] || die_usage "named packages need exactly one scope flag, e.g. --ruby"
  fi
  while IFS= read -r g; do groups+=("$g"); done < <(groups_to_run)
  local deps_groups=()
  for g in ${groups[@]+"${groups[@]}"}; do [[ "$g" == bash ]] || deps_groups+=("$g"); done
  if [[ ${#deps_groups[@]} -eq 0 ]]; then
    echo "no dependency manifest found (Gemfile, package.json, go.mod, pom.xml, build.gradle)" >&2
    exit "$EX_FAILED"
  fi
  for g in "${deps_groups[@]}"; do "deps_$g"; done
  local rc=0
  print_summary || rc=$?
  if [[ -n "$LEVEL" && "$DRY_RUN" != 1 ]]; then
    printf '\nChanged files:\n'
    git -C "$PROJECT_ROOT" --no-pager status --short || true
    printf '\nNext: bin/test && bin/lint, then commit by hand. Suggested message:\n  chore(deps): update %s dependencies\n' "$LEVEL"
  fi
  exit "$rc"
}

main "$@"
