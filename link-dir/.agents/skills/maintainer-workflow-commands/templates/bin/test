#!/usr/bin/env bash
# test — run the project's tests per ecosystem (bash, ruby, js, go, java).
set -euo pipefail
# shellcheck source=lib/project.sh disable=SC1091
source "${BASH_SOURCE[0]%/*}/lib/project.sh"

usage() {
  cat <<'USAGE'
Usage: bin/test [--bash] [--ruby] [--js] [--go] [--java] [--dry-run] [-v] [PATH...]

Runs the tests of every detected ecosystem; group flags pick some.
PATH narrows the run and chooses its own group:
  *.test.sh, *_test.sh      bash
  spec/, *_spec.rb          ruby (rspec when spec/ exists, else minitest via bin/rails test or rake)
  *_test.rb, test/*.rb      ruby
  *.go or a dir with .go    go test of that package
  *.js *.ts ...             js (package.json "test" script, PATH passed after --)
  *Test.java ...            java (mvn -Dtest / gradle --tests, class name only)
A PATH nobody claims goes to the only group selected by a flag.
Every group runs even if one fails. Exit: 0 ok, 1 failed, 9 tool missing, 2 usage.
Env: DRY_RUN=1 like --dry-run, GO_TEST_RACE=0 drops -race.
USAGE
}

P_bash=() P_ruby=() P_js=() P_go=() P_java=()

test_group_of() {
  local p="$1"
  case "$p" in
    *.test.sh | *_test.sh) echo bash ;;
    *_spec.rb | spec | spec/*) echo ruby ;;
    *_test.rb | test/*.rb) echo ruby ;;
    *.go) echo go ;;
    *Test.java | *Tests.java | *IT.java) echo java ;;
    *.js | *.mjs | *.cjs | *.ts | *.tsx) echo js ;;
    *)
      if [[ -d "$PROJECT_ROOT/$p" ]]; then
        if [[ -n "$(find "$PROJECT_ROOT/$p" -name '*.go' -print -quit)" ]]; then
          echo go
        elif compgen -G "$PROJECT_ROOT/$p/*.test.sh" >/dev/null; then
          echo bash
        fi
      fi
      ;;
  esac
}

add_path() {
  case "$1" in
    bash) P_bash+=("$2") ;;
    ruby) P_ruby+=("$2") ;;
    js) P_js+=("$2") ;;
    go) P_go+=("$2") ;;
    java) P_java+=("$2") ;;
  esac
}

# Print "<name>" lines of every file a path list stands for.
bash_test_files() {
  local p f
  if [[ $# -eq 0 ]]; then
    set -- bin test
  fi
  for p in "$@"; do
    if [[ -d "$PROJECT_ROOT/$p" ]]; then
      for f in "$PROJECT_ROOT/$p"/*.test.sh; do [[ -f "$f" ]] && echo "${f#"$PROJECT_ROOT"/}"; done
    elif [[ -f "$PROJECT_ROOT/$p" ]]; then
      echo "$p"
    fi
  done
}

test_bash() {
  local f flags=() files=()
  [[ "$VERBOSE" == 1 ]] && flags+=(--verbose)
  while IFS= read -r f; do files+=("$f"); done < <(bash_test_files ${P_bash[@]+"${P_bash[@]}"})
  [[ ${#files[@]} -eq 0 ]] && skip_step "bash" "no *.test.sh in bin/ or test/" && return
  for f in "${files[@]}"; do
    run_step "bash $f" bash "$f" ${flags[@]+"${flags[@]}"}
  done
}

test_ruby() {
  local runner
  if has_file spec; then
    runner=(bundle exec rspec)
    [[ -x "$PROJECT_ROOT/bin/rspec" ]] && runner=(bin/rspec)
  elif is_rails; then
    runner=(bin/rails test)
  else
    runner=(bundle exec rake test)
  fi
  run_step "ruby ${runner[*]}" "${runner[@]}" ${P_ruby[@]+"${P_ruby[@]}"}
}

test_js() {
  local pm args=()
  pm="$(js_pm)"
  if [[ ${#P_js[@]} -gt 0 ]]; then
    if [[ "$pm" == npm ]]; then args=(-- "${P_js[@]}"); else args=("${P_js[@]}"); fi
  fi
  run_step "js $pm run test" "$pm" run test ${args[@]+"${args[@]}"}
}

test_go() {
  local flags=(-count=1) targets=() p d seen=" "
  [[ "${GO_TEST_RACE:-1}" == 1 ]] && flags+=(-race)
  [[ "$VERBOSE" == 1 ]] && flags+=(-v)
  for p in ${P_go[@]+"${P_go[@]}"}; do
    if [[ -d "$PROJECT_ROOT/$p" ]]; then d="$p"; else d="$(dirname "$p")"; fi
    [[ "$d" == . ]] && d="./..." || d="./${d#./}"
    case "$seen" in *" $d "*) continue ;; esac
    seen+="$d "
    targets+=("$d")
  done
  [[ ${#targets[@]} -eq 0 ]] && targets=("./...")
  run_step "go test ${targets[*]}" go test "${targets[@]}" "${flags[@]}"
}

test_java() {
  local tool p names="" args=()
  tool="$(java_tool)"
  for p in ${P_java[@]+"${P_java[@]}"}; do
    p="$(basename "$p" .java)"
    names="${names:+$names,}$p"
    args+=(--tests "$p")
  done
  if is_maven; then
    run_step "java $tool test" "$tool" -B test ${names:+-Dtest="$names"}
  else
    run_step "java $tool test" "$tool" test ${args[@]+"${args[@]}"}
  fi
}

main() {
  local arg g p rel
  local paths=() groups=()
  while [[ $# -gt 0 ]]; do
    arg="$1"
    shift
    case "$arg" in
      -h | --help)
        usage
        exit 0
        ;;
      --dry-run) export DRY_RUN=1 ;;
      -v | --verbose) VERBOSE=1 ;;
      --*) select_group_flag "$arg" || die_usage "unknown option: $arg" ;;
      -*) die_usage "unknown option: $arg" ;;
      *) paths+=("$arg") ;;
    esac
  done

  for p in ${paths[@]+"${paths[@]}"}; do
    rel="$(root_rel "$p")" || die_usage "no such path: $p"
    g="$(test_group_of "$rel")"
    if [[ -z "$g" && ${#SELECTED_GROUPS[@]} -eq 1 ]]; then g="${SELECTED_GROUPS[0]}"; fi
    [[ -n "$g" ]] || die_usage "cannot tell which tests '$p' belongs to; pass a group flag such as --go"
    add_path "$g" "$rel"
    case " ${groups[*]-} " in *" $g "*) ;; *) groups+=("$g") ;; esac
  done
  if [[ ${#paths[@]} -eq 0 ]]; then
    while IFS= read -r g; do groups+=("$g"); done < <(groups_to_run)
  fi

  if [[ ${#groups[@]} -eq 0 ]]; then
    echo "nothing to test: no Gemfile, package.json, go.mod, pom.xml, build.gradle or *.sh found" >&2
    exit "$EX_FAILED"
  fi
  for g in "${groups[@]}"; do "test_$g"; done
  print_summary
}

main "$@"
