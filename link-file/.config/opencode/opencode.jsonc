{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "apiKey": "lm-studio",
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "google/gemma-4-26b-a4b-qat": { "name": "Gemma 4 26B A4B Qat" },
        "mistralai/devstral-small-2-2512": { "name": "Devstral Small 2 2512" },
        "mistralai/mistral-7b-instruct-v0.3": { "name": "Mistral 7B Instruct v0.3" },
        "qwen/qwen2.5-coder-7b": { "name": "Qwen2.5 Coder 7B", "options": {"maxTokens": 32000} },
        "qwen/qwen3-coder-next": { "name": "Qwen3 Coder Next", "options": {"maxTokens": 32000} },
        "qwen/qwen3.5-9b": { "name": "Qwen3.5 9B", "options": {"maxTokens": 32000} },
        "qwen/qwen3.6-35b-a3b": { "name": "Qwen3.6 35B A3B", "options": {"maxTokens": 32000} },
        // KAT-Coder only works through LM Studio's GGUF build. The safetensors
        // copy in ~/.omlx ships a VLM config (Qwen3_5MoeForConditionalGeneration
        // with vision_config) over text-only weights — 31,333 tensors, zero
        // vision_tower.* — so omlx fails it with "Missing 333 parameters".
        "kwaipilot_kat-coder-v2.5-dev": { "name": "KAT-Coder V2.5 Dev (GGUF)" }
      }
    },
    // oMLX — OpenAI-compatible server on port 4000. Model ids here must match
    // what `curl localhost:4000/v1/models` reports, not the HF repo name.
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX",
      "options": {
        "apiKey": "DUMMY",
        "baseURL": "http://127.0.0.1:4000/v1"
      },
      "models": {
        // Verified end to end through opencode's agent loop, tools included.
        "Qwen3-Coder-30B-A3B-Instruct-MLX-4bit": { "name": "Qwen3 Coder 30B A3B (MLX 4bit)" },
        // Fast on raw /v1/chat/completions (~3s) but stalled past 400s inside
        // the agent loop — usable for plain prompts, not yet trusted with tools.
        "Qwen3-Coder-30B-A3B-Instruct-4bit": { "name": "Qwen3 Coder 30B A3B (4bit)" },
        "Qwen3.6-35B-A3B-4bit": { "name": "Qwen3.6 35B A3B (4bit)" },
        "Ornith-1.0-35B-4bit": { "name": "Ornith 1.0 35B (4bit)" },
        "Ornith-1.0-9B-4bit": { "name": "Ornith 1.0 9B (4bit)" }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "gemma4-claude:latest": { "name": "Gemma 4 Claude" },
        "gemma4:26b": { "name": "Gemma 4 26B" },
        "gemma4:26b-mlx": { "name": "Gemma 4 26B MLX" },
        "phi4:latest": { "name": "Phi4 Latest" },
        "qwen2.5-coder-7b:latest": { "name": "Qwen2.5 Coder 7b Latest" },
        "qwen2.5-coder:7b": { "name": "Qwen2.5 Coder 7B" },
        "qwen3.5:9b": { "name": "Qwen3.5 9B" },
        "qwen3.6:35b-a3b-coding-mxfp8": { "name": "Qwen3.6 35B A3B" },
        "qwen3.6:35b-mlx": { "name": "Qwen3.6 35B MLX" }
      }
    },
    // Proxy provider for models that emit JSON text tool calls (e.g. qwen2.5-coder).
    // Routes through bin/tool-call-proxy (port 11435) which converts the text
    // JSON to structured tool_calls. Start proxy first: bin/tool-call-proxy &
    // mlx_lm.server — start with: python -m mlx_lm.server --model <path> --port 8080
    "mlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MLX LM Server",
      "options": {
        "baseURL": "http://localhost:8080/v1"
      },
      "models": {
        "/Users/jesper/.lmstudio/models/lmstudio-community/Qwen3-Coder-30B-A3B-Instruct-MLX-4bit": {
          "name": "Qwen3-Coder 30B MLX"
        }
      }
    },
    "ollama_proxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (proxy)",
      "options": {
        "baseURL": "http://localhost:11435/v1"
      },
      "models": {
        "qwen2.5-coder:7b": { "name": "Qwen2.5 Coder 7B" },
        "qwen2.5-coder-7b:latest": { "name": "Qwen2.5 Coder 7B (patched)" }
      }
    }
  },
  // Was lmstudio/qwen/qwen3.6-35b-a3b, which LM Studio does not currently serve —
  // every default run died with "Invalid model identifier".
  "model": "omlx/Ornith-1.0-35B-4bit"
}
