# The syntax is "key = value". The whitespace around the
# equals doesn't matter.
# Comments start with a `#` and are only valid on their own line.
# Blank lines are ignored!
# Empty values reset the configuration to the default value
# more info: https://ghostty.org/docs/config


#### color / theme ####
# CMD + Shift + , to reload
# Slightly brighten ANSI green for better contrast on dark backgrounds.
palette = 2=#8ecf7a
# Tokyo Night selection colors — replaces the jarring default inversion
selection-background = #3e4451
selection-foreground = #ffffff
# Temporary test: make ANSI green obviously pink.
# palette = 2=#ff5fa2


#### tab layouts #####
#macos-titlebar-style = native

# Disable Ghostty's built-in title shell integration so it does not override
# the tab title with the running process name (e.g. "hermes").
# Title is managed entirely by 50_ghostty_prompt.sh via PROMPT_COMMAND, which
# sets a git-aware CWD title at each prompt and lets it persist during commands.
shell-integration-features = cursor,no-sudo,no-title,no-ssh-env,no-ssh-terminfo,path

#### keyboard bindings #####

keybind = super+shift+right=next_tab
keybind = super+shift+left=previous_tab
keybind = super+shift+comma=goto_window:next
